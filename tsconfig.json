{
  "compilerOptions": {
    "strict": true,
    "types": ["node"],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["bin/**/*.ts"],
  "exclude": ["bin/**/*.test.ts", "node_modules"]
}
