#!/usr/bin/env bash
# SessionStart hook: print the board's pickup and the orientation prose into
# context. Silent, with exit 0, whenever there is nothing to say: an untracked
# repo, no node on PATH, a failing gh. A session never fails or fills with
# noise because of the board.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

command -v node >/dev/null 2>&1 || exit 0
brief="$(node "$ROOT/bin/sidekick" pm pickup --brief 2>/dev/null)" || exit 0
[ -z "$brief" ] && exit 0

printf '%s\n\n' "sidekick: this repo is tracked. The board's pickup, then how to read it (the sk-orient skill)."
printf '%s\n\n' "$brief"
# The skill body below its frontmatter, so the prose has one source.
awk 'BEGIN { fm = 0 } /^---$/ { fm++; next } fm >= 2 { print }' "$ROOT/skills/sk-orient/SKILL.md"
exit 0
