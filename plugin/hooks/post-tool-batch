#!/usr/bin/env bash
# PostToolBatch hook: tell the model, once at each level, how full its
# main-thread context is. A subagent's event carries the top-level key
# "agent_id" and ends here in bash. A string inside tool_calls cannot hold that
# key unescaped, but a tool input or response with an "agent_id" key can; that
# main-thread batch goes unchecked and the next batch checks. Silent, with exit 0, on
# anything unexpected.
set -uo pipefail

input=$(cat)
case "$input" in
  *'"agent_id":"'*) exit 0 ;;
esac

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

command -v node >/dev/null 2>&1 || exit 0
printf '%s' "$input" | node "$ROOT/bin/sidekick" hook post-tool-batch 2>/dev/null
exit 0
