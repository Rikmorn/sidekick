function summarize(issues) {
  let summary = "";
  for (const issue of issues) {
    if (summary)
      summary += `
`;
    summary += `× ${issue.message}`;
    const dotPath = /* @__PURE__ */ getDotPath(issue);
    if (dotPath)
      summary += `
  → at ${dotPath}`;
  }
  return summary;
}

// bin/helpers/hook.ts
import * as fs2 from "node:fs";
