    comments
  ];
}
function reviewerLines(pluginDir, packageText) {
  return [
    READ_LEAD_LINE,
    REPRODUCE_PARAGRAPH,
    CLAIMS_PARAGRAPH,
    ...commentsLines(pluginDir, packageText)
  ].join(`

`);
}
function releaseReviewerLines(pluginDir, packageText) {
  return [
    RELEASE_LEAD_LINE,
    RELEASE_CLAIMS_PARAGRAPH,
    ...commentsLines(pluginDir, packageText)
  ].join(`

`);
}
function postSkillContext(stdin, env) {
  const event = parseJson5(stdin);
  if (!isSkillHookInput(event))
    return {};
  const nudge = NUDGES.get(event.tool_input.skill);
  return { context: nudge?.(env.pluginDir) };
}
function postReadContext(stdin, env) {
  const { pluginDir } = env;
  const event = parseJson5(stdin);
  if (!isReadHookInput(event))
    return {};
  const filePath = event.tool_input.file_path;
  if (RELEASE_CHECK_PACKAGE.test(filePath)) {
    return { context: releaseReviewerLines(pluginDir, readContent(event)) };
  }
  if (!REVIEW_PACKAGE.test(filePath))
    return {};
  return { context: reviewerLines(pluginDir, readContent(event)) };
}
function memoryStartHook(stdin, env) {
  try {
    const result = memoryStartContext(stdin, {
      env: env.env,
      home: env.env.HOME ?? os2.homedir(),
      runGit: execRunner,
      readSection,
      today: localToday,
      now: Date.now
    });
    const { snapshot } = result;
    if (snapshot !== undefined) {
      const { store, sessionId, source } = snapshot;
      startSnapshot(env.pluginDir, store, sessionId, source);
    }
    return result.context === undefined ? {} : { context: result.context };
  } catch {
    return {};
  }
}
var VERBS2 = new Map([
  ["post-skill", { eventName: "PostToolUse", contextFor: postSkillContext }],
  ["post-read", { eventName: "PostToolUse", contextFor: postReadContext }],
  ["memory-start", { eventName: "SessionStart", contextFor: memoryStartHook }],
  [
    "post-tool-batch",
    {
      eventName: "PostToolBatch",
      contextFor: (stdin, env) => postToolBatchContext(stdin, { env: env.env, tmpdir: env.tmpdir })
    }
  ]
]);
function runHookCli(args, env, out, err) {
  const [verb] = args;
  const entry = verb === undefined ? undefined : VERBS2.get(verb);
  if (entry === undefined) {
    err(`usage: ${HOOK_USAGE_LINE}`);
    return 1;
  }
  const { context, notice } = entry.contextFor(env.readStdin(), env) ?? {};
  if (context === undefined && notice === undefined)
    return 0;
  out(JSON.stringify({
    ...context === undefined ? {} : {
      hookSpecificOutput: {
        hookEventName: entry.eventName,
        additionalContext: context
      }
    },
    ...notice === undefined ? {} : { systemMessage: notice }
  }));
  return 0;
}

// bin/helpers/memory.ts
import * as fs29 from "node:fs";
import * as path36 from "node:path";

// bin/helpers/memory-link.ts
import * as fs28 from "node:fs";
import * as path35 from "node:path";
var messageOf3 = (error) => error instanceof Error ? error.message : String(error);
function runLink(opts, deps, out, err) {
  const gathered = gather2(opts, deps);
  if ("issue" in gathered) {
    err(`link could not read what it needs, and wrote nothing: ${gathered.issue}`);
    return 1;
  }
  const plan = planLink(gathered.facts, opts);
  if (plan.kind === "refused") {
    err("link refused, and wrote nothing:");
    for (const refusal2 of plan.refusals)
      err(`- ${refusal2}`);
    return 1;
  }
  const finished = report(plan, opts.dryRun, deps.runGit, { out, err });
  for (const note of plan.notes)
    out(note);
  return finished ? 0 : 1;
}
function report(plan, dryRun, runGit, { out, err }) {
  if (plan.actions.length === 0) {
    out(`${plan.root} is already linked to ${plan.target}.`);
    return true;
  }
  if (dryRun) {
    out("Dry run: link writes nothing. These are the steps it would take:");
    for (const action of plan.actions)
      out(phrase(action).todo);
    return true;
  }
  return applyAll(plan.actions, runGit, out, err);
}
function gather2(opts, deps) {
  try {
    return { facts: gatherFacts(opts, deps) };
  } catch (error) {
    return { issue: messageOf3(error) };
  }
}
function applyAll(actions, runGit, out, err) {
  for (const action of actions) {
    const applied = applyAction(action, runGit);
    if (!applied.ok) {
      err(`link stopped before it could ${phrase(action).step}: ${applied.issue}`);
      err("Fix that, then run the same command again; it skips each step already done.");
      return false;
    }
    for (const line of applied.lines)
      out(line);
  }
  return true;
}
function applyAction(action, runGit) {
  try {
    return runAction(action, runGit);
  } catch (error) {
    return { ok: false, issue: messageOf3(error) };
  }
}
function runAction(action, runGit) {
  const done = { ok: true, lines: [phrase(action).done] };
  switch (action.kind) {
    case "createStore": {
      const created = createStore(action.store, runGit);
      return created.ok ? done : created;
    }
    case "finishStore": {
      const finished = commitPaths(action.store, action.paths, CREATION_MESSAGE, runGit);
      return finished.ok ? done : finished;
    }
    case "createFolder":
      fs28.mkdirSync(action.folder, { recursive: true });
      return done;
    case "writeMarker":
      writeMarker(action.folder, action.root);
      return done;
    case "copyFile":
      fs28.mkdirSync(path35.dirname(action.to), { recursive: true });
      fs28.copyFileSync(action.from, action.to, fs28.constants.COPYFILE_EXCL);
      return done;
    case "mergeKey": {
      const merged = mergeKey(action.file, action.value, action.expected);
      return merged.ok ? done : merged;
    }
    case "archiveDefault":
      return archive(action);
    case "commit":
      return commit(action, runGit);
    default: {
      const unhandled = action;
      throw new Error(`Unhandled action: ${JSON.stringify(unhandled)}`);
    }
  }
}
function archive(action) {
  const kept = walkFolder(action.from).files.filter((rel) => copyState(path35.join(action.from, rel), path35.join(action.copies, rel)) !== "same");
  moveFolder(action.from, action.to);
  const listed = kept.map((rel) => `  ${path35.join(action.to, rel)}`);
  if (kept.length === 0)
    return { ok: true, lines: [phrase(action).done] };
  const why = action.reappeared ? `The default folder came back after the link. These files in it differ from ${action.copies} or are missing there, so merge what is new by hand:` : `These files changed after the copy, so their latest version is kept in the archive only:`;
  return { ok: true, lines: [phrase(action).done, why, ...listed] };
}
function moveFolder(from, to, rename = fs28.renameSync) {
  fs28.mkdirSync(path35.dirname(to), { recursive: true });
  try {
    rename(from, to);
  } catch (error) {
    const crossDevice = error instanceof Error && "code" in error && error.code === "EXDEV";
    if (!crossDevice)
      throw error;
    fs28.cpSync(from, to, {
      recursive: true,
      errorOnExist: true,
      force: false,
      verbatimSymlinks: true,
      preserveTimestamps: true
    });
    fs28.rmSync(from, { recursive: true });
  }
}
function commit(action, runGit) {
  const changes = ownedChanges(action.store, action.owned, runGit);
  if ("issue" in changes)
    return { ok: false, issue: changes.issue };
  if (changes.paths.length === 0) {
    return {
      ok: true,
      lines: ["The store holds nothing of link's left to commit."]
    };
  }
  const committed = commitPaths(action.store, changes.paths, action.message, runGit);
  return committed.ok ? { ok: true, lines: [phrase(action).done] } : committed;
}
function phrase(action) {
  const forms = (done, todo, rest2) => ({
    done: `${done} ${rest2}`,
    todo: `Would ${todo} ${rest2}`,
    step: `${todo} ${rest2}`
  });
  switch (action.kind) {
    case "createStore":
      return forms("Created", "create", `the store at ${action.store}`);
    case "finishStore":
      return forms("Committed", "commit", `the store's own files, which its first commit missed, as "${CREATION_MESSAGE}": ${action.paths.join(", ")}`);
    case "createFolder":
      return forms("Created", "create", action.folder);
    case "writeMarker":
      return forms("Wrote", "write", `${path35.join(action.folder, MARKER_FILE)}, naming ${action.root}`);
    case "copyFile":
      return forms("Copied", "copy", `${action.from} to ${action.to}`);
    case "mergeKey":
      return forms("Set", "set", `${SETTINGS_KEY} to ${action.value} in ${action.file}`);
    case "archiveDefault":
      return forms("Moved", "move", `${action.from} to ${action.to}`);
    case "commit":
      return forms("Committed", "commit", `link's paths in the store as "${action.message}"`);
    default: {
      const unhandled = action;
      throw new Error(`Unhandled action: ${JSON.stringify(unhandled)}`);
    }
  }
}

// bin/helpers/memory.ts
var MEMORY_USAGE_LINE = "sidekick memory link <repo> [--family <name>] [--name <folder>] [--force] [--dry-run] | sidekick memory snapshot --store <path> --session <id> --source <source> | sidekick memory lint [--folder <name>]... [--json]";
function parseLinkArgs(rest2) {
  const parsed = parseFlags(rest2, {
    family: { type: "string" },
    name: { type: "string" },
    force: { type: "boolean" },
    "dry-run": { type: "boolean" }
  });
  if (parsed === undefined || parsed.positionals.length !== 1)
    return;
  const [repo] = parsed.positionals;
  if (repo === undefined)
    return;
  const { family, name, force, "dry-run": dryRun } = parsed.values;
  return {
    repo,
    family: typeof family === "string" ? family : undefined,
    name: typeof name === "string" ? name : undefined,
    force: force === true,
    dryRun: dryRun === true
  };
}
function envWithAbsoluteStore(env, cwd) {
  const store = env.SIDEKICK_MEMORY_STORE;
  if (store === undefined || store === "")
    return env;
  return { ...env, SIDEKICK_MEMORY_STORE: path36.resolve(cwd, store) };
}
function parseSnapshotArgs(rest2) {
  const parsed = parseFlags(rest2, {
    store: { type: "string" },
    session: { type: "string" },
    source: { type: "string" }
  });
  const { store, session, source } = parsed?.values ?? {};
  if (typeof store === "string" && path36.isAbsolute(store) && typeof session === "string" && typeof source === "string") {
    return { store, session, source };
  }
  return;
}
var SNAPSHOT_DEPS = { lint: lintStore, now: Date.now };
function cacheLint(store, runGit, ctx, deps) {
  const file = cachePath(store, runGit);
  if (file === undefined)
    return;
  const ranAt = new Date(deps.now());
  const result = deps.lint(store, { readSection, runGit, home: ctx.home, env: ctx.env, now: deps.now }, { endsAt: runGit.endsAt });
  writeCache(file, result, ranAt);
}
function runSnapshot(rest2, ctx, deps = SNAPSHOT_DEPS) {
  const args = parseSnapshotArgs(rest2);
  if (args === undefined)
    return 0;
  const runGit = deadlineRunner(SNAPSHOT_DEADLINE_MS, deps.now);
  try {
    snapshotStore(args.store, args.session, args.source, runGit);
  } catch {}
  try {
    cacheLint(args.store, runGit, ctx, deps);
  } catch {}
  return 0;
}
var STORE_WIDE_LABEL = "(store-wide)";
function lintLines(result) {
  if (result.findings.length === 0)
    return ["The store is clean."];
  const groups = new Map;
  for (const finding of result.findings) {
    const heading = finding.folder === "" ? STORE_WIDE_LABEL : `${finding.folder}/`;
    groups.set(heading, [...groups.get(heading) ?? [], finding]);
  }
  const lines = [...groups].flatMap(([heading, findings]) => [
    heading,
    ...findings.map((f) => {
      const where = f.line === undefined ? f.file : `${f.file}:${f.line}`;
      return `${f.id}  ${where}  ${f.message}`;
    }),
    ""
  ]);
  const counts = Object.entries(result.counts).map(([id, count2]) => `${id}  ${count2}`);
  return [...lines, ...counts];
}
function withheldFindings(result, store) {
  const root = resolvedPath(store);
  return {
    ...result,
    findings: result.findings.map((finding) => ({
      ...finding,
      folder: withheldNames(finding.folder),
      file: withheldPath(finding.file, root)
    }))
  };
}
function isReadableDirectory(dir) {
  try {
    if (!fs29.statSync(dir).isDirectory())
      return false;
    fs29.readdirSync(dir);
    return true;
  } catch {
    return false;
  }
}
function runLint(rest2, ctx, out, err) {
  const parsed = parseFlags(rest2, {
    folder: { type: "string", multiple: true },
    json: { type: "boolean" }
  });
  if (parsed === undefined || parsed.positionals.length > 0) {
    err(`usage: ${MEMORY_USAGE_LINE}`);
    return 1;
  }
  const env = envWithAbsoluteStore(ctx.env, ctx.cwd);
  const store = storeRoot(env, ctx.home);
  if (!isReadableDirectory(store)) {
    err(`the memory store is not a readable folder: ${store}`);
    return 1;
  }
  const folders = (parsed.lists.folder ?? []).map((f) => f.replace(/\/$/, ""));
  try {
    const result = withheldFindings(lintStore(store, { readSection, runGit: execRunner, home: ctx.home, env, now: Date.now }, folders.length > 0 ? { folders } : {}), store);
    if (parsed.values.json === true) {
      out(JSON.stringify(result, null, 2));
    } else {
      for (const line of lintLines(result))
        out(line);
    }
    return 0;
  } catch (e) {
    err(lintFailureLine(e));
    return 1;
  }
}
function lintFailureLine(e) {
  const message = e instanceof Error ? e.message : String(e);
  const hits2 = printedHits(message);
  const shown2 = hits2.length === 0 ? message : `(withheld: ${hits2.join(", ")})`;
  return `memory lint failed: ${shown2}`;
}
function runMemoryCli(argv2, ctx, out, err) {
  const [verb, ...rest2] = argv2;
  if (verb === "snapshot")
    return runSnapshot(rest2, ctx);
  if (verb === "lint")
    return runLint(rest2, ctx, out, err);
  const parsed = verb === "link" ? parseLinkArgs(rest2) : undefined;
  if (parsed === undefined) {
    err(`usage: ${MEMORY_USAGE_LINE}`);
    return 1;
  }
  const env = envWithAbsoluteStore(ctx.env, ctx.cwd);
  return runLink({ ...parsed, repo: path36.resolve(ctx.cwd, parsed.repo) }, {
    env,
    home: ctx.home,
    configDir: configDirOf(env, ctx.home),
    runGit: execRunner,
    runClaude: ctx.runClaude,
    today: localToday
  }, out, err);
}

// bin/helpers/pm-brief.ts
var PER_TIER_MAX = 5;
function ref(i) {
  return `#${i.number} ${cut(i.title)}`;
}
function tierBody(candidates3) {
  if (candidates3.length === 0)
    return null;
  const shown2 = candidates3.slice(0, PER_TIER_MAX).map(ref).join("; ");
  const more = candidates3.length > PER_TIER_MAX ? ` +${candidates3.length - PER_TIER_MAX} more` : "";
  return `${shown2}${more}`;
}
function tierLine(tier, candidates3) {
  const body = tierBody(candidates3);
  return body === null ? null : `tier ${tier} ${body}`;
}
var openRefs2 = (plan) => plan.issues.filter((i) => i.open).map((i) => `#${i.number}`).join(", ");
var card = (i) => `#${i.number} (${i.age_days} d)`;
var titledCard = (i) => `${ref(i)} (${i.age_days} d)`;
function inProgressLine(v) {
  const { byPlan, loose } = v.inProgress;
  const parts = [
    ...byPlan.map((g) => `plan ${cut(g.name)}: ${g.cards.map(card).join(", ")}`),
    ...loose.map(titledCard)
  ];
  if (parts.length === 0)
    return "in progress: none";
  return `in progress: ${parts.join(v.plans.parse === "ok" ? " · " : ", ")}`;
}
function doneSegment(count2) {
  if (count2 === 0)
    return null;
  return count2 === 1 ? "1 plan done" : `${count2} plans done`;
}
function planCandidatesLine(v, list2) {
  const inState = (state) => list2.filter((pl) => pl.state === state);
  const next = list2.find((pl) => pl.state === "next");
  const later = inState("later");
  const openCount = (pl) => pl.issues.filter((i) => i.open).length;
  const unplanned = v.unplanned.map((i) => `#${i.number}`).join(", ");
  const segments = [
    next === undefined ? null : `next plan ${cut(next.name)} (${openRefs2(next)})`,
    later.length === 0 ? null : `then ${later.map((pl) => `${cut(pl.name)} (${openCount(pl)})`).join(", ")}`,
    doneSegment(inState("done").length),
    `unplanned: ${unplanned === "" ? "none" : unplanned}`,
    `tier 2: ${tierBody(v.tier2) ?? "none"}`
  ];
  return `candidates: ${segments.filter((s) => s !== null).join(" · ")}`;
}
function candidatesLine(v) {
  if (v.plans.parse === "ok")
    return planCandidatesLine(v, v.plans.list);
  const tiers2 = [tierLine(1, v.tier1), tierLine(2, v.tier2)].filter((t) => t !== null);
  const order = v.tier1.length + v.tier2.length > 1 ? " (order: number, not priority)" : "";
  return tiers2.length > 0 ? `candidates: ${tiers2.join(" · ")}${order}` : "candidates: none";
}
function milestoneLine(v) {
  const m = v.milestone;
  if (m === null) {
    return v.openMilestones.length === 0 ? "milestone: none" : `milestone: none active · open: ${titles(v.openMilestones)}`;
  }
  const c = m.counts;
  const counts = c === null ? "" : ` (${c.open} open, ${c.closed} closed)`;
  return [
    `milestone: ${m.title}${counts}`,
    ...m.outcome === null ? [] : [m.outcome],
    ...v.otherOpen.length > 0 ? [`also open: ${v.otherOpen.map(cut).join(", ")}`] : []
  ].join(" · ");
}
function renderBrief(p) {
  const v = pickupView(p);
  const drift = v.drift.map((d) => d.full);
  return [
    `sidekick · ${v.board.owner}/${v.board.repo} · board #${v.board.project}`,
    milestoneLine(v),
    inProgressLine(v),
    candidatesLine(v),
    drift.length > 0 ? `drift: ${drift.join(" · ")}` : "drift: none",
    `next: ${v.next}`
  ].join(`
`);
}

// bin/helpers/pm-lint.ts
var LINT_IDS = [
  "area_label_count",
  "no_status",
  "open_in_done",
  "completed_not_done",
  "backlog_without_condition",
  "backlog_in_milestone",
  "position_code_title",
  "cites_working_file",
  "unboarded",
  "stale_in_progress",
  "multiple_linked_boards"
];
var REVISIT_MARKER = /^\s*(?:[-*+][ \t]+)?(?:(\*\*|__|\*|_)revisit when(?::\1|\1:)|revisit when:)/im;
var POSITION_CODE = [
  /^\s*\d+(\.\d+)+\s*[—–-]/,
  /^\s*(bench|wave|step|phase)[- ]?\d+\b/i
];
var f = (number2, title, detail) => ({
  number: number2,
  title,
  detail
});
var open = (items) => items.filter((i) => i.state === "OPEN");
function areaLabelCount(issues) {
  return issues.map((i) => ({
    i,
    n: i.labels.filter((l) => l.startsWith("area:")).length
  })).filter(({ n }) => n !== 1).map(({ i, n }) => f(i.number, i.title, `${n} area:* labels`));
}
function noStatus(items) {
  return open(items).filter((i) => i.status === null).map((i) => f(i.number, i.title, "card has no Status"));
}
function openInDone(items) {
  return open(items).filter((i) => i.status === "Done").map((i) => f(i.number, i.title, "open issue carded Done"));
}
function completedNotDone(items) {
  return items.filter((i) => i.state === "CLOSED" && i.stateReason === "COMPLETED" && i.status !== "Done").map((i) => f(i.number, i.title, `closed as completed, card is ${i.status ?? "unset"}`));
}
function backlogWithoutCondition(issues) {
  return issues.filter((i) => i.labels.includes("backlog") && !REVISIT_MARKER.test(i.body)).map((i) => f(i.number, i.title, 'backlog label without a "Revisit when:" line'));
}
var WORKING_FILE_PATH = /\bdocs\/superpowers\b/;
function citesWorkingFile(issues) {
  return issues.filter((i) => WORKING_FILE_PATH.test(i.body)).map((i) => f(i.number, i.title, "body names docs/superpowers/, where working files live"));
}
function backlogInMilestone(issues) {
  return issues.filter((i) => i.labels.includes("backlog") && i.milestone !== null).map((i) => f(i.number, i.title, `deferred but in milestone ${i.milestone}`));
}
function positionCodeTitle(issues) {
  return issues.filter((i) => POSITION_CODE.some((re) => re.test(i.title))).map((i) => f(i.number, i.title, "title starts with a position code"));
}
function unboarded(uncarded, boardCreatedAt) {
  const since = Date.parse(boardCreatedAt);
  return uncarded.filter((i) => i.state === "OPEN" || i.stateReason === "COMPLETED" && i.closedAt !== null && Date.parse(i.closedAt) > since).map((i) => f(i.number, i.title, i.state === "CLOSED" ? "closed as completed, no card on the board" : i.cardArchived ? "card archived" : "no card on the board"));
}
function staleInProgress(items, now) {
  return open(items).filter((i) => i.status === "In Progress" && ageDays(touchedAt(i), now) > STALE_DAYS).map((i) => f(i.number, i.title, `In Progress, untouched ${ageDays(touchedAt(i), now)} days`));
}
function multipleLinkedBoards(candidates3) {
  if (candidates3.length <= 1)
    return [];
  const names = candidates3.map((b) => `#${b.number}`).join(", ");
  return [
    f(null, "linked boards", `${candidates3.length} open boards match: ${names}`)
  ];
}
var PREDICATES2 = {
  area_label_count: ({ issues }) => areaLabelCount(issues),
  no_status: ({ items }) => noStatus(items),
  open_in_done: ({ items }) => openInDone(items),
  completed_not_done: ({ items }) => completedNotDone(items),
  backlog_without_condition: ({ issues }) => backlogWithoutCondition(issues),
  backlog_in_milestone: ({ issues }) => backlogInMilestone(issues),
  position_code_title: ({ issues }) => positionCodeTitle(issues),
  cites_working_file: ({ issues }) => citesWorkingFile(issues),
  unboarded: ({ uncarded, boardCreatedAt }) => unboarded(uncarded, boardCreatedAt),
  stale_in_progress: ({ items, now }) => staleInProgress(items, now),
  multiple_linked_boards: ({ candidates: candidates3 }) => multipleLinkedBoards(candidates3)
};
function lintAll(input) {
  const entries = LINT_IDS.map((id) => [id, PREDICATES2[id](input)]);
  const findings = Object.fromEntries(entries);
  const counts = Object.fromEntries(entries.map(([id, list2]) => [id, list2.length]));
  return { findings, counts };
}

// bin/helpers/pm-pane.ts
var IN_PROGRESS = "In Progress";
function ageText(days) {
  return days === null ? null : `${days} d`;
}
function leaf(mark, ref2, text, age) {
  return {
    mark,
    ref: ref2,
    text,
    right: ageText(age),
    weight: "plain",
    children: []
  };
}
function markOf(issue) {
  if (issue.open && issue.status === IN_PROGRESS)
    return "running";
  return issue.open ? "later" : "done";
}
function issueNode(issue) {
  return leaf(markOf(issue), `#${issue.number}`, issue.title ?? "no card", issue.ageDays);
}
function titledNode(issue, mark, age) {
  return leaf(mark, `#${issue.number}`, issue.title, age);
}
function quiet(mark, text, children2 = []) {
  return { mark, ref: null, text, right: null, weight: "quiet", children: children2 };
}
function openIssues(plan) {
  const open2 = plan.issues.filter((i) => i.open);
  const started = open2.filter((i) => i.status === IN_PROGRESS);
  const rest2 = open2.filter((i) => i.status !== IN_PROGRESS);
  return [...started, ...rest2].map(issueNode);
}
function closedNode(plan) {
  const closed = plan.issues.filter((i) => !i.open).length;
  return closed === 0 ? [] : [quiet("done", `${closed} closed`)];
}
function planNode(plan) {
  const base = { mark: plan.state, ref: null, text: plan.name };
  if (plan.state === "running") {
    return {
      ...base,
      right: null,
      weight: "strong",
      children: [...openIssues(plan), ...closedNode(plan)]
    };
  }
  if (plan.state === "next") {
    return {
      ...base,
      right: "next",
      weight: "plain",
      children: openIssues(plan)
    };
  }
  const open2 = plan.issues.filter((i) => i.open).length;
  return {
    ...base,
    right: `${open2} open`,
    weight: "quiet",
    children: []
  };
}
function plural(count2, noun) {
  return `${count2} ${noun}${count2 === 1 ? "" : "s"}`;
}
function planNodes(view) {
  if (view.plans.parse !== "ok")
    return [];
  const done = view.plans.list.filter((p) => p.state === "done").length;
  const fold = done === 0 ? [] : [quiet("done", `${plural(done, "plan")} done`)];
  const active = view.plans.list.filter((p) => p.state !== "done");
  return [...fold, ...active.map(planNode)];
}
function capped(name, issues) {
  if (issues.length === 0)
    return [];
  const shown2 = issues.slice(0, PER_TIER_MAX).map((i) => titledNode(i, "later", null));
  const hidden = issues.length - shown2.length;
  const tail = hidden > 0 ? [quiet("more", `+${hidden} more`)] : [];
  return [quiet("group", name, [...shown2, ...tail])];
}
function milestoneNodes(titles2) {
  return titles2.map((title) => leaf("later", null, title, null));
}
function alsoOpen(view) {
  if (view.milestone === null || view.otherOpen.length === 0)
    return [];
  return [quiet("group", "also open", milestoneNodes(view.otherOpen))];
}
function treeNodes(view) {
  const headerParsed = view.plans.parse === "ok";
  return [
    ...view.milestone === null ? milestoneNodes(view.otherOpen) : [],
    ...planNodes(view),
    ...view.inProgress.loose.map((i) => titledNode(i, "running", i.age_days)),
    ...capped("unplanned", view.unplanned),
    ...capped("candidates", headerParsed ? [] : view.tier1),
    ...capped("tier 2 · no milestone", view.tier2),
    ...alsoOpen(view)
  ];
}
function planStates(view) {
  return view.plans.parse === "ok" ? view.plans.list.map((p) => p.state) : [];
}
function cellsRow(view) {
  if (view.milestone === null)
    return [];
  const plans = planStates(view);
  if (plans.length > 0) {
    const done = plans.filter((s) => s === "done").length;
    return [{ kind: "cells", plans, label: `${done}/${plans.length} plans` }];
  }
  const { open: open2, closed } = view.milestone.counts ?? { open: 0, closed: 0 };
  return [{ kind: "cells", plans, label: `${closed} closed · ${open2} open` }];
}
function paneRows(view) {
  const outcome = view.milestone?.outcome ?? null;
  const nodes = treeNodes(view);
  const rows = [
    { kind: "prose", mark: "next", text: view.next },
    ...view.drift.map((d) => ({
      kind: "prose",
      mark: "drift",
      text: d.full
    })),
    ...outcome === null ? [] : [{ kind: "prose", mark: "outcome", text: outcome }],
    ...cellsRow(view),
    ...nodes.length === 0 ? [] : [{ kind: "tree", nodes }]
  ];
  return { rows };
}

// bin/helpers/pm-report.ts
var STATE_CELL = {
  done: "done",
  running: "running",
  next: "next",
  later: ""
};
var cell = (text) => text.replaceAll("|", "\\|");
function row(plan, ref2) {
  const closed = plan.issues.filter((i) => !i.open).length;
  const issues = plan.issues.map((i) => ref2(i.number)).join(" ");
  return `| ${STATE_CELL[plan.state]} | ${cell(plan.name)} | ${closed} of ${plan.issues.length} | ${issues} |`;
}
function renderReport(r) {
  const ref2 = (n) => `${r.board.owner}/${r.board.repo}#${n}`;
  const running = r.plans.list.filter((p) => p.state === "running").map((p) => `**${p.name}**`);
  const unplanned = r.plans.unplanned.map((i) => ref2(i.number));
  return [
    `**${r.milestone.title}** · ${r.issue_counts.open} open, ${r.issue_counts.closed} closed`,
    `Running: ${running.length > 0 ? running.join(", ") : "none"}`,
    "",
    "| | Plan | Closed | Issues |",
    "|---|---|---|---|",
    ...r.plans.list.map((p) => row(p, ref2)),
    "",
    `Unplanned: ${unplanned.length > 0 ? unplanned.join(", ") : "none"}.`
  ].join(`
`);
}

// bin/helpers/rules.ts
import { execFileSync } from "node:child_process";
import * as fs32 from "node:fs";
import * as path39 from "node:path";

// bin/helpers/rules-fs.ts
import * as fs30 from "node:fs";
import * as path37 from "node:path";
var isOwnedRule = (name) => name.startsWith("sk-") && name.endsWith(".md");
function statusOf(dir, name) {
  const st = fs30.lstatSync(path37.join(dir, name), { throwIfNoEntry: false });
  if (!st)
    return "absent";
  return st.isFile() ? "file" : "other";
}
var isRegularFile = (dir, name) => statusOf(dir, name) === "file";
function ownedRulesIn(dir) {
  const dirStat = fs30.statSync(dir, { throwIfNoEntry: false });
  if (!dirStat)
    return [];
  if (!dirStat.isDirectory())
    return [];
  return fs30.readdirSync(dir).filter((n) => isOwnedRule(n) && isRegularFile(dir, n)).sort();
}

// bin/helpers/rules-overlap.ts
import * as fs31 from "node:fs";
import * as path38 from "node:path";
var MIN_SHARED_HEADINGS = 2;
var normalise2 = (s) => s.toLowerCase().replace(/[`*_]/g, "").replace(/[.:;!?]+$/, "").trim();
function headingsOf(body) {
  return body.split(`
`).filter((l) => l.startsWith("## ")).map((l) => normalise2(l.slice(3)));
}
function openingOf(body) {
  let lines = body.split(`
`);
  if (lines[0] === "---") {
    const end = lines.indexOf("---", 1);
    lines = end === -1 ? [] : lines.slice(end + 1);
  }
  const first = lines.find((l) => l.trim() !== "" && !l.startsWith("#"));
  if (!first)
    return;
  const sentence = first.split(/\.\s|\.$/)[0];
  const value = normalise2(sentence);
  return value === "" ? undefined : value;
}
function signalsFor(file, body, rule) {
  const signals = [];
  if (file === rule.name.slice("sk-".length))
    signals.push("name");
  const shared = new Set(headingsOf(body).filter((h) => rule.headings.has(h))).size;
  if (shared >= MIN_SHARED_HEADINGS)
    signals.push({ headings: shared });
  const opening = openingOf(body);
  if (opening !== undefined && opening === rule.opening) {
    signals.push({ opening });
  }
  return signals;
}
function findOverlap(src, dest) {
  const report2 = { pairs: [], extensions: [] };
  const destStat = fs31.statSync(dest, { throwIfNoEntry: false });
  if (!destStat?.isDirectory())
    return report2;
  const rules = ownedRulesIn(src).map((name) => {
    const body = fs31.readFileSync(path38.join(src, name), "utf-8");
    return {
      name,
      headings: new Set(headingsOf(body)),
      opening: openingOf(body)
    };
  });
  const others = fs31.readdirSync(dest).filter((n) => n.endsWith(".md") && !isOwnedRule(n) && isRegularFile(dest, n)).sort();
  for (const file of others) {
    const body = fs31.readFileSync(path38.join(dest, file), "utf-8");
    for (const rule of rules) {
      const signals = signalsFor(file, body, rule);
      if (signals.length === 0)
        continue;
      if (body.includes(rule.name)) {
        report2.extensions.push({ file, rule: rule.name });
      } else {
        report2.pairs.push({ file, rule: rule.name, signals });
      }
    }
  }
  return report2;
}
function describeSignal(signal) {
  if (signal === "name")
    return "name";
  if ("headings" in signal)
    return `${signal.headings} headings`;
  return "opening";
}
function formatOverlap(report2) {
  const lines = [];
  if (report2.pairs.length === 0) {
    lines.push("no overlap found (checked file names, two or more shared H2 headings, and the opening sentence against non-sk-*.md files)");
  } else {
    for (const p of report2.pairs) {
      lines.push(`${p.file} overlaps ${p.rule} on ${p.signals.map(describeSignal).join(", ")}`);
    }
    lines.push("overlap is reported only; sidekick never edits files it does not own. If a repo file extends or departs from its pair on purpose, name the sk rule in it and the pair moves to the stated extensions");
  }
  if (report2.extensions.length > 0) {
    lines.push(`stated extensions, not reported: ${report2.extensions.map((e) => `${e.file} → ${e.rule}`).join(", ")}`);
  }
  return lines;
}

// bin/helpers/rules.ts
function resolveDest(scope, cwd, claudeHome) {
  return scope === "project" ? path39.join(cwd, ".claude", "rules") : path39.join(claudeHome, "rules");
}
function workTreeRootOf(cwd) {
  try {
    return execFileSync("git", ["rev-parse", "--show-toplevel"], {
      cwd,
      encoding: "utf-8",
      stdio: ["ignore", "pipe", "ignore"],
      env: envWithoutRepoVars(process.env)
    }).trim();
  } catch {
    return;
  }
}
var repoRootOf = (cwd) => workTreeRootOf(cwd) ?? cwd;
var PLUGIN_ONLY_RULES = [
  "sk-pm-conventions.md",
  "sk-parallel-sessions.md",
  "sk-memory.md"
];
var isRecord7 = (v) => typeof v === "object" && v !== null && !Array.isArray(v);
var errorText = (e) => e instanceof Error ? e.message : String(e);
function pluginEnablement(root) {
  const file = path39.join(root, ".claude", "settings.json");
  let text;
  try {
    text = fs32.readFileSync(file, "utf-8");
  } catch (e) {
    if (e instanceof Error && "code" in e && e.code === "ENOENT") {
      return { state: "not-enabled" };
    }
    return { state: "unreadable", path: file, reason: errorText(e) };
  }
  if (text.trim() === "")
    return { state: "not-enabled" };
  let parsed;
  try {
    parsed = JSON.parse(text);
  } catch (e) {
    return { state: "unreadable", path: file, reason: errorText(e) };
  }
  if (!isRecord7(parsed)) {
    return { state: "unreadable", path: file, reason: "not a JSON object" };
  }
  const plugins = parsed.enabledPlugins;
  const enabled = isRecord7(plugins) && Object.entries(plugins).some(([key, on]) => key.startsWith("sidekick@") && on === true);
  return { state: enabled ? "enabled" : "not-enabled" };
}
var EVERY_RULE = { leaveOut: [], leaveAsIs: [] };
function projectSet(e) {
  switch (e.state) {
    case "enabled":
      return EVERY_RULE;
    case "not-enabled":
      return { leaveOut: PLUGIN_ONLY_RULES, leaveAsIs: [] };
    case "unreadable":
      return { leaveOut: [], leaveAsIs: PLUGIN_ONLY_RULES };
    default: {
      const _exhaustive = e;
      throw new Error(`unhandled enablement: ${JSON.stringify(_exhaustive)}`);
    }
  }
}
var shippedOnly = (set, shipped) => ({
  leaveOut: set.leaveOut.filter((n) => shipped.includes(n)),
  leaveAsIs: set.leaveAsIs.filter((n) => shipped.includes(n))
});
var expectedRules = (shipped, set) => shipped.filter((n) => !set.leaveOut.includes(n) && !set.leaveAsIs.includes(n));
function installRules(src, dest, scope = EVERY_RULE) {
  const shipped = ownedRulesIn(src);
  if (shipped.length === 0) {
    return { installed: [], removed: [], leftOut: [], skipped: [] };
  }
  const set = shippedOnly(scope, shipped);
  fs32.mkdirSync(dest, { recursive: true });
  const byLowerCase = new Map;
  for (const existing of fs32.readdirSync(dest)) {
    byLowerCase.set(existing.toLowerCase(), existing);
  }
  const installed = [];
  const skipped = [];
  for (const name of expectedRules(shipped, set)) {
    const onDisk = byLowerCase.get(name.toLowerCase());
    if (onDisk !== undefined && onDisk !== name) {
      skipped.push({ name, why: "case-collision" });
      continue;
    }
    if (statusOf(dest, name) === "other") {
      skipped.push({ name, why: "not-a-regular-file" });
      continue;
    }
    fs32.copyFileSync(path39.join(src, name), path39.join(dest, name));
    installed.push(name);
  }
  const keep = new Set(shipped);
  const owned = ownedRulesIn(dest);
  const removed = owned.filter((n) => !keep.has(n));
  const leftOut = owned.filter((n) => set.leaveOut.includes(n));
  for (const name of [...removed, ...leftOut]) {
    fs32.rmSync(path39.join(dest, name));
  }
  return { installed, removed, leftOut, skipped };
}
function checkRules(src, dest, scope = EVERY_RULE) {
  const shipped = ownedRulesIn(src);
  const set = shippedOnly(scope, shipped);
  const expected = expectedRules(shipped, set);
  const installed = ownedRulesIn(dest);
  const drift = [];
  for (const name of expected) {
    const there = path39.join(dest, name);
    if (!fs32.existsSync(there)) {
      drift.push({ kind: "missing", name });
      continue;
    }
    const same = fs32.readFileSync(path39.join(src, name)).equals(fs32.readFileSync(there));
    if (!same)
      drift.push({ kind: "stale", name });
  }
  const known = new Set(expected);
  for (const name of installed) {
    if (!known.has(name) && !set.leaveAsIs.includes(name)) {
      drift.push({ kind: "orphaned", name });
    }
  }
  return drift;
}
var USAGE = `usage: sidekick rules <install|check> --project|--user [--strict]
` + `  --project  the current repo's .claude/rules/
` + `  --user     the user-level rules directory under the Claude config dir
` + `  --strict   exit 1 when drift or a skipped write is found
` + "exit: 0 ran, whatever it found; 1 could not run, or --strict found drift";
var FLAGS = ["--project", "--user", "--strict"];
function parseArgs2(args) {
  const [verb, ...flags] = args;
  if (verb !== "install" && verb !== "check")
    return;
  if (flags.some((f2) => !FLAGS.includes(f2)))
    return;
  const project = flags.includes("--project");
  const user = flags.includes("--user");
  if (project === user)
    return;
  return {
    verb,
    scope: project ? "project" : "user",
    strict: flags.includes("--strict")
  };
}
function scopeSet(scope, root) {
  if (scope === "user")
    return { set: EVERY_RULE, notes: [] };
  const enablement = pluginEnablement(root);
  const set = projectSet(enablement);
  const notes = [];
  if (set.leaveOut.length > 0) {
    const come = set.leaveOut.length === 1 ? "it comes" : "they come";
    notes.push(`not delivered to this repo: ${set.leaveOut.join(", ")}; its .claude/settings.json does not enable sidekick, so ${come} from user level only`);
  }
  if (set.leaveAsIs.length > 0 && enablement.state === "unreadable") {
    const are = set.leaveAsIs.length === 1 ? "it is" : "they are";
    notes.push(`left ${set.leaveAsIs.join(", ")} as ${are}: could not read ${enablement.path} (${enablement.reason})`);
  }
  return { set, notes };
}
var deliveryMode = (projectDest) => ownedRulesIn(projectDest).length > 0 ? "project" : "user";
var realOrSelf = (p) => {
  try {
    return fs32.realpathSync(p);
  } catch {
    return path39.resolve(p);
  }
};
var sameDir = (a, b) => realOrSelf(a) === realOrSelf(b);
function pickChecked(scope, verb, t, src, out) {
  if (scope === "user" || verb === "install" || deliveryMode(t.dest) === "project") {
    return { dest: t.dest, set: t.set };
  }
  out(`no sk-* rules in ${t.dest}; checking the user-level copies at ${t.userDest} against ${src}`);
  return { dest: t.userDest, set: EVERY_RULE };
}
function sharedNames(expected, projectDest, userDest) {
  const project = new Set(ownedRulesIn(projectDest));
  const user = new Set(ownedRulesIn(userDest));
  return expected.filter((n) => project.has(n) && user.has(n)).length;
}
function reportDuplicates(expected, dest, userDest, out) {
  if (sameDir(dest, userDest))
    return;
  const shared = sharedNames(expected, dest, userDest);
  if (shared === 0)
    return;
  out(`your user-level rules at ${userDest} also deliver ${shared} of these; Claude Code loads both copies here, which is expected where the repo keeps copies for colleagues without sidekick`);
}
function refuseNonDirectory(dir, out) {
  const st = fs32.statSync(dir, { throwIfNoEntry: false });
  if (!st || st.isDirectory())
    return false;
  out(`${dir} exists and is not a directory; refusing to write rules there`);
  return true;
}
function reportInstall(result, dest, out) {
  out(`installed ${result.installed.length} rule(s) into ${dest}: ${result.installed.join(", ")}`);
  if (result.removed.length > 0) {
    out(`removed retired: ${result.removed.join(", ")}`);
  }
  if (result.leftOut.length > 0) {
    out(`removed: ${result.leftOut.join(", ")} (not delivered to this repo)`);
  }
  for (const s of result.skipped)
    out(`[skipped:${s.why}] ${s.name}`);
}
function runRulesCli(args, env, out) {
  const parsed = parseArgs2(args);
  if (parsed === undefined) {
    out(USAGE);
    return 1;
  }
  const { verb, scope, strict } = parsed;
  const root = scope === "project" ? repoRootOf(env.cwd) : env.cwd;
  if (scope === "project")
    out(`project root: ${root}`);
  const dest = resolveDest(scope, root, env.claudeHome);
  if (ownedRulesIn(env.src).length === 0) {
    out(`no sk-*.md rules found at ${env.src}; refusing to touch ${dest}`);
    return 1;
  }
  if (refuseNonDirectory(dest, out))
    return 1;
  const { set, notes } = scopeSet(scope, root);
  let skipped = [];
  if (verb === "install") {
    const result = installRules(env.src, dest, set);
    skipped = result.skipped;
    reportInstall(result, dest, out);
  }
  for (const note of notes)
    out(note);
  const userDest = resolveDest("user", root, env.claudeHome);
  const checked2 = pickChecked(scope, verb, { dest, userDest, set }, env.src, out);
  if (checked2.dest !== dest && refuseNonDirectory(checked2.dest, out))
    return 1;
  const expected = expectedRules(ownedRulesIn(env.src), checked2.set);
  const drift = checkRules(env.src, checked2.dest, checked2.set);
  if (drift.length === 0) {
    out(`${expected.length} rule(s) match the shipped copies at ${checked2.dest}`);
  }
  for (const d of drift)
    out(`[${d.kind}] ${d.name}`);
  if (scope === "project" && checked2.dest === dest) {
    reportDuplicates(expected, dest, userDest, out);
  }
  for (const l of formatOverlap(findOverlap(env.src, dest)))
    out(l);
  const found = drift.length > 0 || skipped.length > 0;
  return strict && found ? 1 : 0;
}

// bin/helpers/pm.ts
var GH_MIN = "2.98.0";
function chooseBoard(boards, viewer, repo) {
  return boards.filter((b) => !b.closed && b.ownerLogin === viewer && b.title === repo).sort((a, b) => a.number - b.number);
}
function preflightOf(version) {
  const ok = version !== null && versionAtLeast(version, GH_MIN);
  const warnings = ok ? [] : [
    `gh ${version ?? "unknown"} < ${GH_MIN}: by-name item-edit unavailable; write by field and option id`
  ];
  return {
    gh_version: version,
    gh_min: GH_MIN,
    gh_ok: ok,
    project_scope: null,
    warnings
  };
}
function discover(run, cwd) {
  const gh = fetchGhVersion(run, cwd);
  if (!gh.found)
    throw new PmError(2, "gh not found on PATH");
  const root = repoRootOf(cwd);
  const preflight = preflightOf(gh.version);
  const untracked = (reason6, fields = {}) => ({
    tracked: false,
    reason: reason6,
    owner: fields.owner ?? null,
    repo: fields.repo ?? null,
    project: null,
    status_field: null,
    linked: fields.linked ?? [],
    preflight,
    root
  });
  const origin = run("git", ["remote", "get-url", "origin"], root);
  if (origin.code !== 0)
    return untracked("no-origin");
  const parsed = parseOrigin(origin.stdout);
  if (!parsed)
    return untracked("not-github");
  const login = fetchLocalLogin(run, root);
  if (login === null) {
    return untracked("no-local-login", {
      owner: parsed.owner,
      repo: parsed.repo
    });
  }
  if (login !== parsed.owner) {
    return untracked("remote-owner-mismatch", {
      owner: parsed.owner,
      repo: parsed.repo
    });
  }
  preflight.project_scope = hasProjectScope(fetchScopeHeaders(run, root));
  if (!preflight.project_scope) {
    throw new PmError(2, "gh token lacks the 'project' scope; run: gh auth refresh -s project");
  }
  const d = fetchDiscovery(run, root, parsed.owner, parsed.repo);
  const chosen = chooseBoard(d.boards, d.viewer, parsed.repo);
  if (chosen.length === 0) {
    return untracked("no-board", {
      owner: parsed.owner,
      repo: parsed.repo,
      linked: d.boards
    });
  }
  const first = chosen[0];
  const f2 = fetchStatusField(run, root, d.viewer, first.number);
  return {
    tracked: true,
    reason: null,
    owner: parsed.owner,
    repo: parsed.repo,
    viewer: d.viewer,
    project: {
      number: first.number,
      id: f2.id,
      url: f2.url,
      title: f2.title,
      createdAt: f2.createdAt
    },
    status_field: f2.statusField,
    linked: d.boards,
    preflight,
    root
  };
}
var PM_USAGE_LINE = "sidekick pm <board|pickup|lint|gate> [--quiet] [--brief|--report|--glance] [--milestone <title>]";
var PM_USAGE = `usage: ${PM_USAGE_LINE}`;
var VERBS3 = new Set(["board", "pickup", "lint", "gate"]);
function milestoneFlag(args) {
  const at = args.findIndex((a) => a === "--milestone" || a.startsWith("--milestone="));
  if (at < 0)
    return { title: undefined, invalid: false };
  const title = args[at].startsWith("--milestone=") ? args[at].slice("--milestone=".length) : args[at + 1];
  const usable = title !== undefined && title !== "" && !title.startsWith("--");
  return usable ? { title, invalid: false } : { title: undefined, invalid: true };
}
function runPmCli(args, env, out, err) {
  const [verb, ...rest2] = args;
  if (!verb || !VERBS3.has(verb)) {
    err(PM_USAGE);
    return 1;
  }
  const run = env.run ?? execRunner;
  const brief = rest2.includes("--brief");
  const report2 = rest2.includes("--report");
  const glance = rest2.includes("--glance");
  const quiet2 = rest2.includes("--quiet") || brief || glance;
  const ms = milestoneFlag(rest2);
  const msTitle = ms.title;
  if (verb === "gate" && msTitle === undefined || ms.invalid || brief && report2 || glance && (brief || report2)) {
    err(PM_USAGE);
    return 1;
  }
  const emit = (o) => out(JSON.stringify(o, null, 2));
  try {
    const info = discover(run, env.cwd);
    const { root: _root, ...shown2 } = info;
    if (!info.tracked) {
      if (report2) {
        err(`not tracked: ${info.reason}`);
        return 1;
      }
      if (!quiet2)
        emit(shown2);
      return 0;
    }
    if (verb === "board") {
      emit(shown2);
      return 0;
    }
    const now = env.now ?? new Date;
    const owner = info.owner;
    const repo = info.repo;
    const project = info.project;
    const fullName = `${owner}/${repo}`;
    const viewer = info.viewer;
    if (verb === "pickup") {
      const open2 = fetchMilestones(run, info.root, owner, repo, "open").sort((a, b) => a.number - b.number);
      const repoIssues = fetchRepoIssues(run, info.root, owner, repo, project.id);
      const items = cardedItems(repoIssues, fullName);
      const active = msTitle === undefined ? activeMilestone(open2, items) : namedMilestone(open2, msTitle);
      const plans = active ? planView(active, items) : null;
      const issueCounts = active ? milestoneCounts(repoIssues, active.title) : null;
      if (report2) {
        return emitReport({
          board: { owner, repo },
          open: open2,
          milestone: active,
          issue_counts: issueCounts,
          plans
        }, out, err);
      }
      const t = tiers2(items, active, now);
      const working = inProgressMilestones(open2, items);
      const split = working.length > 1 ? working.map((m) => m.title) : [];
      const pickup = {
        board: shown2,
        milestone: active,
        issue_counts: issueCounts,
        open_milestones: open2.map((m) => ({
          number: m.number,
          title: m.title
        })),
        in_progress: t.in_progress,
        candidates: t.candidates,
        order_basis: "number",
        plans,
        drift: drift(run, info.root, t.in_progress, split)
      };
      const briefInput = { ...pickup, board: { owner, repo, project } };
      if (glance) {
        const state = glanceState({
          milestone: active,
          openCount: open2.length,
          plans,
          drift: pickup.drift,
          status: fetchStatusUpdates(run, info.root, project.id)
        });
        const g = {
          version: GLANCE_VERSION,
          board: { owner, repo, number: project.number, url: project.url },
          milestone: active ? active.title : null,
          state,
          pane: paneRows(pickupView(briefInput))
        };
        out(JSON.stringify(g));
      } else if (brief)
        out(renderBrief(briefInput));
      else
        emit(pickup);
      return 0;
    }
    if (verb === "lint") {
      const issues = fetchOpenIssues(run, info.root, owner, repo);
      const repoIssues = fetchRepoIssues(run, info.root, owner, repo, project.id);
      const items = cardedItems(repoIssues, fullName);
      const uncarded = repoIssues.filter((i) => i.card === null);
      const candidates3 = chooseBoard(info.linked, viewer, repo);
      const r = lintAll({
        issues,
        items,
        uncarded,
        boardCreatedAt: project.createdAt,
        candidates: candidates3,
        now
      });
      emit({
        board: shown2,
        findings: r.findings,
        counts: r.counts
      });
      return 0;
    }
    if (verb === "gate") {
      const openMs = fetchMilestones(run, info.root, owner, repo, "open");
      const found = openMs.find((m) => m.title === msTitle) ?? fetchMilestones(run, info.root, owner, repo, "closed").find((m) => m.title === msTitle);
      if (!found) {
        throw new PmError(1, `no milestone titled "${msTitle}"; open: ${openMs.map((m) => m.title).join(", ") || "(none)"}`);
      }
      const issues = fetchOpenIssues(run, info.root, owner, repo);
      const items = cardedItems(fetchRepoIssues(run, info.root, owner, repo, project.id), fullName);
      const v = gateVerdict(found, issues, items);
      emit({ board: shown2, milestone: found, ready: v.ready, open: v.open });
      return 0;
    }
    err(PM_USAGE);
    return 1;
  } catch (e) {
    if (e instanceof PmError) {
      err(e.message);
      return e.exit;
    }
    err(e instanceof Error ? e.message : String(e));
    return 1;
  }
}
function emitReport(r, out, err) {
  const { board, open: open2, milestone, issue_counts, plans } = r;
  if (open2.length === 0) {
    err("no open milestone to report on");
    return 1;
  }
  if (milestone === null || issue_counts === null || plans === null) {
    err(`no active milestone among ${open2.length} open (${open2.map((m) => m.title).join(", ")}); pass --milestone`);
    return 1;
  }
  if (plans.parse !== "ok") {
    err(plans.parse === "none" ? `milestone "${milestone.title}" has no plans header` : `milestone "${milestone.title}": ${plans.reason}`);
    return 1;
  }
  out(renderReport({ board, milestone, issue_counts, plans }));
  return 0;
}
function inProgressMilestones(open2, items) {
  const titles2 = new Set(items.filter((i) => i.state === "OPEN" && i.status === "In Progress").map((i) => i.milestone));
  return open2.filter((m) => m.state === "open" && titles2.has(m.title)).sort((a, b) => a.number - b.number);
}
function activeMilestone(open2, items) {
  const working = inProgressMilestones(open2, items);
  if (working.length === 1)
    return working[0];
  const live = open2.filter((m) => m.state === "open");
  return working.length === 0 && live.length === 1 ? live[0] : null;
}
function namedMilestone(open2, title) {
  const found = open2.find((m) => m.title === title);
  if (found)
    return found;
  throw new PmError(1, `no open milestone titled "${title}"; open: ${open2.map((m) => m.title).join(", ") || "(none)"}`);
}
function tiers2(items, active, now) {
  const open2 = items.filter((i) => i.state === "OPEN");
  const byNumber = (a, b) => a.number - b.number;
  const in_progress = open2.filter((i) => i.status === "In Progress").map((i) => ({
    number: i.number,
    title: i.title,
    item_id: i.itemId,
    age_days: ageDays(touchedAt(i), now),
    assignees: i.assignees,
    milestone: i.milestone
  })).sort(byNumber);
  const backlog = open2.filter((i) => i.status === "Backlog");
  const tier1 = active ? backlog.filter((i) => i.milestone === active.title) : [];
  const tier2 = backlog.filter((i) => i.milestone === null && !i.labels.includes("backlog"));
  const cand = (tier) => (i) => ({
    tier,
    number: i.number,
    title: i.title,
    item_id: i.itemId,
    labels: i.labels
  });
  return {
    in_progress,
    candidates: [
      ...tier1.sort(byNumber).map(cand(1)),
      ...tier2.sort(byNumber).map(cand(2))
    ]
  };
}
var OpenPrList = array(object({ number: number(), title: string() }));
function drift(run, root, inProgress2, inProgressSplit = []) {
  const branch = run("git", ["branch", "--show-current"], root).stdout.trim();
  let basis = "none";
  let base = null;
  if (run("git", ["rev-parse", "--abbrev-ref", "@{u}"], root).code === 0) {
    basis = "upstream";
    base = "@{u}";
  } else if (branch && run("git", ["rev-parse", "--verify", "--quiet", `refs/remotes/origin/${branch}`], root).code === 0) {
    basis = "origin-branch";
    base = `origin/${branch}`;
  }
  let count2 = null;
  if (base) {
    const r = run("git", ["rev-list", "--count", `${base}..HEAD`], root);
    count2 = r.code === 0 ? Number(r.stdout.trim()) : null;
  }
  let open_pr = null;
  if (branch) {
    const r = run("gh", [
      "pr",
      "list",
      "--head",
      branch,
      "--state",
      "open",
      "--json",
      "number,title"
    ], root);
    if (r.code === 0) {
      try {
        const list2 = safeParse(OpenPrList, JSON.parse(r.stdout));
        open_pr = list2.success ? list2.output[0] ?? null : null;
      } catch {
        open_pr = null;
      }
    }
  }
  return {
    unpushed: { count: count2, basis },
    stale_in_progress: inProgress2.filter((i) => i.age_days > STALE_DAYS),
    open_pr,
    in_progress_split: inProgressSplit
  };
}
function gateVerdict(ms, issues, items) {
  const itemByNumber = new Map(items.map((i) => [i.number, i]));
  const open2 = issues.filter((i) => i.milestone === ms.title).sort((a, b) => a.number - b.number).map((i) => ({
    number: i.number,
    title: i.title,
    status: itemByNumber.get(i.number)?.status ?? null,
    item_id: itemByNumber.get(i.number)?.itemId ?? null,
    labels: i.labels
  }));
  return { ready: ms.open_issues === 0 && open2.length === 0, open: open2 };
}

// plugin/hooks/name/contract.ts
var SESSION_VERSION = 1;

// bin/helpers/session.ts
var SESSION_USAGE_LINE = "sidekick session --json --self <session id>";
var LISTING_TIMEOUT_MS = 5000;
function parseSessionArgs(rest2) {
  const parsed = parseFlags(rest2, {
    json: { type: "boolean" },
    self: { type: "string" }
  });
  if (parsed === undefined || parsed.positionals.length > 0)
    return;
  const { json, self } = parsed.values;
  return json === true && typeof self === "string" && self !== "" ? self : undefined;
}
function runSessionCli(rest2, senv, out, err, timeoutMs = LISTING_TIMEOUT_MS) {
  const self = parseSessionArgs(rest2);
  if (self === undefined) {
    err(`usage: ${SESSION_USAGE_LINE}`);
    return 1;
  }
  const listing = listJobs(senv.runClaude, senv.cwd, timeoutMs);
  if ("issues" in listing) {
    for (const issue of listing.issues)
      err(issue);
    return 1;
  }
  const name = listing.jobs.find((job) => job.sessionId === self)?.name;
  const answer = {
    version: SESSION_VERSION,
    name: name !== undefined && name !== "" ? name : null,
    held: nameHeld(senv.configDir, self)
  };
  out(JSON.stringify(answer));
  return 0;
}

// bin/helpers/worker-dispatch-checks.ts
import * as fs33 from "node:fs";
import * as path40 from "node:path";

// bin/helpers/worker-facts.ts
function checkoutFacts(runGit, cwd) {
  const result = runGit("git", [
    "rev-parse",
    "--path-format=absolute",
    "--show-toplevel",
    "--git-common-dir"
  ], cwd);
  if (result.code !== 0) {
    return {
      issues: [
        "not inside a git work tree: run sidekick worker from a checkout of the repo"
      ]
    };
  }
  const [launchTop, commonDir] = result.stdout.replace(/\n$/, "").split(`
`);
  if (launchTop === undefined || commonDir === undefined) {
    return {
      issues: [`git rev-parse printed an unexpected answer: ${result.stdout}`]
    };
  }
  const listing = listWorktrees(runGit, cwd);
  if ("issue" in listing)
    return { issues: [listing.issue] };
  const held = heldBranch(runGit, cwd);
  if ("issue" in held)
    return { issues: [held.issue] };
  return {
    launchTop,
    mainTop: listing.worktrees[0].path,
    commonDir,
    branch: held.branch,
    worktrees: listing.worktrees
  };
}
function heldBranch(runGit, cwd) {
  const result = runGit("git", ["symbolic-ref", "-q", "HEAD"], cwd);
  if (result.code === 1)
    return { branch: undefined };
  if (result.code !== 0) {
    const why = result.stderr.trim();
    const lead = `git symbolic-ref HEAD failed with exit code ${result.code}`;
    return { issue: why === "" ? lead : `${lead}: ${why}` };
  }
  const ref2 = result.stdout.trim();
  return {
    branch: ref2.startsWith(HEADS) ? ref2.slice(HEADS.length) : undefined
  };
}

// bin/helpers/worker-overlay.ts
var markers = (opts) => ({
  SIDEKICK_WORKER: opts.briefPath,
  ...opts.main === undefined ? {} : { SIDEKICK_MAIN: opts.main }
});
var PUSH_REWRITE_KEY = "url.sidekick-push-blocked::.pushInsteadOf";
var SAVE_SKILL_RULE = "Skill(sidekick:sk-save)";
var PUSH_DENY_RULE = "Bash(git push:*)";
function pushEnv(count2) {
  return {
    GIT_CONFIG_COUNT: String(count2 + 1),
    [`GIT_CONFIG_KEY_${count2}`]: PUSH_REWRITE_KEY,
    [`GIT_CONFIG_VALUE_${count2}`]: ""
  };
}
function readRule(absPath) {
  const escaped = absPath.slice(1).replace(/[\\*?[\]]/g, "\\$&").replace(/ +$/, (spaces) => "\\ ".repeat(spaces.length));
  return `Read(//${escaped})`;
}
function readRules(reads) {
  const rules = reads.flatMap((p) => [readRule(p), readRule(physical(p))]);
  return [...new Set(rules)];
}
function workerOverlay(profileSettings, opts) {
  const base = { worktree: { baseRef: "head" } };
  const allowRules = {
    allow: [...readRules(opts.reads ?? []), SAVE_SKILL_RULE]
  };
  if (opts.allowPush) {
    return {
      overlay: {
        ...base,
        env: markers(opts),
        permissions: allowRules
      }
    };
  }
  const env = isPlainObject(profileSettings?.env) ? profileSettings.env : {};
  const raw = env.GIT_CONFIG_COUNT ?? "0";
  if (typeof raw !== "string" || !/^\d+$/.test(raw)) {
    return {
      issues: [
        `the profile's GIT_CONFIG_COUNT is ${JSON.stringify(raw)}, not a string of digits`
      ]
    };
  }
  return {
    overlay: {
      ...base,
      env: { ...markers(opts), ...pushEnv(Number(raw)) },
      permissions: { ...allowRules, deny: [PUSH_DENY_RULE] }
    }
  };
}

// bin/helpers/worker-dispatch-checks.ts
var PERMISSION_MODES = [
  "default",
  "acceptEdits",
  "plan",
  "auto",
  "dontAsk",
  "bypassPermissions",
  "manual"
];
var MODE_LIST = PERMISSION_MODES.join(", ");
var BYPASS = "bypassPermissions";
var isFolder = (dir) => {
  try {
    return fs33.statSync(dir).isDirectory();
  } catch {
    return false;
  }
};
function modeIssues(mode) {
  if (mode === undefined) {
    return [
      `--permission-mode is required: pass the orchestrating session's own mode, one of ${MODE_LIST}`
    ];
  }
  const known = PERMISSION_MODES.some((m) => m === mode);
  return known ? [] : [`--permission-mode "${mode}" is not one of ${MODE_LIST}`];
}
var pluginDirIssues = (dir) => dir === undefined || isFolder(dir) ? [] : [`--plugin-dir: ${dir} is not a folder`];
var placeIssues = (brief) => brief.place === "worktree" ? [] : [
  `place: "${brief.place}" is not "worktree"; dispatch starts a worker only in a worktree of its own`
];
var NO_COMMIT = "baseline: this checkout's HEAD has no commit yet";
function baselineIssues(runGit, top, baseline) {
  const head = headCommit(runGit, top);
  if (head === undefined)
    return [NO_COMMIT];
  return commitOf(runGit, top, baseline) === head ? [] : [
    `baseline: ${baseline} does not resolve to this checkout's HEAD (${head})`
  ];
}
var cleanIssues = (runGit, top) => isTrackedClean(runGit, top) ? [] : [
  "tracked files have uncommitted changes, which the worker's worktree would not carry: commit them first"
];
function treeNameIssues(runGit, top, name) {
  const folder = nativeFolder(top, name);
  const branch = nativeBranch(name);
  return [
    ...fs33.existsSync(folder) ? [`name: ${folder} already exists`] : [],
    ...branchExists(runGit, top, branch) ? [`name: the branch ${branch} already exists`] : []
  ];
}
function listedNameIssues(listed, name) {
  if ("issues" in listed)
    return listed.issues;
  return listed.jobs.some((job) => job.name === name) ? [
    `name: claude agents --json --all already lists a session named "${name}"`
  ] : [];
}
var pushUrlIssues = (runGit, top) => remotesWithPushUrl(runGit, top).map((remote) => `remote "${remote}" sets pushurl, and git ignores the push rewrite for such a remote: remove the pushurl, or pass --allow-push on the operator's word`);
function targetIssues(brief, branch) {
  if (branch === undefined) {
    return brief.target === undefined ? [] : [
      "target: this checkout's HEAD is detached, so the worker would land on a branch it does not hold: check out the branch the worker lands in, or drop the target key"
    ];
  }
  if (brief.target === undefined) {
    return [
      `target: missing; this checkout holds the branch ${branch}: add the line "target: ${branch}" to the brief`
    ];
  }
  return brief.target === branch ? [] : [
    `target: "${brief.target}" is not the branch this checkout holds (${branch}); write the line "target: ${branch}"`
  ];
}
function checkoutIssues(brief, briefPath, opts, runGit, facts) {
  const { launchTop, mainTop } = facts;
  return [
    ...briefFileIssues(brief, { briefPath, launchTop, mainTop, runGit }),
    ...baselineIssues(runGit, launchTop, brief.baseline),
    ...cleanIssues(runGit, launchTop),
    ...targetIssues(brief, facts.branch),
    ...treeNameIssues(runGit, mainTop, brief.name),
    ...opts.allowPush ? [] : pushUrlIssues(runGit, launchTop)
  ];
}
function bypassIssues(profile, mode) {
  const sources = profile.manifest.settingSources;
  if (mode !== BYPASS || sources === undefined || sources.includes("user")) {
    return [];
  }
  return [
    `${BYPASS} needs the user setting source, which profile "${profile.name}" leaves out (settingSources: ${sources.join(", ")}); a background session without it drops the bypass acceptance`
  ];
}
function missingProfileHint(name, penv) {
  const roots = storeRoots(penv.env, penv.cwd, penv.home, penv.workTree);
  const held = roots.some((root) => isFolder(path40.join(root.dir, name)));
  return isProfileName(name) && !held ? [`create it with: sidekick profile new ${name} --description <text>`] : [];
}
function prepareProfile(opts, briefPath, penv, main, reads) {
  const lines = [];
  const collect = (line) => {
    lines.push(line);
  };
  const profile = loadForLaunch(opts.profile, penv, collect);
  if (profile === undefined) {
    return {
      ok: false,
      issues: [...lines, ...missingProfileHint(opts.profile, penv)]
    };
  }
  const bypass = bypassIssues(profile, opts.mode);
  const overlay = workerOverlay(profile.manifest.settings, {
    briefPath,
    allowPush: opts.allowPush,
    main,
    reads
  });
  if ("issues" in overlay) {
    return { ok: false, issues: [...lines, ...overlay.issues, ...bypass] };
  }
  const args = checkComposed(profile, penv, collect, overlay.overlay);
  if (args === undefined || bypass.length > 0) {
    return { ok: false, issues: [...lines, ...bypass] };
  }
  return { ok: true, args, notes: lines };
}
var SHORT_SHA = 7;
var CHECK_BRIEF = "check-brief.md";
var insideWorkerIssue = "SIDEKICK_WORKER is set: a worker cannot dispatch workers of its own (#255)";
function checkDispatch(brief, briefPath, opts, wenv) {
  if (wenv.env.SIDEKICK_WORKER !== undefined) {
    return { issues: [insideWorkerIssue] };
  }
  const facts = checkoutFacts(wenv.runGit, wenv.cwd);
  const at = "issues" in facts ? wenv.cwd : facts.launchTop;
  const listed = listJobs(wenv.runClaude, at);
  const main = resolveMain(wenv.env, "jobs" in listed ? listed.jobs : undefined);
  const reads = [briefPath, brief.plan, brief.spec, brief.rulings];
  const prepared = prepareProfile(opts, briefPath, { ...wenv, cwd: at }, main?.value, reads);
  const issues = [
    ..."issues" in facts ? facts.issues : checkoutIssues(brief, briefPath, opts, wenv.runGit, facts),
    ...placeIssues(brief),
    ...listedNameIssues(listed, brief.name),
    ...modeIssues(opts.mode),
    ...pluginDirIssues(opts.pluginDir),
    ...prepared.ok ? [] : prepared.issues
  ];
  const refused = issues.length > 0 || "issues" in facts || !prepared.ok;
  if (refused || opts.mode === undefined)
    return { issues };
  return {
    brief,
    briefPath,
    mode: opts.mode,
    pluginDir: opts.pluginDir,
    allowPush: opts.allowPush,
    launchTop: facts.launchTop,
    mainTop: facts.mainTop,
    commonDir: facts.commonDir,
    args: prepared.args,
    notes: prepared.notes,
    main
  };
}
var whereLine = (branch, head) => branch ?? `detached HEAD at ${head.slice(0, SHORT_SHA)}`;
function checkOnly(opts, wenv) {
  if (wenv.env.SIDEKICK_WORKER !== undefined) {
    return { issues: [insideWorkerIssue] };
  }
  const facts = checkoutFacts(wenv.runGit, wenv.cwd);
  const at = "issues" in facts ? wenv.cwd : facts.launchTop;
  const head = "issues" in facts ? undefined : headCommit(wenv.runGit, at);
  const prepared = prepareProfile(opts, path40.join(at, CHECK_BRIEF), { ...wenv, cwd: at }, undefined, []);
  const issues = [
    ..."issues" in facts ? facts.issues : [
      ...head === undefined ? [NO_COMMIT] : [],
      ...cleanIssues(wenv.runGit, at),
      ...opts.allowPush ? [] : pushUrlIssues(wenv.runGit, at)
    ],
    ...modeIssues(opts.mode),
    ...pluginDirIssues(opts.pluginDir),
    ...prepared.ok ? [] : prepared.issues
  ];
  if ("issues" in facts || head === undefined)
    return { issues };
  if (issues.length > 0 || opts.mode === undefined || !prepared.ok) {
    return { issues };
  }
  return {
    line: `dispatch can run here: ${whereLine(facts.branch, head)}, profile ${opts.profile}, mode ${opts.mode}`,
    notes: prepared.notes
  };
}

// bin/helpers/worker-dispatch-verify.ts
import * as path41 from "node:path";
function checkoutAt(input, cwd) {
  if (cwd === physical(input.launchTop)) {
    return `the launching checkout ${input.launchTop}`;
  }
  if (cwd === physical(input.mainTop)) {
    return `the main checkout ${input.mainTop}`;
  }
  return;
}
function landingOnce(input, jobId, readTimeoutMs) {
  const listed = listJobs(input.runClaude, input.launchTop, readTimeoutMs);
  if ("issues" in listed) {
    return { kind: "failed", saw: listed.issues.join(" ") };
  }
  const row2 = listed.jobs.find((job) => job.id === jobId);
  if (row2 === undefined) {
    return { kind: "missing", saw: `${LISTING} lists no job ${jobId}` };
  }
  if (row2.cwd === undefined) {
    return { kind: "missing", saw: `the job ${jobId} lists no cwd` };
  }
  const cwd = physical(path41.resolve(input.launchTop, row2.cwd));
  const checkout = checkoutAt(input, cwd);
  if (checkout !== undefined)
    return { kind: "checkout", checkout };
  const listing = listWorktrees(input.runGit, input.launchTop);
  if ("issue" in listing) {
    return {
      kind: "failed",
      saw: `git worktree list failed: ${listing.issue}`
    };
  }
  const entry = listing.worktrees.find((w) => physical(w.path) === cwd);
  if (entry === undefined) {
    return {
      kind: "missing",
      saw: `the job's cwd ${row2.cwd} is no worktree git lists`
    };
  }
  return { kind: "found", entry };
}
function landing(input, jobId, reads) {
  for (let tried = 1;; tried += 1) {
    const now = landingOnce(input, jobId, reads.readTimeoutMs);
    if (now.kind === "found" || now.kind === "failed")
      return now;
    const limit = now.kind === "checkout" ? reads.creationTries : reads.tries;
    if (tried >= limit)
      return { kind: "missing", saw: lastSaw(now, tried) };
    input.sleep(reads.intervalMs);
  }
}
function lastSaw(now, tried) {
  const saw = now.kind === "checkout" ? `the job still runs in ${now.checkout}, so a slow WorktreeCreate hook or .worktreeinclude copy may still be making its worktree` : now.saw;
  return `after ${tried} tries, ${saw}`;
}
var unchecked2 = (why) => ({
  kind: "unchecked",
  line: `the worktree check did not run: ${why}`
});
var describeBranch = (ref2) => ref2 === undefined ? "a detached HEAD" : shortBranch(ref2);
function creatorMismatch(entry, expected, created, worker) {
  const found = `${entry.path} on ${describeBranch(entry.branch)}`;
  const wanted = `${expected.path} on ${nativeBranch(worker.name)}`;
  const offBase = "sha" in created && expected.sha !== undefined && created.sha !== expected.sha;
  return {
    kind: "mismatch",
    cause: "creator",
    lines: [
      `the worker's worktree is ${found}, not ${wanted}: a WorktreeCreate hook likely made it`,
      ...offBase ? [
        `the worker's worktree was created at ${created.sha}, not the baseline ${expected.sha}`
      ] : []
    ],
    job: worker.job
  };
}
function judge2(input, entry, job) {
  const { name } = input;
  const expected = {
    path: nativeFolder(input.mainTop, name),
    sha: commitOf(input.runGit, input.launchTop, input.baseline)
  };
  const created = creationCommit(input.runGit, input.launchTop, entry.branch);
  const rightPath = physical(entry.path) === physical(expected.path);
  const rightBranch = entry.branch === `${HEADS}${nativeBranch(name)}`;
  if (!rightPath || !rightBranch) {
    return creatorMismatch(entry, expected, created, { name, job });
  }
  if (expected.sha === undefined) {
    return unchecked2(`the baseline ${input.baseline} names no commit`);
  }
  if ("issue" in created)
    return unchecked2(created.issue);
  if (created.sha === expected.sha)
    return { kind: "matches" };
  return {
    kind: "mismatch",
    cause: "base",
    lines: [
      `the worker's worktree was created at ${created.sha}, not the baseline ${expected.sha}: worktree.baseRef is likely not "head" for this launch`
    ],
    job
  };
}
function verifyWorktree(input) {
  const {
    jobId,
    tries = 5,
    creationTries = 30,
    intervalMs = 1000,
    readTimeoutMs = 1e4
  } = input;
  if (jobId === null) {
    return unchecked2(`claude's output named no job id for ${input.name}`);
  }
  const found = landing(input, jobId, {
    tries,
    creationTries,
    intervalMs,
    readTimeoutMs
  });
  switch (found.kind) {
    case "found":
      return judge2(input, found.entry, jobId);
    case "missing":
    case "failed":
      return unchecked2(found.saw);
    default: {
      const unhandled = found;
      throw new Error(`unhandled landing: ${JSON.stringify(unhandled)}`);
    }
  }
}

// bin/helpers/worker-exclude.ts
import * as fs34 from "node:fs";
import * as path42 from "node:path";
var EXCLUDE_ENTRY = `${WORKTREES_FOLDER}/`;
var isIgnored = (runGit, top) => runGit("git", ["check-ignore", "-q", "--no-index", `${WORKTREES_FOLDER}/x`], top).code === 0;
var reason6 = (e) => e instanceof Error ? e.message : String(e);
var isMissing4 = (e) => e instanceof Error && ("code" in e) && e.code === "ENOENT";
function readExclude(file) {
  try {
    return { text: fs34.readFileSync(file, "utf-8") };
  } catch (e) {
    if (isMissing4(e))
      return { text: "" };
    return {
      issues: [
        `cannot read ${file}, where dispatch adds ${EXCLUDE_ENTRY}: ${reason6(e)}. Fix the file, then run dispatch again`
      ]
    };
  }
}
function appendExclude(file, text) {
  const separator = text === "" || text.endsWith(`
`) ? "" : `
`;
  try {
    fs34.mkdirSync(path42.dirname(file), { recursive: true });
    fs34.appendFileSync(file, `${separator}${EXCLUDE_ENTRY}
`);
    return [];
  } catch (e) {
    return [
      `cannot add ${EXCLUDE_ENTRY} to ${file}: ${reason6(e)}. Fix the file, then run dispatch again`
    ];
  }
}
function ensureWorktreesExcluded(runGit, top, commonDir) {
  if (isIgnored(runGit, top))
    return { line: undefined };
  const file = path42.join(commonDir, "info", "exclude");
  const read = readExclude(file);
  if ("issues" in read)
    return read;
  if (read.text.split(/\r?\n/).includes(EXCLUDE_ENTRY)) {
    return { line: undefined };
  }
  const issues = appendExclude(file, read.text);
  if (issues.length > 0)
    return { issues };
  return { line: `added ${EXCLUDE_ENTRY} to ${file}` };
}

// bin/helpers/worker-teardown.ts
import * as fs35 from "node:fs";
import * as path43 from "node:path";

// bin/helpers/worktree-read.ts
function repoOf2(env, err) {
  const found = findRepo(env.runGit, env.cwd);
  for (const warning of found.warnings)
    err(warning);
  if (found.repo === undefined && found.warnings.length === 0) {
    err(`${env.cwd} is not inside a git repository`);
  }
  return found.repo;
}
function readSources(env, repo) {
  const listing = readListing(env.runClaude, env.cwd);
  const skips = readSkips(repo.commonDir);
  const stored = readRecords(repo.commonDir);
  return {
    src: {
      repo,
      rows: "error" in listing ? undefined : listing.rows,
      listingWarnings: "error" in listing ? [] : listing.warnings,
      records: stored.records,
      unreadRecords: stored.warnings,
      isAlive: env.isAlive
    },
    listing,
    skipWarnings: skips.warnings
  };
}
var heldWords = (by) => by.startsWith("unknown") ? `held, ${by}` : `held by ${by}`;
function omittedWords(omitted) {
  if (omitted.count === 0)
    return "";
  const count2 = `${omitted.kind === "at least" ? "at least " : ""}${omitted.count}`;
  return `, and ${count2} more`;
}

// bin/helpers/worker-teardown.ts
var ENDED_STATES = ["stopped", "done"];
var REMOVED = /^removed\b/;
var DISCARD_LINE = /--discard-unpushed ([0-9a-f]{40})@([0-9a-f]+)/;
var NO_LIMIT = 0;
var claudeAt = (at, wenv, args, timeoutMs = 30000) => wenv.runClaude(args, { cwd: at.mainTop, timeoutMs });
function withText(lead, result) {
  const text = printedStreams(result);
  return text.length > 0 ? [`${lead}:`, ...text] : [lead];
}
var ranClean = (result) => result.code === 0 && !result.timedOut;
var failure = (result) => result.timedOut ? "did not return in time" : `failed with exit code ${result.code}`;
var runStop = (job, wenv) => {
  const args = ["stop", job.id];
  const result = claudeAt(job, wenv, args);
  if (ranClean(result))
    return [];
  return withText(`claude ${args.join(" ")} ${failure(result)}, so finish stopped before claude rm`, result);
};
var stopJob = (job, wenv) => {
  const listedEnded = job.state !== undefined && ENDED_STATES.includes(job.state);
  if (listedEnded && !lockHeldLive(job, wenv))
    return [];
  return runStop(job, wenv);
};
function lockPidNow(at, wenv) {
  return lockPid(lockReasonOf(wenv.runGit, at.mainTop, at.worktree));
}
function lockHeldLive(job, wenv) {
  const pid = lockPidNow(job, wenv);
  return pid !== undefined && wenv.isAlive(pid);
}
function waitForExit(pid, wenv, limitMs = 15000, pollMs = 250) {
  for (let waited = 0;wenv.isAlive(pid); waited += pollMs) {
    if (waited >= limitMs) {
      return [
        `the worktree's lock still names a running process, pid ${pid}, after ${limitMs / 1000} s: run finish again once it exits`
      ];
    }
    wenv.sleep(pollMs);
  }
  return [];
}
var waitForLock = (ready, wenv) => {
  const pid = lockPidNow(ready, wenv);
  return pid === undefined ? [] : waitForExit(pid, wenv);
};
var saidRemoved = (result) => ranClean(result) && REMOVED.test(printedStreams(result).join(`
`));
var isHookMade = (ready) => physical(ready.worktree) !== physical(nativeFolder(ready.mainTop, ready.name)) || ready.branch !== nativeBranch(ready.name);
function unknownAnswer(ready, args, result) {
  const what = ranClean(result) ? "did not say removed, and finish does not know its answer" : failure(result);
  const command = `claude ${args.map(shellArg).join(" ")}`;
  const refused = withText(`${command} ${what}, so finish removed nothing more`, result);
  if (isHookMade(ready)) {
    return [
      ...refused,
      `the worktree ${ready.worktree} on ${ready.branch} is not the one Claude Code makes for ${ready.name}, so a WorktreeCreate hook likely made it and claude rm will not remove it: remove it with that hook's own removal, then run ${ready.discardCommand}`
    ];
  }
  return [
    ...refused,
    `run finish again with ${ready.rerun}, which restores any files claude rm deleted, then runs claude rm again; or complete the removal by hand with ${command}`
  ];
}
function discard(ready, wenv, kept) {
  const text = printedStreams(kept).join(`
`);
  const offer = DISCARD_LINE.exec(text);
  if (offer === null)
    return unknownAnswer(ready, ["rm", ready.id], kept);
  const [, sha, worktreeId] = offer;
  if (sha !== ready.head) {
    return withText(`claude rm offers to discard ${sha}, which is not ${ready.branch}'s verified head (${ready.head}), so finish did not run it`, kept);
  }
  const args = ["rm", ready.id, "--discard-unpushed", `${sha}@${worktreeId}`];
  const result = claudeAt(ready, wenv, args, NO_LIMIT);
  return saidRemoved(result) ? [] : unknownAnswer(ready, args, result);
}
var removeSession = (ready, wenv, out) => {
  const first = claudeAt(ready, wenv, ["rm", ready.id], NO_LIMIT);
  const issues = saidRemoved(first) ? [] : discard(ready, wenv, first);
  if (issues.length > 0)
    return issues;
  out(`session ${ready.id} removed`);
  return [];
};
function clearSavedReport(ready) {
  const step = ready.reportStep;
  if (step.kind === "none" || step.kind === "no brief")
    return;
  if (step.from === step.to)
    return;
  try {
    const saved = fs35.readFileSync(step.to);
    if (fs35.readFileSync(step.from).equals(saved))
      fs35.unlinkSync(step.from);
  } catch {}
}
function forgottenWayOut({
  worktree,
  branch
}) {
  const route = `finish has forgotten the worker, so once you clear what stopped the removal, run sidekick worktree remove ${shellArg(worktree)}`;
  const removable = nativeBranch(path43.basename(worktree));
  if (branch === removable)
    return route;
  return `${route}. remove leaves the branch ${branch} in place, since it deletes only ${removable} or a branch sidekick worktree move made for that worktree, and writes a backup ref for its head first`;
}
function leftoverIssues(runGit, ready) {
  const { worktree } = ready;
  const state = filesState(runGit, ready);
  switch (state.kind) {
    case "folder gone":
    case "removable":
      return [];
    case "dirty":
      return [
        `the worktree ${worktree} holds files its removal would lose: ${state.paths.join(", ")}${omittedWords(state.omitted)}`
      ];
    case "held":
      return [
        `finish cannot tell what the worktree ${worktree} holds, so it removed nothing more: ${state.by}`
      ];
    default: {
      const _exhaustive = state;
      throw new Error(`Unhandled state: ${JSON.stringify(_exhaustive)}`);
    }
  }
}
var lockNow = ({ mainTop, worktree }, { runGit, isAlive }) => lockStateOf(lockReasonOf(runGit, mainTop, worktree), isAlive);
function worktreeGoneIssues(ready, wenv) {
  const { runGit } = wenv;
  const { mainTop: top, worktree } = ready;
  const list2 = worktreeListed(runGit, top, worktree);
  if ("issue" in list2) {
    return [
      `git worktree list failed, so finish cannot confirm the worktree is gone: ${list2.issue}`,
      forgottenWayOut(ready)
    ];
  }
  if (!list2.listed)
    return [];
  const first = lockNow(ready, wenv);
  const unlocked = first.kind === "dead" || first.kind === "none";
  if (unlocked)
    clearSavedReport(ready);
  const files = unlocked ? leftoverIssues(runGit, ready) : [];
  const lock = unlocked && files.length === 0 ? lockNow(ready, wenv) : first;
  const issues = files.length > 0 ? files : removeGitWorktree(runGit, top, worktree, lock);
  if (issues.length === 0)
    return [];
  return [
    `claude rm said removed, but git still lists the worktree ${worktree}`,
    ...issues,
    forgottenWayOut(ready)
  ];
}
function branchGoneIssues(runGit, top, branch, head) {
  if (!branchExists(runGit, top, branch))
    return [];
  const ref2 = `refs/heads/${branch}`;
  const result = runGit("git", ["update-ref", "-d", ref2, head], top);
  if (result.code !== 0) {
    return [`git update-ref -d ${ref2} failed: ${result.stderr.trim()}`];
  }
  return dropBranchConfig(runGit, top, branch);
}
var ERE_SPECIAL = /[.[\\()*+?{|^$]/g;
var literalPattern = (text) => text.replace(ERE_SPECIAL, (char) => `\\${char}`);
function dropBranchConfig(runGit, top, branch) {
  const section = `branch.${branch}`;
  const has = runGit("git", ["config", "--local", "--get-regexp", `^${literalPattern(section)}\\.`], top);
  if (has.code !== 0)
    return [];
  const result = runGit("git", ["config", "--remove-section", section], top);
  if (result.code === 0)
    return [];
  return [
    `git config --remove-section ${section} failed: ${result.stderr.trim()}`
  ];
}
var removeLeftovers = (ready, wenv, out) => {
  const worktree = worktreeGoneIssues(ready, wenv);
  if (worktree.length > 0)
    return worktree;
  out(`worktree ${ready.worktree} removed`);
  const branch = branchGoneIssues(wenv.runGit, ready.mainTop, ready.branch, ready.head);
  if (branch.length > 0)
    return branch;
  out(`branch ${ready.branch} removed`);
  return [];
};
var forgetRecord = (ready) => {
  removeRecord(ready.commonDir, ready.name);
  return [];
};
var BACKUP_KINDS = ["landed", "pushed", "discarded", "kept"];
var REF_SAFE = /^[A-Za-z0-9._-]$/;
var percent = (byte) => `%${byte.toString(16).toUpperCase().padStart(2, "0")}`;
var encodeByte = (byte) => {
  const char = String.fromCharCode(byte);
  return REF_SAFE.test(char) ? char : percent(byte);
};
var DOT = percent(46);
function refSegment(name) {
  return [...Buffer.from(name, "utf8")].map(encodeByte).join("").replace(/^[.-]/, (char) => percent(char.charCodeAt(0))).replace(/\.(?=\.)/g, DOT).replace(/\.$/, DOT).replace(/\.lock$/, `${DOT}lock`);
}
var backupRef = (kind, name, head) => `refs/sidekick/${kind}/${refSegment(name)}/${head}`;
function heldBackup(runGit, top, name, head) {
  return BACKUP_KINDS.map((kind) => backupRef(kind, name, head)).find((ref2) => commitOf(runGit, top, ref2) === head);
}
function readyBackup(ready) {
  const { verdict } = ready;
  switch (verdict.kind) {
    case "landed":
      return backupRef("landed", ready.name, ready.head);
    case "discard":
      return backupRef("discarded", ready.name, ready.head);
    default: {
      const unhandled = verdict;
      throw new Error(`unhandled verdict: ${JSON.stringify(unhandled)}`);
    }
  }
}
function writeBackup(runGit, top, ref2, head) {
  if (commitOf(runGit, top, ref2) === head)
    return [];
  const result = runGit("git", ["update-ref", ref2, head, ""], top);
  if (result.code === 0)
    return [];
  return [`cannot keep ${ref2}: ${result.stderr.trim()}`];
}
var keepBackup = (ready, wenv) => writeBackup(wenv.runGit, ready.mainTop, readyBackup(ready), ready.head);
var restorePartial = (ready, wenv, out) => {
  if (!ready.partial)
    return [];
  const status = statusEntriesIn(wenv.runGit, ready.mainTop, ready.worktree);
  if ("issue" in status) {
    return [
      `git status failed in the worktree ${ready.worktree}: ${status.issue}`
    ];
  }
  const deleted = status.entries.filter((entry) => entry.code === DELETED).map((entry) => entry.path);
  if (deleted.length === 0)
    return [];
  const result = wenv.runGit("git", ["-C", ready.worktree, "checkout-index", "--", ...deleted], ready.mainTop);
  if (result.code !== 0) {
    return [
      `git checkout-index failed in the worktree ${ready.worktree}, so finish removed nothing: ${result.stderr.trim()}`
    ];
  }
  const files = `${deleted.length} deleted ${deleted.length === 1 ? "file" : "files"}`;
  out(`restored ${files} in ${ready.worktree} from its index, so claude rm finds it clean`);
  return [];
};

// bin/helpers/worker-dispatch.ts
var withoutTrailingNewline2 = (text) => text.replace(/\n$/, "");
function relay(result, out, err) {
  if (result.stdout !== "")
    out(withoutTrailingNewline2(result.stdout));
  if (result.stderr !== "")
    err(withoutTrailingNewline2(result.stderr));
  if (result.timedOut)
    err("claude did not return in time.");
}
var mainLines = (ready, wenv) => ready.main === undefined ? [] : [mainReport(ready.main, wenv.env, wenv.home)];
var DETACHED_LANDING = "where the operator lands it (this checkout's HEAD is detached)";
function landingLine(ready) {
  const target = ready.brief.target ?? DETACHED_LANDING;
  const from = ready.launchTop === ready.mainTop ? "" : ` · launched from ${ready.launchTop}`;
  return `lands in: ${target}${from}`;
}
function summary(ready) {
  const { brief, mode } = ready;
  const pushes = ready.allowPush ? "pushes ALLOWED on the operator's word" : "pushes blocked";
  return [
    `worker ${brief.name} dispatched · permission mode ${mode} · ${pushes}`,
    ...mode === BYPASS ? ["every tool call the worker makes is pre-approved"] : [],
    landingLine(ready),
    `steer: rulings in ${brief.rulings}, then message "${brief.name}" to point at them`,
    `finish: sidekick worker finish ${shellArg(ready.briefPath)}`
  ];
}
var refuse4 = (err, issues) => {
  for (const issue of issues)
    err(issue);
  return 1;
};
function keepRecord(ready, job, err) {
  const written = writeRecord(ready.commonDir, {
    version: 2,
    name: ready.brief.name,
    main: ready.main?.value ?? null,
    job,
    brief: ready.briefPath,
    dispatchedAt: new Date().toISOString()
  });
  if ("issue" in written)
    err(written.issue);
}
function wayOut(ready, verdict, stopped) {
  const discard2 = `sidekick worker finish ${shellArg(ready.briefPath)} --discard`;
  return verdict.cause === "creator" ? `${stopped} Remove its worktree with the hook's own removal, then run: ${discard2}` : `${stopped} Then run: ${discard2}`;
}
function stopStray(ready, job, wenv, timeoutMs = 1e4) {
  const result = wenv.runClaude(["stop", job], {
    cwd: ready.launchTop,
    timeoutMs
  });
  if (ranClean(result))
    return [];
  const lead = `claude stop ${shellArg(job)} ${failure(result)}, so the worker may still run`;
  return withText(lead, result);
}
function refuseStray(ready, verdict, wenv, err) {
  const stop = `claude stop ${shellArg(verdict.job)}`;
  const stopFailed = stopStray(ready, verdict.job, wenv);
  const stopped = stopFailed.length === 0 ? `dispatch stopped the worker with ${stop}.` : `Stop the worker with ${stop}.`;
  return refuse4(err, [
    ...verdict.lines,
    ...stopFailed,
    wayOut(ready, verdict, stopped)
  ]);
}
function afterStart(ready, result, wenv, { out, err }) {
  const job = jobIdFrom(result.stdout, ready.brief.name);
  keepRecord(ready, job, err);
  const verdict = verifyWorktree({
    runGit: wenv.runGit,
    runClaude: wenv.runClaude,
    sleep: wenv.sleep,
    jobId: job,
    name: ready.brief.name,
    mainTop: ready.mainTop,
    launchTop: ready.launchTop,
    baseline: ready.brief.baseline
  });
  if (verdict.kind === "mismatch") {
    return refuseStray(ready, verdict, wenv, err);
  }
  for (const line of [...mainLines(ready, wenv), ...summary(ready)]) {
    out(line);
  }
  if (verdict.kind === "unchecked")
    err(verdict.line);
  return result.code;
}
function launch2(ready, wenv, out, err) {
  for (const note of ready.notes)
    err(note);
  const excluded = ensureWorktreesExcluded(wenv.runGit, ready.mainTop, ready.commonDir);
  if ("issues" in excluded)
    return refuse4(err, excluded.issues);
  if (excluded.line !== undefined)
    out(excluded.line);
  const args = bgArgs(ready.args, {
    pluginDir: ready.pluginDir,
    permissionMode: ready.mode,
    worktree: ready.brief.name,
    sessionName: ready.brief.name,
    prompt: `/sidekick:sk-worker --dispatched ${ready.briefPath}`
  });
  const result = wenv.runClaude(args, {
    cwd: ready.launchTop,
    timeoutMs: wenv.launchTimeoutMs ?? LAUNCH_TIMEOUT_MS
  });
  relay(result, out, err);
  if (result.code !== 0)
    return result.code;
  return afterStart(ready, result, wenv, { out, err });
}
function runCheck(opts, wenv, out, err) {
  const checked2 = checkOnly(opts, wenv);
  if ("issues" in checked2)
    return refuse4(err, checked2.issues);
  for (const note of checked2.notes)
    err(note);
  out(checked2.line);
  return 0;
}
function dispatch(opts, wenv, out, err) {
  if (opts.check)
    return runCheck(opts, wenv, out, err);
  const read = readBrief(opts.brief);
  if ("issues" in read)
    return refuse4(err, read.issues);
  const checked2 = checkDispatch(read.brief, read.path, opts, wenv);
  if ("issues" in checked2)
    return refuse4(err, checked2.issues);
  return launch2(checked2, wenv, out, err);
}

// bin/helpers/worker-dispatch-args.ts
import * as path44 from "node:path";
var DEFAULT_WORKER_PROFILE = "worker";
var stringFlag = (values, key) => {
  const value = values[key];
  return typeof value === "string" ? value : undefined;
};
function parseDispatchArgs(rest2, cwd) {
  const parsed = parseFlags(rest2, {
    "permission-mode": { type: "string" },
    profile: { type: "string" },
    "plugin-dir": { type: "string" },
    "allow-push": { type: "boolean" },
    check: { type: "boolean" }
  });
  if (parsed === undefined)
    return;
  const check2 = parsed.values.check === true;
  if (check2 && parsed.positionals.length > 0) {
    return { usageErrors: ["--check takes no brief"] };
  }
  if (!check2 && parsed.positionals.length !== 1)
    return;
  const pluginDir = stringFlag(parsed.values, "plugin-dir");
  if (pluginDir === "")
    return;
  const shared = {
    mode: stringFlag(parsed.values, "permission-mode"),
    profile: stringFlag(parsed.values, "profile") ?? DEFAULT_WORKER_PROFILE,
    pluginDir: pluginDir === undefined ? undefined : path44.resolve(cwd, pluginDir),
    allowPush: parsed.values["allow-push"] === true
  };
  return check2 ? { ...shared, check: true } : {
    ...shared,
    check: false,
    brief: path44.resolve(cwd, parsed.positionals[0])
  };
}

// bin/helpers/worker-finish-args.ts
import * as path45 from "node:path";
var NEEDS_REPORT = "--name needs --no-report or --discard, since there is no brief to say where the run report goes";
var NEEDS_INTO = "--name needs --into <rev> or --discard, since there is no brief to name the target";
var stringFlag2 = (values, key) => {
  const value = values[key];
  return typeof value === "string" ? value : undefined;
};
function parseFinishArgs(rest2, cwd) {
  const parsed = parseFlags(rest2, {
    "no-report": { type: "boolean" },
    into: { type: "string" },
    discard: { type: "boolean" },
    name: { type: "string" },
    worktree: { type: "string" }
  });
  if (parsed === undefined)
    return;
  const { values, positionals } = parsed;
  const into = stringFlag2(values, "into");
  const worktree = stringFlag2(values, "worktree");
  const discard2 = values.discard === true;
  if (discard2 && into !== undefined || worktree === "")
    return;
  const shared = {
    noReport: values["no-report"] === true,
    mode: discard2 ? { kind: "discard" } : { kind: "landed", into },
    worktree: worktree === undefined ? undefined : path45.resolve(cwd, worktree)
  };
  const name = stringFlag2(values, "name");
  if (name !== undefined) {
    return positionals.length === 0 ? byName3(name, shared) : undefined;
  }
  if (positionals.length !== 1)
    return;
  const brief = path45.resolve(cwd, positionals[0]);
  return { subject: { kind: "brief", brief }, ...shared };
}
function byName3(name, shared) {
  const valid = safeParse(WorkerNameSchema, name);
  if (!valid.success) {
    return {
      usageErrors: [
        `--name "${name}" is not a worker's name: it ${valid.issues[0].message}`
      ]
    };
  }
  const { noReport, mode } = shared;
  const reportSettled = noReport || mode.kind === "discard";
  const targetSettled = mode.kind === "discard" || mode.into !== undefined;
  const usageErrors = [
    ...reportSettled ? [] : [NEEDS_REPORT],
    ...targetSettled ? [] : [NEEDS_INTO]
  ];
  if (usageErrors.length > 0)
    return { usageErrors };
  return { subject: { kind: "name", name }, ...shared };
}
function subjectArgs(subject) {
  switch (subject.kind) {
    case "brief":
      return [shellArg(subject.brief)];
    case "name":
      return ["--name", shellArg(subject.name)];
    default: {
      const unhandled = subject;
      throw new Error(`unhandled subject: ${JSON.stringify(unhandled)}`);
    }
  }
}
function modeFlags(mode) {
  switch (mode.kind) {
    case "landed":
      return mode.into === undefined ? [] : ["--into", shellArg(mode.into)];
    case "discard":
      return ["--discard"];
    default: {
      const unhandled = mode;
      throw new Error(`unhandled mode: ${JSON.stringify(unhandled)}`);
    }
  }
}
function commandFor(opts, mode) {
  const report2 = opts.noReport ? ["--no-report"] : [];
  const worktree = opts.worktree === undefined ? [] : ["--worktree", shellArg(opts.worktree)];
  return [
    "sidekick worker finish",
    ...subjectArgs(opts.subject),
    ...report2,
    ...modeFlags(mode),
    ...worktree
  ].join(" ");
}
var rerunCommand = (opts) => commandFor(opts, opts.mode);
var discardCommandFor = (opts) => commandFor(opts, { kind: "discard" });

// bin/helpers/worker-finish-tree.ts
import * as fs36 from "node:fs";
import * as path46 from "node:path";

// bin/helpers/worker-finish-target.ts
function targetName(runGit, top, rev) {
  const result = runGit("git", ["rev-parse", "--symbolic-full-name", rev], top);
  const name = result.code === 0 ? result.stdout.trim() : "";
  return name === "" ? rev : name;
}
var targetLine = (target) => `target: ${target.name} (${target.why})`;
var intoLookup = (ctx, into, branch) => ({
  rev: into,
  top: ctx.launchTop,
  why: "from --into",
  missing: `--into ${into} names no commit in the main checkout's repo, so finish cannot check that ${branch} landed there: name a branch, tag, or commit that exists`
});
var briefLookup = (ctx, target, branch) => ({
  rev: `refs/heads/${target}`,
  top: ctx.mainTop,
  why: "the brief's target",
  missing: `the brief's target ${target} names no branch, so finish cannot check that ${branch} landed there: create the branch, fix the brief's target, or name the target with --into <rev>`
});
function headLookup(brief, branch) {
  const { top } = brief;
  if (top === undefined) {
    return {
      issue: `the brief's folder ${brief.folder} is in no git checkout, so finish has no HEAD to check that ${branch} landed in: name the target with --into <rev>`
    };
  }
  return {
    rev: "HEAD",
    top,
    why: `the HEAD of ${top}, since the brief names no target`,
    missing: `the HEAD of ${top} names no commit, so finish cannot check that ${branch} landed there: name the target with --into <rev>`
  };
}
function lookupFor(ctx, into, branch) {
  if (into !== undefined)
    return intoLookup(ctx, into, branch);
  const { brief } = ctx;
  if (brief === undefined) {
    return {
      issue: `--name reads no brief, so finish has no target to check that ${branch} landed in: name the target with --into <rev>`
    };
  }
  if (brief.target !== undefined) {
    return briefLookup(ctx, brief.target, branch);
  }
  return headLookup(brief, branch);
}
function resolveTarget2(runGit, ctx, into, branch) {
  const lookup = lookupFor(ctx, into, branch);
  if ("issue" in lookup)
    return lookup;
  const sha = commitOf(runGit, lookup.top, lookup.rev);
  if (sha === undefined)
    return { issue: lookup.missing };
  const name = targetName(runGit, lookup.top, lookup.rev);
  if (name === `refs/heads/${branch}`) {
    return {
      issue: `the target ${name} is the worker's own branch, which holds its head whether or not the work landed, so it cannot show the work landed there: name the branch it should land in with --into <rev>`
    };
  }
  return { name, sha, why: lookup.why };
}
function walkedText(walked, capped2) {
  const commits = `${walked} ${walked === 1 ? "commit" : "commits"}`;
  return capped2 ? `the history walk tried ${commits} and stopped at its cap of ${DEFAULT_CAP}` : `the history walk tried ${commits} and found no match`;
}
var discardRoute = (discardCommand) => `discarding it is your call, with ${discardCommand}`;
var handRoute = (id) => `to clear it by hand, claude rm ${shellArg(id)}`;
function routeFor(mode, discardCommand, id) {
  switch (mode) {
    case "landed":
      return discardRoute(discardCommand);
    case "discard":
      return handRoute(id);
    default: {
      const unhandled = mode;
      throw new Error(`unhandled mode: ${unhandled}`);
    }
  }
}
function missingBranchIssue(branch, opts, id) {
  switch (opts.mode.kind) {
    case "landed":
      return `the branch ${branch} does not exist, so finish cannot check that the work has landed: discarding it is your call, with claude rm ${shellArg(id)}`;
    case "discard":
      return `the branch ${branch} does not exist, so finish has nothing to keep as a backup: clear the worker by hand with claude rm ${shellArg(id)}`;
    default: {
      const unhandled = opts.mode;
      throw new Error(`unhandled mode: ${JSON.stringify(unhandled)}`);
    }
  }
}
function judgeFor(runGit, ctx, branch, opts, id) {
  const { name, head } = branch;
  if (head === undefined) {
    return { issues: [missingBranchIssue(name, opts, id)] };
  }
  const { mode } = opts;
  switch (mode.kind) {
    case "discard":
      return { kind: "discard", head };
    case "landed": {
      const target = resolveTarget2(runGit, ctx, mode.into, name);
      if ("issue" in target)
        return { issues: [target.issue] };
      return { kind: "landed", head, target };
    }
    default: {
      const unhandled = mode;
      throw new Error(`unhandled mode: ${JSON.stringify(unhandled)}`);
    }
  }
}
function landedVerdict(runGit, ctx, worker, opts) {
  const { branch, head, target } = worker;
  const landing2 = landedIn(runGit, ctx.mainTop, { target: target.sha, head });
  switch (landing2.kind) {
    case "landed":
      return { verdict: { kind: "landed", target, at: landing2.at } };
    case "error":
      return {
        issues: [
          `finish cannot check that ${branch} landed in ${target.name}: ${landing2.issue}`
        ]
      };
    case "not landed":
      return {
        issues: [
          `${branch} has not landed in ${target.name} (${target.sha}): its head ${head} is not there, and ${walkedText(landing2.walked, landing2.capped)}. Land it and run finish again; name the target with --into <rev>; ${discardRoute(discardCommandFor(opts))}`
        ]
      };
    default: {
      const unhandled = landing2;
      throw new Error(`unhandled landing: ${JSON.stringify(unhandled)}`);
    }
  }
}

// bin/helpers/worker-finish-tree.ts
function onBranchIssues(runGit, worktree, branch, mode, discardCommand, id) {
  const head = checkedOut(runGit, worktree);
  if (head === `refs/heads/${branch}`)
    return [];
  return [
    `the worktree ${worktree} has ${head} checked out, not ${branch}, ${offBranchReason(mode, branch)}: check out ${branch} there and run finish again; ${routeFor(mode, discardCommand, id)}`
  ];
}
function offBranchReason(mode, branch) {
  switch (mode) {
    case "landed":
      return "so finish cannot check that its commits have landed";
    case "discard":
      return `and its commits may not all be on ${branch}, which finish keeps as the backup`;
    default: {
      const unhandled = mode;
      throw new Error(`unhandled mode: ${unhandled}`);
    }
  }
}
function briefPlaces(read, worktree) {
  const report2 = path46.posix.normalize(read.brief.report);
  const { folder, top } = read;
  return {
    folder,
    top,
    target: read.brief.target,
    report: report2,
    reportFrom: path46.join(worktree, report2),
    reportTo: top === undefined ? undefined : path46.join(top, report2)
  };
}
function placesFor(tops, found, read) {
  return {
    ...tops,
    worktree: found.path,
    branch: found.branch,
    brief: read === undefined ? undefined : briefPlaces(read, found.path)
  };
}
var TRIED_LABEL = {
  transcript: "the transcript's first cwd",
  listing: "the job listing's cwd",
  operator: "the --worktree path",
  name: "by name,"
};
var triedLine = (tried) => [TRIED_LABEL[tried.via], tried.cwd, tried.why].filter((part) => part !== undefined).join(" ");
function notFoundIssues(name, tried) {
  return [
    `finish cannot find the worktree of ${name}, so it removed nothing. It tried:`,
    ...tried.map(triedLine),
    "name the worktree with --worktree <path>, or discard the worker with --discard"
  ];
}
function unprovenIssues(found, name, confirm) {
  if (isBranchProven(found, name))
    return [];
  const native = nativeBranch(name);
  const how = found.via === "listing" ? "the job listing's cwd" : "the transcript's first cwd, which names no branch";
  return [
    `finish found the worktree ${found.path} through ${how}, but it is on ${found.branch}, not ${native}, so nothing shows the branch is the worker's: if it is, confirm with ${confirm}`
  ];
}
var listedLine = (entry) => `${entry.path}: ${entry.branch === undefined ? "detached" : shortBranch(entry.branch)}`;
function operatorIssues(name, tried, linked2) {
  const listed = linked2.length === 0 ? ["git lists no linked worktree"] : ["git lists these linked worktrees:", ...linked2.map(listedLine)];
  return [
    `finish cannot find the worktree of ${name}, so it removed nothing. It tried:`,
    ...tried.map(triedLine),
    ...listed,
    "name the worker's worktree with --worktree <path>, or run finish without --worktree"
  ];
}
function unlinkedIssues(runGit, top, worktree, id) {
  const linkless = fs36.existsSync(worktree) && !fs36.existsSync(path46.join(worktree, ".git"));
  if (!linkless)
    return [];
  const list2 = worktreeListed(runGit, top, worktree);
  if ("issue" in list2) {
    return [
      `git worktree list failed, so finish cannot tell whether git still lists the worktree ${worktree}: ${list2.issue}`
    ];
  }
  if (!list2.listed)
    return [];
  return [
    `the worktree ${worktree} holds no .git entry while git still lists it, so a removal went past git's link to it: claude rm ${shellArg(id)} completes the removal`
  ];
}
var IGNORED_LOSS = "!!";
function statusBesideReport(runGit, places) {
  const status = statusEntriesIn(runGit, places.mainTop, places.worktree);
  if ("issue" in status) {
    return {
      issue: `git status failed in the worktree ${places.worktree}: ${status.issue}`
    };
  }
  const losses = ignoredLosses(runGit, places, { exempt: places.report });
  if ("issue" in losses) {
    return {
      issue: `git status --ignored failed in the worktree ${places.worktree}: ${losses.issue}`
    };
  }
  const ignored = losses.paths.map((lost) => ({
    code: IGNORED_LOSS,
    path: lost
  }));
  const entries = [...status.entries, ...ignored].filter((entry) => entry.path !== places.report);
  return {
    entries,
    report: places.report,
    truncated: losses.truncated,
    skipList: skipListPath(places.commonDir)
  };
}
var onlyDeleted = (entries) => entries.length > 0 && entries.every((entry) => entry.code === DELETED);
var trackedOf = (entries) => entries.filter((entry) => entry.code !== IGNORED_LOSS);
function dirtyAdvice(mode) {
  switch (mode) {
    case "landed":
      return "Commit and integrate it, or remove it, then run finish again";
    case "discard":
      return "Commit it so that the backup ref keeps it, or remove it, then run finish again";
    default: {
      const unhandled = mode;
      throw new Error(`unhandled mode: ${unhandled}`);
    }
  }
}
function dirtyIssues(worktree, status, partial, mode) {
  if ("issue" in status)
    return [status.issue];
  const { entries, report: report2, truncated, skipList } = status;
  const names = (list2) => list2.map((entry) => entry.path).join(", ");
  const tracked = trackedOf(entries);
  const ignored = entries.filter((entry) => entry.code === IGNORED_LOSS);
  const restored = partial && onlyDeleted(tracked);
  const issues = [];
  if (tracked.length > 0 && !restored) {
    const besides = report2 === undefined ? "" : " besides the report";
    issues.push(`the worktree ${worktree} holds uncommitted work${besides}, which its removal would destroy: ${names(tracked)}. ${dirtyAdvice(mode)}`);
  }
  if (ignored.length > 0) {
    const more = truncated ? omittedWords({ kind: "at least", count: 1 }) : "";
    issues.push(`the worktree ${worktree} holds ignored files that its removal would delete, and the main checkout lacks them or holds other contents: ${names(ignored)}${more}. Move or delete them, or add their folder to ${skipList}, then run finish again`);
  }
  return issues;
}
function isPartial(runGit, top, worker, status) {
  const { name, head } = worker;
  if (head === undefined || "issue" in status)
    return false;
  if (!onlyDeleted(trackedOf(status.entries)))
    return false;
  return heldBackup(runGit, top, name, head) !== undefined;
}
function worktreeCheck(runGit, places, worker, opts, commonDir) {
  const status = statusBesideReport(runGit, {
    mainTop: places.mainTop,
    worktree: places.worktree,
    commonDir,
    report: places.brief?.report
  });
  const partial = isPartial(runGit, places.mainTop, worker, status);
  const onBranch = onBranchIssues(runGit, places.worktree, places.branch, opts.mode.kind, discardCommandFor(opts), worker.id);
  const dirty = dirtyIssues(places.worktree, status, partial, opts.mode.kind);
  return { issues: [...onBranch, ...dirty], partial };
}
function headMovedIssues(runGit, ready) {
  const now = commitOf(runGit, ready.mainTop, `refs/heads/${ready.branch}`);
  if (now === ready.head)
    return [];
  if (now === undefined) {
    return [
      `the branch ${ready.branch} is gone, so finish cannot confirm its head is still ${ready.head}, the head it verified`
    ];
  }
  return [
    `${ready.branch} moved to ${now} after finish verified its head ${ready.head}, so finish has not checked the new commits: run finish again`
  ];
}

// bin/helpers/worker-finish-gone.ts
function whenNotFound(tried, at, opts) {
  const { linked: linked2, ...job } = at;
  if (opts.worktree !== undefined) {
    return { issues: operatorIssues(at.name, tried, linked2) };
  }
  if (opts.mode.kind === "landed") {
    return { issues: notFoundIssues(at.name, tried) };
  }
  return { ...job, rerun: rerunCommand(opts), tried };
}
var sayNotFound = (gone, _wenv, out) => {
  out(`finish cannot find the worktree of ${gone.name}, so it removes only its session and record. It tried:`);
  for (const tried of gone.tried)
    out(triedLine(tried));
  return [];
};
var stop = (gone, wenv) => runStop(gone, wenv);
function keptIssues(gone, result) {
  const hand = `claude rm ${shellArg(gone.id)}`;
  const offer = DISCARD_LINE.exec(printedStreams(result).join(`
`));
  if (offer !== null) {
    return [
      ...withText(`${hand} offers to discard ${offer[1]}, but finish found no worktree, so it has no verified head to check that against and did not run it`, result),
      "check what the discard would lose before you run it by hand, or name the worktree with --worktree <path> so that finish verifies its head first"
    ];
  }
  const what = ranClean(result) ? "did not say removed, and finish does not know its answer" : failure(result);
  const stopFirst = `claude stop ${shellArg(gone.id)}, then ${hand}`;
  return [
    ...withText(`${hand} ${what}, so finish removed nothing more`, result),
    `run finish again with ${gone.rerun}, or complete the removal by hand with ${stopFirst}`
  ];
}
var removeSession2 = (gone, wenv, out) => {
  const cwd = gone.mainTop;
  const result = wenv.runClaude(["rm", gone.id], { cwd, timeoutMs: NO_LIMIT });
  if (!saidRemoved(result))
    return keptIssues(gone, result);
  out(`session ${gone.id} removed`);
  return [];
};
var forgetRecord2 = (gone) => {
  removeRecord(gone.commonDir, gone.name);
  return [];
};
var leftoverRoute = (name) => `run sidekick worktree list, then sidekick worktree remove <name> for a worktree the worker left, since remove takes no branch. A branch left with no worktree holds the worker's commits, and blocks a new worktree named ${name}; dispatch refuses it`;
var sayByHand = (gone, _wenv, out) => {
  out(`the worktree of ${gone.name} was not found, so finish deleted no branch: ${leftoverRoute(gone.name)}`);
  return [];
};
var GONE_STEPS = [
  sayNotFound,
  stop,
  removeSession2,
  forgetRecord2,
  sayByHand
];
function clearGone(gone, wenv, out) {
  for (const step of GONE_STEPS) {
    const issues = step(gone, wenv, out);
    if (issues.length > 0)
      return issues;
  }
  return [];
}

// bin/helpers/worker-finish-report.ts
import * as fs37 from "node:fs";
import * as path47 from "node:path";
var isMissing5 = (e) => e instanceof Error && ("code" in e) && e.code === "ENOENT";
function readIfPresent(file) {
  try {
    return { data: fs37.readFileSync(file) };
  } catch (e) {
    if (isMissing5(e))
      return { data: undefined };
    const why = e instanceof Error ? e.message : String(e);
    return { issue: `cannot read ${file}: ${why}` };
  }
}
function reportStep(brief, noReport, partial) {
  if (brief === undefined)
    return { kind: "no brief" };
  const { reportFrom: from, reportTo: to } = brief;
  const worker = readIfPresent(from);
  if ("issue" in worker)
    return { issues: [worker.issue] };
  if (worker.data === undefined) {
    return missingReportStep(brief, noReport, partial);
  }
  if (to === undefined)
    return { issues: [nowhereIssue(brief)] };
  const saved = readIfPresent(to);
  if ("issue" in saved)
    return { issues: [saved.issue] };
  if (saved.data === undefined)
    return { kind: "copy", from, to };
  if (saved.data.equals(worker.data))
    return { kind: "in place", from, to };
  return {
    issues: [
      `${to} already exists and differs from the worker's report at ${from}: move one aside, then run finish again`
    ]
  };
}
var nowhereIssue = (brief) => `the brief's folder ${brief.folder} is in no git checkout, so finish has nowhere to save the run report at ${brief.reportFrom}: move the brief into a checkout of the repo, then run finish again`;
function missingReportStep(brief, noReport, partial) {
  const { reportFrom: from, reportTo: to } = brief;
  if (partial && to !== undefined) {
    const saved = readIfPresent(to);
    if ("issue" in saved)
      return { issues: [saved.issue] };
    if (saved.data !== undefined)
      return { kind: "saved earlier", from, to };
  }
  if (noReport)
    return { kind: "none", from };
  return {
    issues: [
      `the worktree has no run report at ${from}: ask the worker for it, or pass --no-report to finish without one`
    ]
  };
}
function copyReport(from, to, out) {
  try {
    fs37.mkdirSync(path47.dirname(to), { recursive: true });
    fs37.copyFileSync(from, to, fs37.constants.COPYFILE_EXCL);
  } catch (e) {
    const why = e instanceof Error ? e.message : String(e);
    return [`cannot save the report to ${to}: ${why}`];
  }
  out(`report saved to ${to}`);
  return [];
}
var saveReport = (ready, _wenv, out) => {
  const step = ready.reportStep;
  switch (step.kind) {
    case "copy":
      return copyReport(step.from, step.to, out);
    case "in place":
    case "saved earlier":
      out(`report already at ${step.to}`);
      return [];
    case "none":
      out("no report to save: the worktree holds none");
      return [];
    case "no brief":
      out("no report saved: --name reads no brief, so finish does not know where the report is");
      return [];
    default: {
      const unhandled = step;
      throw new Error(`unhandled report step: ${JSON.stringify(unhandled)}`);
    }
  }
};
function reportChangedIssues(ready) {
  const step = ready.reportStep;
  if (step.kind === "no brief")
    return [];
  const now = readIfPresent(step.from);
  if ("issue" in now)
    return [now.issue];
  switch (step.kind) {
    case "none":
    case "saved earlier":
      if (now.data === undefined)
        return [];
      return [`a run report appeared at ${step.from}`];
    case "copy":
    case "in place":
      return copyChangedIssues(step.from, step.to, now.data);
    default: {
      const unhandled = step;
      throw new Error(`unhandled report step: ${JSON.stringify(unhandled)}`);
    }
  }
}
function copyChangedIssues(from, to, now) {
  const saved = readIfPresent(to);
  if ("issue" in saved)
    return [saved.issue];
  const same = now !== undefined && saved.data !== undefined && now.equals(saved.data);
  if (same)
    return [];
  return [`the worker's report at ${from} no longer matches the copy at ${to}`];
}

// bin/helpers/worker-finish-subject.ts
import * as fs38 from "node:fs";
import * as path48 from "node:path";
function topOf(runGit, folder) {
  const found = checkoutOf(runGit, folder);
  return "top" in found ? found.top : undefined;
}
function readSubject(subject, runGit) {
  switch (subject.kind) {
    case "brief": {
      const read = readBrief(subject.brief);
      if ("issues" in read)
        return read;
      const folder = path48.dirname(subject.brief);
      const top = topOf(runGit, folder);
      const { brief } = read;
      return { name: brief.name, from: "brief", read: { brief, folder, top } };
    }
    case "name":
      return { name: subject.name, from: "name", read: undefined };
    default: {
      const unhandled = subject;
      throw new Error(`unhandled subject: ${JSON.stringify(unhandled)}`);
    }
  }
}
function recordedTop(runGit, commonDir, name) {
  const { records } = readRecords(commonDir);
  const record2 = records.find((r) => r.name === name);
  if (record2 === undefined)
    return;
  const folder = path48.dirname(record2.brief);
  return fs38.existsSync(folder) ? topOf(runGit, folder) : undefined;
}
function launcherOf(subject, facts, runGit) {
  const { read } = subject;
  if (read !== undefined) {
    const { top } = read;
    return top === undefined ? undefined : { top, role: "the brief's checkout" };
  }
  const recorded = recordedTop(runGit, facts.commonDir, subject.name);
  if (recorded !== undefined) {
    return { top: recorded, role: "the checkout that dispatched the worker" };
  }
  const linked2 = physical(facts.launchTop) !== physical(facts.mainTop);
  if (!linked2)
    return;
  return { top: facts.launchTop, role: "the checkout finish runs in" };
}

// bin/helpers/worker-finish.ts
var SHORT_SHA2 = 7;
var NAME_FROM = {
  brief: "the name in the brief",
  name: "the name given to --name"
};
function findJob(wenv, top, subject) {
  const { name } = subject;
  const listed = listJobs(wenv.runClaude, top);
  if ("issues" in listed)
    return listed;
  const matches = listed.jobs.filter((job) => job.name === name);
  if (matches.length === 0) {
    return {
      issues: [
        `no session in ${LISTING} is named "${name}". If finish already removed it, ${leftoverRoute(name)}. Otherwise check ${NAME_FROM[subject.from]}`
      ]
    };
  }
  if (matches.length > 1) {
    const which = matches.map((job) => job.id ?? "an interactive session");
    return {
      issues: [
        `${matches.length} sessions in ${LISTING} are named "${name}" (${which.join(", ")}), so finish cannot tell which is the worker: clear the worker by hand with claude rm <id>`
      ]
    };
  }
  const [{ id, state, cwd, sessionId }] = matches;
  if (id === undefined) {
    return {
      issues: [
        `the session named "${name}" is an interactive session, not a worker job: finish clears only a worker that sidekick worker dispatch started`
      ]
    };
  }
  return { id, state, cwd, sessionId };
}
function worktreeOf(wenv, where, job, operatorPath) {
  const { name } = where;
  const found = locateWorktree({
    runGit: wenv.runGit,
    configDir: configDirOf(wenv.env, wenv.home),
    ...where,
    sessionId: job.sessionId,
    listingCwd: job.cwd,
    operatorPath
  });
  if (!("issue" in found))
    return found;
  return {
    issues: [
      `git worktree list failed, so finish cannot find the worktree of ${name}: ${found.issue}`
    ]
  };
}
function locate2(subject, opts, wenv) {
  const facts = checkoutFacts(wenv.runGit, wenv.cwd);
  if ("issues" in facts)
    return facts;
  const { mainTop, launchTop, commonDir } = facts;
  const job = findJob(wenv, mainTop, subject);
  if ("issues" in job)
    return job;
  const launcher = launcherOf(subject, facts, wenv.runGit);
  const where = { name: subject.name, mainTop, launcher };
  const found = worktreeOf(wenv, where, job, opts.worktree);
  if ("issues" in found)
    return found;
  if (found.kind === "not found") {
    const { id } = job;
    const linked2 = facts.worktrees.slice(1);
    const at = { id, name: subject.name, mainTop, commonDir, linked: linked2 };
    const gone = whenNotFound(found.tried, at, opts);
    return "issues" in gone ? gone : { kind: "gone", gone };
  }
  const confirm = rerunCommand({ ...opts, worktree: found.path });
  const unproven = unprovenIssues(found, subject.name, confirm);
  if (unproven.length > 0)
    return { issues: unproven };
  const places = placesFor({ mainTop, launchTop }, found, subject.read);
  return { kind: "found", places, job, commonDir };
}
function landedCheck(wenv, places, branch, opts, { id, out }) {
  const judge3 = judgeFor(wenv.runGit, places, branch, opts, id);
  if ("issues" in judge3)
    return judge3;
  const { head } = judge3;
  switch (judge3.kind) {
    case "discard":
      return { head, verdict: { kind: "discard" } };
    case "landed": {
      out(targetLine(judge3.target));
      const judged = landedVerdict(wenv.runGit, places, { branch: branch.name, head, target: judge3.target }, opts);
      return "issues" in judged ? judged : { head, verdict: judged.verdict };
    }
    default: {
      const unhandled = judge3;
      throw new Error(`unhandled judge: ${JSON.stringify(unhandled)}`);
    }
  }
}
function allIssues(landed, worktreeIssues, step) {
  return [
    ..."issues" in landed ? landed.issues : [],
    ...worktreeIssues,
    ..."issues" in step ? step.issues : []
  ];
}
function checkFinish(name, located, opts, { wenv, out }) {
  const { places, job } = located;
  const { mainTop, worktree } = places;
  const unlinked = unlinkedIssues(wenv.runGit, mainTop, worktree, job.id);
  if (unlinked.length > 0)
    return { issues: unlinked };
  const head = commitOf(wenv.runGit, mainTop, `refs/heads/${places.branch}`);
  const branch = { name: places.branch, head };
  const landed = landedCheck(wenv, places, branch, opts, { id: job.id, out });
  const worker = { name, id: job.id, head };
  const tree = worktreeCheck(wenv.runGit, places, worker, opts, located.commonDir);
  const step = reportStep(places.brief, opts.noReport, tree.partial);
  if ("issues" in landed || tree.issues.length > 0 || "issues" in step) {
    return { issues: allIssues(landed, tree.issues, step) };
  }
  return {
    id: job.id,
    state: job.state,
    name,
    mainTop,
    commonDir: located.commonDir,
    worktree,
    branch: places.branch,
    head: landed.head,
    report: places.brief?.report,
    reportStep: step,
    verdict: landed.verdict,
    rerun: rerunCommand(opts),
    discardCommand: discardCommandFor(opts),
    partial: tree.partial
  };
}
var recheckWorktree = (ready, wenv) => {
  const issues = [
    ...onBranchIssues(wenv.runGit, ready.worktree, ready.branch, ready.verdict.kind, ready.discardCommand, ready.id),
    ...headMovedIssues(wenv.runGit, ready),
    ...dirtyIssues(ready.worktree, statusBesideReport(wenv.runGit, ready), ready.partial, ready.verdict.kind),
    ...reportChangedIssues(ready)
  ];
  if (issues.length === 0)
    return [];
  return [
    "the worktree changed after finish checked it, so finish removed nothing:",
    ...issues
  ];
};
var sayVerdict = (ready, _wenv, out) => {
  const { verdict } = ready;
  switch (verdict.kind) {
    case "landed":
      out(`${ready.branch} landed in ${verdict.target.name} at ${verdict.at.slice(0, SHORT_SHA2)}`);
      return [];
    case "discard":
      out(`${ready.branch} is discarded on your word`);
      return [];
    default: {
      const unhandled = verdict;
      throw new Error(`unhandled verdict: ${JSON.stringify(unhandled)}`);
    }
  }
};
var sayBackup = (ready, _wenv, out) => {
  const ref2 = readyBackup(ready);
  out(`${ready.branch} is kept as ${ref2}: restore it with git branch ${shellArg(ready.branch)} ${shellArg(ref2)}`);
  return [];
};
var STEPS = [
  sayVerdict,
  saveReport,
  stopJob,
  waitForLock,
  recheckWorktree,
  keepBackup,
  restorePartial,
  removeSession,
  forgetRecord,
  removeLeftovers,
  sayBackup
];
function finishIssues(opts, wenv, out) {
  const subject = readSubject(opts.subject, wenv.runGit);
  if ("issues" in subject)
    return subject.issues;
  const located = locate2(subject, opts, wenv);
  if ("issues" in located)
    return located.issues;
  if (located.kind === "gone")
    return clearGone(located.gone, wenv, out);
  const ready = checkFinish(subject.name, located, opts, { wenv, out });
  if ("issues" in ready)
    return ready.issues;
  for (const step of STEPS) {
    const issues = step(ready, wenv, out);
    if (issues.length > 0)
      return issues;
  }
  return [];
}
function finish(opts, wenv, out, err) {
  const issues = finishIssues(opts, wenv, out);
  for (const issue of issues)
    err(issue);
  return issues.length === 0 ? 0 : 1;
}

// bin/helpers/worker.ts
var WORKER_USAGE_LINE = "sidekick worker dispatch (<brief> | --check) --permission-mode <mode> [--profile <name>] [--plugin-dir <dir>] [--allow-push] | finish (<brief> | --name <name>) [--no-report] [--into <rev> | --discard] [--worktree <path>]";
var usage2 = (err) => {
  err(`usage: ${WORKER_USAGE_LINE}`);
  return 1;
};
var refuse5 = (err, lines) => {
  for (const line of lines)
    err(line);
  return 1;
};
var dispatchVerb = (rest2, wenv, out, err) => {
  const opts = parseDispatchArgs(rest2, wenv.cwd);
  if (opts === undefined)
    return usage2(err);
  if ("usageErrors" in opts)
    return refuse5(err, opts.usageErrors);
  return dispatch(opts, wenv, out, err);
};
var finishVerb = (rest2, wenv, out, err) => {
  const args = parseFinishArgs(rest2, wenv.cwd);
  if (args === undefined)
    return usage2(err);
  if ("usageErrors" in args)
    return refuse5(err, args.usageErrors);
  return finish(args, wenv, out, err);
};
var VERBS4 = {
  dispatch: dispatchVerb,
  finish: finishVerb
};
function runWorkerCli(args, wenv, out, err) {
  const [name, ...rest2] = args;
  if (name === undefined || !Object.hasOwn(VERBS4, name))
    return usage2(err);
  return VERBS4[name](rest2, wenv, out, err);
}
function sleepSync(ms) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}
function processIsAlive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (e) {
    return !(e instanceof Error && ("code" in e) && e.code === "ESRCH");
  }
}

// bin/helpers/worktree-mark.ts
var MARK_KEY = "sidekickWorktree";
var markKeyOf = (branch) => `branch.${branch}.${MARK_KEY}`;
function markOf2(runGit, top, branch) {
  const result = runGit("git", ["config", "--local", "--get", markKeyOf(branch)], top);
  if (result.code !== 0) {
    return;
  }
  const name = result.stdout.trim();
  return name === "" ? undefined : name;
}
function writeMark(runGit, top, branch, name) {
  const result = runGit("git", ["config", "--local", markKeyOf(branch), name], top);
  return result.code === 0 ? [] : [`git config ${markKeyOf(branch)} failed: ${result.stderr.trim()}`];
}
function clearMark(runGit, top, branch) {
  const args = ["config", "--local", "--unset", markKeyOf(branch)];
  const result = runGit("git", args, top);
  return result.code === 0 ? [] : [`git ${args.join(" ")} failed: ${result.stderr.trim()}`];
}
function isOwnBranch(runGit, top, branch, name) {
  return branch === nativeBranch(name) || markOf2(runGit, top, branch) === name;
}

// bin/helpers/worktree-move-checks.ts
import * as path49 from "node:path";
var DIGITS = /^\d+$/;
function parseMoveArgs(rest2) {
  const parsed = parseFlags(rest2, {
    from: { type: "string" },
    pr: { type: "string" }
  });
  if (parsed === undefined)
    return;
  const { values, positionals } = parsed;
  const from = typeof values.from === "string" ? values.from : undefined;
  if (typeof values.pr === "string") {
    const number2 = Number(values.pr);
    const fits = positionals.length === 0 && from === undefined && DIGITS.test(values.pr) && Number.isSafeInteger(number2) && number2 > 0;
    return fits ? { kind: "pr", number: number2 } : undefined;
  }
  if (positionals.length !== 1 || from === "")
    return;
  return { kind: "branch", branch: positionals[0], from };
}
var refuse6 = (...lines) => ({ kind: "refused", lines });
var ORIGIN2 = "origin";
var SEPARATOR = " · ";
var PATHS_CAP = 20;
var NO_MATCH = 2;
var INSIDE_WAY = "run move inside the worktree EnterWorktree or claude -w made";
var FRESH_WAY = "move runs only on a fresh worktree: start one with EnterWorktree or claude -w";
var BRIEF_WAY = "a worker's brief sets its branch, not move";
var AGAIN_WAY = "then run move again";
var gitWords = (stderr) => stderr.split(`
`).map((line) => line.trim()).filter((line) => line !== "").join(" ");
function whereItRuns(env, err) {
  const repo = repoOf2(env, err);
  if (repo === undefined) {
    return refuse6(`move found no repository at ${env.cwd}: ${INSIDE_WAY}`);
  }
  const checkout = checkoutOf(env.runGit, env.cwd);
  if ("issue" in checkout) {
    return refuse6(`${env.cwd} is in no work tree, as git says: ${gitWords(checkout.issue)}`, INSIDE_WAY);
  }
  const top = physical(checkout.top);
  const at = repo.worktrees.findIndex((entry2) => physical(entry2.path) === top);
  if (at === 0) {
    return refuse6(`${checkout.top} is the main checkout, not a linked worktree: ${INSIDE_WAY}`);
  }
  if (at === -1) {
    return refuse6(`git lists no worktree at ${checkout.top}: ${INSIDE_WAY}`);
  }
  const entry = repo.worktrees[at];
  return { repo, entry, name: path49.basename(entry.path) };
}
var heldElsewhere = (place, branch) => place.repo.worktrees.some((entry) => entry !== place.entry && entry.branch === `${HEADS}${branch}`);
function onBranchMoved(runGit, place, on, branch) {
  const { entry, name } = place;
  if (on === branch)
    return branch !== nativeBranch(name);
  const ownMarked = on === name && markOf2(runGit, entry.path, name) === name;
  return ownMarked && heldElsewhere(place, branch);
}
function isMoved(runGit, place, args, on) {
  switch (args.kind) {
    case "branch":
      return onBranchMoved(runGit, place, on, args.branch);
    case "pr": {
      const pr = `refs/remotes/pr/${args.number}`;
      const head = place.entry.head;
      return on === undefined && commitOf(runGit, place.entry.path, pr) === head;
    }
    default: {
      const _exhaustive = args;
      throw new Error(`Unhandled args: ${JSON.stringify(_exhaustive)}`);
    }
  }
}
function rerunLine(runGit, place, args) {
  const { entry } = place;
  if (entry.head === undefined)
    return;
  const on = entry.branch === undefined ? undefined : shortBranch(entry.branch);
  if (!isMoved(runGit, place, args, on))
    return;
  return [on ?? "detached", entry.head, "already moved"].join(SEPARATOR);
}
function workerRefusal(env, place) {
  const brief = env.env.SIDEKICK_WORKER;
  if (brief !== undefined && brief !== "") {
    return refuse6(`this session is a worker, as SIDEKICK_WORKER is set to ${brief}: ${BRIEF_WAY}`);
  }
  const stored = readRecords(place.repo.commonDir);
  const record2 = stored.records.find((candidate) => isWorkers(place.repo.top, candidate.name, place.entry));
  if (record2 !== undefined) {
    return refuse6(`${place.entry.path} is the worker ${record2.name}'s worktree: ${BRIEF_WAY}`);
  }
  if (stored.warnings.length === 0)
    return;
  return refuse6(`a worker record would not read, so ${place.entry.path} may be that worker's worktree: ${stored.warnings.join("; ")}`, `fix or remove the named record, ${AGAIN_WAY}`);
}
function branchRefusal(place) {
  const { entry, name } = place;
  const own = nativeBranch(name);
  if (entry.branch === `${HEADS}${own}`)
    return;
  const found = entry.branch === undefined ? `${entry.path} has a detached HEAD at ${entry.head ?? "no commit"}, not ${own}` : `${entry.path} is on ${shortBranch(entry.branch)}, not ${own}`;
  return refuse6(found, FRESH_WAY);
}
function changesRefusal(runGit, place) {
  const { entry } = place;
  const status = statusEntriesIn(runGit, place.repo.top, entry.path);
  if ("issue" in status) {
    return refuse6(`git status failed in ${entry.path}, so move cannot tell whether it has changes: ${gitWords(status.issue)}`);
  }
  if (status.entries.length === 0)
    return;
  const paths = status.entries.map((e) => e.path);
  const omitted = {
    kind: "exact",
    count: Math.max(0, paths.length - PATHS_CAP)
  };
  return refuse6(`${entry.path} has tracked or untracked changes: ${paths.slice(0, PATHS_CAP).join(", ")}${omittedWords(omitted)}`, `take them out of the worktree or delete them, ${AGAIN_WAY}`);
}
var commitCount = (count2) => `${count2} ${count2 === 1 ? "commit" : "commits"}`;
function onTopWords(runGit, dir, base, head) {
  const result = runGit("git", ["rev-list", "--count", `${base}..${head}`], dir);
  const count2 = Number(result.stdout.trim());
  if (result.code !== 0 || !Number.isSafeInteger(count2)) {
    return `commits git rev-list could not count (${gitWords(result.stderr)})`;
  }
  return commitCount(count2);
}
function freshHead(runGit, place) {
  const { entry, name } = place;
  const created = creationCommit(runGit, entry.path, entry.branch);
  if ("issue" in created) {
    return refuse6(`move cannot tell whether ${entry.path} is fresh: ${created.issue}`, FRESH_WAY);
  }
  if (entry.head === created.sha)
    return created.sha;
  const head = entry.head ?? "no commit";
  const onTop = onTopWords(runGit, entry.path, created.sha, head);
  return refuse6(`the HEAD of ${entry.path} is ${head}, not ${nativeBranch(name)}'s creation commit ${created.sha}, with ${onTop} on top of it`, FRESH_WAY);
}
function nameRefusal(runGit, dir, branch) {
  const verdict = branchNameOf(runGit, dir, branch);
  if ("issue" in verdict) {
    return refuse6(`git check-ref-format refuses ${branch}: ${verdict.issue}. Choose another name`);
  }
  if (verdict.read === branch)
    return;
  return refuse6(`git reads ${branch} as the branch ${verdict.read}: name it as ${verdict.read}`);
}
function branchNameOf(runGit, dir, name) {
  const result = runGit("git", ["check-ref-format", "--branch", name], dir);
  if (result.code !== 0)
    return { issue: gitWords(result.stderr) };
  return { read: result.stdout.trim() };
}
function isPlainBranchName(runGit, dir, name) {
  const verdict = branchNameOf(runGit, dir, name);
  return "read" in verdict && verdict.read === name;
}
function remotesOf(runGit, dir) {
  const result = runGit("git", ["remote"], dir);
  if (result.code !== 0) {
    return refuse6(`git remote failed in ${dir}: ${gitWords(result.stderr)}`);
  }
  return result.stdout.split(`
`).map((line) => line.trim()).filter((line) => line !== "");
}
var remoteOf = (name, remotes) => remotes.filter((remote) => name === remote || name.startsWith(`${remote}/`)).sort((a, b) => b.length - a.length)[0];
function ambiguityRefusal(branch, remotes) {
  const remote = remoteOf(branch, remotes);
  if (remote === undefined)
    return;
  if (remote === branch) {
    return refuse6(`${branch} is a remote's name, so it reads as that remote: choose another name`);
  }
  const rest2 = branch.slice(remote.length + 1);
  return refuse6(`${branch} begins with ${remote}/, a remote's name, so it reads as a branch of ${remote}: name it without the remote, as ${rest2}`);
}
var fromRefusal = (branch, where) => refuse6(`${branch} exists${where}, and --from asks move to create it: drop --from to move onto it`);
function localPlan(runGit, place, branch) {
  const { entry, name } = place;
  if (branch === nativeBranch(name)) {
    return refuse6(`${branch} is the branch Claude Code made for this worktree, which move replaces: name the branch to move onto`);
  }
  const holder = place.repo.worktrees.find((other) => other.branch === `${HEADS}${branch}`);
  if (holder === undefined)
    return { kind: "switch", branch };
  const sha = commitOf(runGit, entry.path, `${HEADS}${branch}`);
  if (sha === undefined) {
    return refuse6(`${branch} names no commit, so move cannot branch from it`);
  }
  if (branchExists(runGit, entry.path, name)) {
    return refuse6(`${holder.path} holds ${branch}, so move would create the branch ${name} at its commit, but ${name} exists`, `switch ${holder.path} to another branch, or start a worktree under another name, ${AGAIN_WAY}`);
  }
  return { kind: "held", branch, own: name, sha, heldAt: holder.path };
}
function onOrigin(runGit, dir, branch) {
  const ref2 = `${HEADS}${branch}`;
  const result = runGit("git", ["ls-remote", "--exit-code", "--heads", ORIGIN2, ref2], dir);
  if (result.code === NO_MATCH)
    return false;
  if (result.code !== 0) {
    return refuse6(`git ls-remote origin failed, so move cannot tell whether origin has ${branch}: ${gitWords(result.stderr)}`, `check the remote origin, ${AGAIN_WAY}`);
  }
  return result.stdout.split(`
`).some((line) => line.split("\t")[1] === ref2);
}
function baseOf(runGit, dir, from, remotes) {
  if (from === undefined)
    return { kind: "here" };
  const remote = remoteOf(from, remotes);
  const remoteBranch = remote === undefined ? "" : from.slice(remote.length + 1);
  const isRemoteBranch = remote !== undefined && remoteBranch !== "" && isPlainBranchName(runGit, dir, remoteBranch) && !branchExists(runGit, dir, from);
  if (isRemoteBranch) {
    return { kind: "remote", remote, branch: remoteBranch };
  }
  const sha = commitOf(runGit, dir, from);
  if (sha === undefined) {
    return refuse6(`--from ${from} names no commit: give a branch, tag, or commit, or <remote>/<branch> for a remote's branch`);
  }
  return { kind: "local", rev: from, sha };
}
function branchPlan(runGit, place, args, remotes) {
  const { branch, from } = args;
  const dir = place.entry.path;
  if (branchExists(runGit, dir, branch)) {
    return localPlan(runGit, place, branch);
  }
  const remote = remotes.includes(ORIGIN2) ? onOrigin(runGit, dir, branch) : false;
  if (typeof remote !== "boolean")
    return remote;
  if (remote) {
    return from === undefined ? { kind: "origin", branch } : fromRefusal(branch, " on origin");
  }
  const base = baseOf(runGit, dir, from, remotes);
  if (base.kind === "refused")
    return base;
  return { kind: "new", branch, base };
}
function branchMove(runGit, place, args) {
  const dir = place.entry.path;
  const named = nameRefusal(runGit, dir, args.branch);
  if (named !== undefined)
    return named;
  const remotes = remotesOf(runGit, dir);
  if (!Array.isArray(remotes))
    return remotes;
  const ambiguous = ambiguityRefusal(args.branch, remotes);
  if (ambiguous !== undefined)
    return ambiguous;
  if (args.from !== undefined && branchExists(runGit, dir, args.branch)) {
    return fromRefusal(args.branch, "");
  }
  return branchPlan(runGit, place, args, remotes);
}
function prMove(runGit, place, number2) {
  const remotes = remotesOf(runGit, place.entry.path);
  if (!Array.isArray(remotes))
    return remotes;
  if (remotes.includes(ORIGIN2))
    return { kind: "pr", number: number2 };
  return refuse6(`--pr reads pull requests from origin, and this repository has no remote named origin: add the GitHub remote as origin, ${AGAIN_WAY}`);
}
function checkMove(args, env, err) {
  const { runGit } = env;
  const place = whereItRuns(env, err);
  if ("lines" in place)
    return place;
  const line = rerunLine(runGit, place, args);
  if (line !== undefined)
    return { kind: "already", line };
  const unfresh = workerRefusal(env, place) ?? branchRefusal(place) ?? changesRefusal(runGit, place);
  if (unfresh !== undefined)
    return unfresh;
  const created = freshHead(runGit, place);
  if (typeof created !== "string")
    return created;
  const plan = args.kind === "pr" ? prMove(runGit, place, args.number) : branchMove(runGit, place, args);
  if (plan.kind === "refused")
    return plan;
  return { kind: "ready", here: { ...place, created }, plan };
}

// bin/helpers/worktree-move.ts
var SEPARATOR2 = " · ";
var ORIGIN3 = "origin";
var DETACHED = "a detached HEAD";
var AGAIN_WAY2 = "then run move again";
var command = (args) => ["git", ...args].map(shellArg).join(" ");
var create2 = (branch, start) => [
  "-c",
  branch,
  "--no-track",
  start
];
var at = (args) => ({ args, fetched: undefined });
var stayedLine = (here) => `nothing changed in ${here.entry.path}: it is still on ${nativeBranch(here.name)}`;
function fetchInto(runGit, here, remote, refspec) {
  const spec = `+${refspec.src}:${refspec.dst}`;
  const result = runGit("git", ["fetch", remote, spec], here.entry.path);
  if (result.code === 0)
    return;
  return {
    lines: [
      `git fetch ${remote} ${spec} failed: ${gitWords(result.stderr)}`,
      stayedLine(here),
      `check the remote ${remote}, ${AGAIN_WAY2}`
    ]
  };
}
function fromRemote(runGit, here, branch, from) {
  const dst = `refs/remotes/${from.remote}/${from.branch}`;
  const src = `${HEADS}${from.branch}`;
  const failed = fetchInto(runGit, here, from.remote, { src, dst });
  if (failed !== undefined)
    return failed;
  const sha = commitOf(runGit, here.entry.path, dst);
  if (sha !== undefined)
    return { args: create2(branch, sha), fetched: dst };
  return {
    lines: [
      `git fetch ${from.remote} left ${dst} naming no commit`,
      stayedLine(here),
      `check the remote ${from.remote}, ${AGAIN_WAY2}`
    ]
  };
}
function prStart(runGit, here, number2) {
  const dst = `refs/remotes/pr/${number2}`;
  const src = `refs/pull/${number2}/head`;
  const failed = fetchInto(runGit, here, ORIGIN3, { src, dst });
  return failed ?? { args: ["--detach", dst], fetched: dst };
}
function newStart(branch, base) {
  switch (base.kind) {
    case "here":
      return (_, here) => at(create2(branch, here.created));
    case "local":
      return () => at(create2(branch, base.sha));
    case "remote":
      return (runGit, here) => fromRemote(runGit, here, branch, base);
    default: {
      const _exhaustive = base;
      throw new Error(`Unhandled base: ${JSON.stringify(_exhaustive)}`);
    }
  }
}
function baseWords(base) {
  switch (base.kind) {
    case "here":
      return "the worktree's commit";
    case "local":
      return base.rev;
    case "remote":
      return `${base.remote}/${base.branch}`;
    default: {
      const _exhaustive = base;
      throw new Error(`Unhandled base: ${JSON.stringify(_exhaustive)}`);
    }
  }
}
var markStep = (branch) => (runGit, here, moved) => {
  const issues = writeMark(runGit, here.entry.path, branch, here.name);
  if (issues.length === 0)
    return [];
  const key = markKeyOf(branch);
  return [
    ...issues.map(gitWords),
    `${moved}, and ${branch} stays unmarked, so remove keeps it`,
    `mark it with: ${command(["config", "--local", key, here.name])}`
  ];
};
var clearStale = (branch) => (runGit, here, moved) => {
  const dir = here.entry.path;
  const mark = markOf2(runGit, dir, branch);
  if (mark === undefined)
    return [];
  const issues = clearMark(runGit, dir, branch);
  const key = markKeyOf(branch);
  if (issues.length === 0) {
    return [
      `cleared the stale mark ${key}, which named the worktree ${mark}: move leaves an existing or tracking branch unmarked, so remove keeps ${branch}`
    ];
  }
  return [
    ...issues.map(gitWords),
    `${moved}, and ${branch} stays marked for the worktree ${mark}, so remove deletes it from a worktree of that name`,
    `clear it with: ${command(["config", "--local", "--unset", key])}`
  ];
};
var nothingToClear = () => [];
var upstreamStep = (branch) => (runGit, here, moved) => {
  const writes = [
    ["config", "--local", `branch.${branch}.remote`, ORIGIN3],
    ["config", "--local", `branch.${branch}.merge`, `${HEADS}${branch}`]
  ];
  for (const args of writes) {
    const result = runGit("git", args, here.entry.path);
    if (result.code !== 0) {
      return [
        `${command(args)} failed: ${gitWords(result.stderr)}`,
        `${moved}, and ${branch} has no upstream`,
        `set it with: ${command(writes[0])}`,
        `and: ${command(writes[1])}`
      ];
    }
  }
  return [];
};
var settled = () => [];
function moveOf(plan) {
  switch (plan.kind) {
    case "new":
      return {
        target: plan.branch,
        fields: ["new branch", `from ${baseWords(plan.base)}`],
        start: newStart(plan.branch, plan.base),
        clear: nothingToClear,
        settle: markStep(plan.branch)
      };
    case "switch":
      return {
        target: plan.branch,
        fields: ["existing branch", `from ${plan.branch}`],
        start: () => at([plan.branch]),
        clear: clearStale(plan.branch),
        settle: settled
      };
    case "held":
      return {
        target: plan.own,
        fields: [
          "new branch for a held one",
          `from ${plan.branch}`,
          `land onto ${plan.branch}`
        ],
        start: () => at(create2(plan.own, plan.sha)),
        clear: nothingToClear,
        settle: markStep(plan.own)
      };
    case "origin": {
      const from = { remote: ORIGIN3, branch: plan.branch };
      return {
        target: plan.branch,
        fields: ["tracking branch", `from ${ORIGIN3}/${plan.branch}`],
        start: (runGit, here) => fromRemote(runGit, here, plan.branch, from),
        clear: clearStale(plan.branch),
        settle: upstreamStep(plan.branch)
      };
    }
    case "pr":
      return {
        target: undefined,
        fields: [
          `pull request ${plan.number}, read-only`,
          `from pr/${plan.number}`
        ],
        start: (runGit, here) => prStart(runGit, here, plan.number),
        clear: nothingToClear,
        settle: settled
      };
    default: {
      const _exhaustive = plan;
      throw new Error(`Unhandled plan: ${JSON.stringify(_exhaustive)}`);
    }
  }
}
function headRef(runGit, dir) {
  const result = runGit("git", ["rev-parse", "--symbolic-full-name", "HEAD"], dir);
  return result.code === 0 ? result.stdout.trim() : undefined;
}
function onWords(ref2) {
  if (ref2 === undefined)
    return "a HEAD git cannot read";
  return ref2 === "HEAD" ? DETACHED : ref2.replace(HEADS, "");
}
function leftLines(runGit, here) {
  const dir = here.entry.path;
  const own = nativeBranch(here.name);
  const ref2 = headRef(runGit, dir);
  const status = statusEntriesIn(runGit, here.repo.top, dir);
  const clean = !("issue" in status) && status.entries.length === 0;
  if (ref2 === `${HEADS}${own}` && clean) {
    return [
      stayedLine(here),
      `move or delete the files git names, ${AGAIN_WAY2}`
    ];
  }
  const changes = "issue" in status ? `and git status failed: ${gitWords(status.issue)}` : `changed paths: ${status.entries.length}`;
  return [
    `git left ${dir} on ${onWords(ref2)}, ${changes}`,
    `check git status in ${dir} before you run move again`
  ];
}
function switchTo(runGit, here, start) {
  const args = ["switch", "--no-overwrite-ignore", ...start.args];
  const result = runGit("git", args, here.entry.path);
  if (result.code === 0)
    return;
  const fetched = start.fetched === undefined ? [] : [`${start.fetched} holds the fetched commit`];
  return {
    lines: [
      `${command(args)} failed: ${gitWords(result.stderr)}`,
      ...fetched,
      ...leftLines(runGit, here)
    ]
  };
}
function landed(runGit, here, target) {
  const dir = here.entry.path;
  const want = target === undefined ? "HEAD" : `${HEADS}${target}`;
  const ref2 = headRef(runGit, dir);
  const sha = commitOf(runGit, dir, "HEAD");
  if (ref2 === want && sha !== undefined)
    return sha;
  const own = nativeBranch(here.name);
  return {
    lines: [
      `git switch exited 0, but ${dir} is on ${onWords(ref2)}, not ${target ?? DETACHED}`,
      `move marked nothing and kept ${own}: check git status in ${dir}, ${AGAIN_WAY2}`
    ]
  };
}
function dropLines(runGit, here, moved) {
  const dir = here.entry.path;
  const own = nativeBranch(here.name);
  const issues = branchGoneIssues(runGit, dir, own, here.created);
  if (issues.length === 0)
    return [];
  if (branchExists(runGit, dir, own)) {
    const remove = ["update-ref", "-d", `${HEADS}${own}`, here.created];
    return [
      ...issues.map(gitWords),
      `${moved}, and ${own} stays at its creation commit ${here.created}, holding no commits of its own`,
      `delete it with: ${command(remove)}`
    ];
  }
  const section = ["config", "--remove-section", `branch.${own}`];
  return [
    ...issues.map(gitWords),
    `${moved}, and ${own} is gone, but its config section stays`,
    `drop it with: ${command(section)}`
  ];
}
var fail = (lines, err) => {
  for (const line of lines)
    err(line);
  return 1;
};
function makeMove(runGit, ready, out, err) {
  const { here } = ready;
  const move = moveOf(ready.plan);
  const start = move.start(runGit, here);
  if ("lines" in start)
    return fail(start.lines, err);
  const switchFailed = switchTo(runGit, here, start);
  if (switchFailed !== undefined)
    return fail(switchFailed.lines, err);
  const sha = landed(runGit, here, move.target);
  if (typeof sha !== "string")
    return fail(sha.lines, err);
  const moved = `the worktree moved to ${move.target ?? DETACHED} at ${sha}`;
  const notes = move.clear(runGit, here, moved);
  const issues = [
    ...move.settle(runGit, here, moved),
    ...dropLines(runGit, here, moved)
  ];
  if (issues.length > 0)
    return fail([...notes, ...issues], err);
  for (const line of notes)
    err(line);
  out([move.target ?? "detached", sha, ...move.fields].join(SEPARATOR2));
  return 0;
}
function moveWorktree(args, env, out, err) {
  const checked2 = checkMove(args, env, err);
  switch (checked2.kind) {
    case "refused":
      return fail(checked2.lines, err);
    case "already":
      out(checked2.line);
      return 0;
    case "ready":
      return makeMove(env.runGit, checked2, out, err);
    default: {
      const _exhaustive = checked2;
      throw new Error(`Unhandled check: ${JSON.stringify(_exhaustive)}`);
    }
  }
}

// bin/helpers/worktree-remove-checks.ts
import * as path50 from "node:path";
var DISCARD = "--discard";
var REMOTES2 = "refs/remotes/";
function parseRemoveArgs(rest2) {
  const parsed = parseFlags(rest2, {
    discard: { type: "boolean" },
    into: { type: "string", multiple: true }
  });
  if (parsed === undefined)
    return;
  const { values, lists, positionals } = parsed;
  const into = lists.into ?? [];
  const fits = positionals.length === 1 && into.length <= 1 && into.every((target) => target !== "");
  if (!fits)
    return;
  return {
    target: positionals[0],
    discard: values.discard === true,
    into: into.at(0)
  };
}
var refuse7 = (...lines) => ({ refused: lines });
var INTO_WAY = "name a local branch, such as main, or a remote-tracking ref, such as origin/main";
function refCommit(runGit, top, ref2) {
  const shown2 = runGit("git", ["show-ref", "--verify", "--hash", ref2], top);
  if (shown2.code !== 0)
    return;
  return commitOf(runGit, top, shown2.stdout.trim());
}
function intoTargets(runGit, top, into) {
  if (into === undefined)
    return [];
  for (const ref2 of [`${HEADS}${into}`, `${REMOTES2}${into}`]) {
    const sha = refCommit(runGit, top, ref2);
    if (sha !== undefined)
      return [{ name: into, sha, ref: ref2 }];
  }
  return refuse7(`--into ${into} names no local branch and no remote-tracking ref, so remove took nothing`, INTO_WAY);
}
function ownIntoLines(targets, entry) {
  return targets.filter((target) => target.ref === entry.branch).map((target) => `--into ${target.name} is the branch ${entry.path} is on, which holds its head whether or not the work landed, so it cannot show the work landed there: name the branch it should land in`);
}
var samePath = (a, b) => physical(a) === physical(b);
var alone = (repo, entry) => ({
  ...repo,
  worktrees: [repo.worktrees[0], entry]
});
function resolveTarget3(repo, cwd, target) {
  const asPath = path50.resolve(cwd, target);
  const matches = repo.worktrees.filter((entry2) => path50.basename(entry2.path) === target || samePath(entry2.path, asPath));
  if (matches.length === 0) {
    return refuse7(`no worktree is named ${target} or sits at ${asPath}: sidekick worktree list names each one`);
  }
  if (matches.length > 1) {
    const paths = matches.map((entry2) => entry2.path).join(", ");
    return refuse7(`${matches.length} worktrees match ${target}: ${paths}. Name one by its path`);
  }
  const [entry] = matches;
  if (entry === repo.worktrees[0]) {
    return refuse7(`${entry.path} is the main checkout, which remove never takes`);
  }
  if (insideOf(cwd, entry.path)) {
    return refuse7(`remove runs inside ${entry.path}, so it cannot take that worktree. Leave it first: in a Claude Code session, ExitWorktree with keep; in a shell, cd out. Then run remove from the main checkout`);
  }
  return entry;
}
function nestedLines(repo, entry) {
  const nested = repo.worktrees.filter((other) => other !== entry && insideOf(other.path, entry.path));
  if (nested.length === 0)
    return [];
  const paths = nested.map((other) => other.path).join(", ");
  return [
    `${entry.path} holds other worktrees, which its removal would delete: ${paths}. Remove those first`
  ];
}
var TOOK_NOTHING = "so remove took nothing";
var KEPT_WORKTREE = "so remove kept the worktree";
function stateLines(state, entry, skipList, stopped = TOOK_NOTHING) {
  switch (state.kind) {
    case "held":
      return [`${entry.path} is ${heldWords(state.by)}, ${stopped}`];
    case "worker":
      return [
        `${entry.path} is the worker ${state.name}'s: clear it with sidekick worker finish, which removes its session too`
      ];
    case "dirty":
      return [
        `${entry.path} holds files its removal would lose: ${state.paths.join(", ")}${omittedWords(state.omitted)}`,
        `commit, move, or delete them, then run remove again. An ignored file goes with the worktree once its folder is listed in ${skipList}`
      ];
    case "folder gone":
    case "removable":
      return [];
    default: {
      const _exhaustive = state;
      throw new Error(`Unhandled state: ${JSON.stringify(_exhaustive)}`);
    }
  }
}
var commitCount2 = (count2) => `${count2} ${count2 === 1 ? "commit" : "commits"}`;
var DISCARD_WAY = `run remove again with ${DISCARD} to remove it anyway, keeping them in a backup ref only`;
function nowhereWords(extra) {
  if (extra.length === 0) {
    return "in no landed branch and no remote-tracking ref";
  }
  const names = extra.map((target) => target.name).join(", ");
  return `in no landed branch, not in ${names}, and in no remote-tracking ref`;
}
function backupKind(commits, branch, judging) {
  const { stays, where } = branch;
  const { discard: discard2, extra } = judging;
  switch (commits.kind) {
    case "landed":
      return "landed";
    case "pushed":
      return "pushed";
    case "only here":
      if (stays)
        return "kept";
      if (discard2)
        return "discarded";
      return refuse7(`${where} has ${commitCount2(commits.count)} found ${nowhereWords(extra)}, as of the last fetch, so remove took nothing`, DISCARD_WAY);
    case "unknown":
      if (stays)
        return "kept";
      if (discard2)
        return "discarded";
      return refuse7(`remove cannot tell where the commits of ${where} live, as ${commits.why}, so it took nothing`, DISCARD_WAY);
    default: {
      const _exhaustive = commits;
      throw new Error(`Unhandled commits: ${JSON.stringify(_exhaustive)}`);
    }
  }
}
var whereOf = (entry) => entry.branch?.replace(HEADS, "") ?? `the detached HEAD at ${entry.path}`;
function branchPlan2(env, repo, row2, judging) {
  const { entry, name } = row2;
  const head = entry.head === undefined ? undefined : commitOf(env.runGit, repo.top, entry.head);
  if (head === undefined) {
    return refuse7(`git lists no commit for ${entry.path}, so remove cannot keep a backup ref, and took nothing`);
  }
  const branch = entry.branch?.replace(HEADS, "");
  const stays = branch !== undefined && !isOwnBranch(env.runGit, repo.top, branch, name);
  const where = whereOf(entry);
  const commits = row2.commits ?? commitsAt(env.runGit, repo, head, judging.extra);
  const kind = backupKind(commits, { stays, where }, judging);
  if (typeof kind !== "string")
    return kind;
  const ref2 = backupRef(kind, name, head);
  return { entry, name, head, commits, plan: planOf(branch, stays, ref2) };
}
function landedLines(extra, checked2) {
  const { commits, entry } = checked2;
  if (extra.length === 0 || commits.kind !== "landed")
    return [];
  return [`${whereOf(entry)} landed in ${commits.in}`];
}
function planOf(branch, stays, ref2) {
  if (branch === undefined)
    return { kind: "detached", ref: ref2 };
  return stays ? { kind: "keep", branch, ref: ref2 } : { kind: "delete", branch, ref: ref2 };
}
function checkTarget(args, env, repo, out) {
  const extra = intoTargets(env.runGit, repo.top, args.into);
  if ("refused" in extra)
    return extra;
  const entry = resolveTarget3(repo, env.cwd, args.target);
  if ("refused" in entry)
    return entry;
  const ownInto = ownIntoLines(extra, entry);
  if (ownInto.length > 0)
    return refuse7(...ownInto);
  const nested = nestedLines(repo, entry);
  if (nested.length > 0)
    return refuse7(...nested);
  const { src, listing, skipWarnings } = readSources(env, alone(repo, entry));
  if ("error" in listing) {
    return refuse7(`claude agents failed, so remove cannot tell whether a session is in ${entry.path}, and took nothing: ${listing.error}`);
  }
  for (const warning of [...listing.warnings, ...skipWarnings]) {
    out(warning);
  }
  const [row2] = worktreeRows(src, env.runGit, extra);
  const kept = stateLines(row2.state, entry, skipListPath(repo.commonDir));
  if (kept.length > 0)
    return refuse7(...kept);
  const checked2 = branchPlan2(env, repo, row2, { discard: args.discard, extra });
  if ("refused" in checked2)
    return checked2;
  for (const line of landedLines(extra, checked2))
    out(line);
  return checked2;
}
function movedLines(entry, head, stopped) {
  if (entry.head === head)
    return [];
  return [
    `the HEAD of ${entry.path} moved from ${head} to ${entry.head ?? "no commit"} since the checks, ${stopped}: run remove again`
  ];
}
function recheck(env, repo, checked2) {
  const { src, listing } = readSources(env, repo);
  if ("error" in listing) {
    return refuse7(`claude agents failed on the second look, so remove deleted nothing: ${listing.error}`);
  }
  const now = listWorktrees(env.runGit, repo.top);
  if ("issue" in now) {
    return refuse7(`git worktree list failed, so remove deleted nothing: ${now.issue}`);
  }
  const entry = now.worktrees.find((e) => samePath(e.path, checked2.entry.path));
  if (entry === undefined) {
    return refuse7(`git no longer lists ${checked2.entry.path}, so remove deleted nothing`);
  }
  const moved = movedLines(entry, checked2.head, "so remove deleted nothing");
  if (moved.length > 0)
    return refuse7(...moved);
  const lock = lockStateOf(entry.locked, env.isAlive);
  const one = { ...src, repo: alone(repo, entry) };
  const state = stateOf3(one, env.runGit, entry, lock);
  const kept = stateLines(state, entry, skipListPath(repo.commonDir));
  if (kept.length > 0)
    return refuse7(...kept);
  return listing.rows;
}

// bin/helpers/worktree-remove.ts
function exitedSessions(rows, worktree) {
  return rows.flatMap((row2) => {
    const exited = row2.kind === "background" && !isCurrent(row2);
    const atTop = row2.cwd !== undefined && samePath(row2.cwd, worktree);
    return exited && atTop && row2.id !== undefined ? [row2.id] : [];
  });
}
function removeSessions(env, top, ids, out) {
  const removed = [];
  for (const id of ids) {
    const result = env.runClaude(["rm", id], { cwd: top, timeoutMs: NO_LIMIT });
    const said = saidRemoved(result);
    if (said)
      removed.push(id);
    const lines = said ? [`session ${id} removed`] : withText(`claude rm ${id} did not say removed, so remove goes on with git's own removal`, result);
    for (const line of lines)
      out(line);
  }
  return removed;
}
function enclosingWorktree(repo, worktree) {
  return repo.worktrees.slice(1).find((other) => !samePath(other.path, worktree) && insideOf(worktree, other.path));
}
function endSessions(env, repo, worktree, rows, out) {
  const ids = exitedSessions(rows, worktree);
  const enclosing2 = enclosingWorktree(repo, worktree);
  if (enclosing2 === undefined)
    return removeSessions(env, repo.top, ids, out);
  for (const id of ids) {
    out(`claude rm ${id} skipped: ${worktree} sits inside the worktree ${enclosing2.path}, which claude rm might remove too, so session ${id} stays listed in claude agents`);
  }
  return [];
}
function removeListed(env, repo, checked2) {
  const { top } = repo;
  const now = listWorktrees(env.runGit, top);
  if ("issue" in now)
    return [`git worktree list failed: ${now.issue}`];
  const entry = now.worktrees.find((e) => samePath(e.path, checked2.entry.path));
  if (entry === undefined)
    return [];
  const moved = movedLines(entry, checked2.head, KEPT_WORKTREE);
  if (moved.length > 0)
    return moved;
  const disk = diskState(env.runGit, repo, entry);
  const skipList = skipListPath(repo.commonDir);
  const dirty = stateLines(disk, entry, skipList, KEPT_WORKTREE);
  if (dirty.length > 0)
    return dirty;
  const reason7 = lockReasonOf(env.runGit, top, entry.path);
  const lock = lockStateOf(reason7, env.isAlive);
  const issues = removeGitWorktree(env.runGit, top, entry.path, lock);
  if (issues.length === 0)
    return [];
  return [...issues, "fix what git names, then run remove again"];
}
function settleBranch(env, top, checked2, out) {
  const { plan, name, head } = checked2;
  switch (plan.kind) {
    case "detached":
      return [];
    case "keep":
      out(`branch ${plan.branch} kept: remove deletes only ${nativeBranch(name)} or a branch sidekick worktree move made for this worktree`);
      return [];
    case "delete": {
      const issues = branchGoneIssues(env.runGit, top, plan.branch, head);
      if (issues.length > 0) {
        return [
          ...issues,
          `the worktree is gone, and the branch ${plan.branch} stays as it is`
        ];
      }
      out(`branch ${plan.branch} removed`);
      return [];
    }
    default: {
      const _exhaustive = plan;
      throw new Error(`Unhandled plan: ${JSON.stringify(_exhaustive)}`);
    }
  }
}
function removeChecked(env, repo, checked2, out) {
  const rows = recheck(env, repo, checked2);
  if ("refused" in rows)
    return rows.refused;
  const { entry } = checked2;
  const ended = endSessions(env, repo, entry.path, rows, out);
  const worktree = removeListed(env, repo, checked2);
  if (worktree.length > 0)
    return [...worktree, ...endedLines(ended)];
  out(`worktree ${entry.path} removed`);
  return settleBranch(env, repo.top, checked2, out);
}
function endedLines(ids) {
  if (ids.length === 0)
    return [];
  const sessions = `${ids.length === 1 ? "session" : "sessions"} ${ids.join(", ")}`;
  return [
    `claude rm removed ${sessions} before this; remove itself deleted no worktree and no branch`
  ];
}
var RESTORED = "restored-";
function restoreBranch(env, top, checked2) {
  if (checked2.plan.kind === "delete")
    return checked2.plan.branch;
  const segment = refSegment(checked2.name);
  const check2 = env.runGit("git", ["check-ref-format", "--branch", segment], top);
  return check2.code === 0 ? segment : `${RESTORED}${segment}`;
}
var restoreLine = (branch, checked2) => `restore with: git branch ${shellArg(branch)} ${shellArg(checked2.plan.ref)}`;
var fail2 = (lines, err) => {
  for (const line of lines)
    err(line);
  return 1;
};
function removeWorktree(args, env, out, err) {
  const repo = repoOf2(env, err);
  if (repo === undefined)
    return 1;
  const checked2 = checkTarget(args, env, repo, out);
  if ("refused" in checked2)
    return fail2(checked2.refused, err);
  const { head } = checked2;
  const { ref: ref2 } = checked2.plan;
  const kept = writeBackup(env.runGit, repo.top, ref2, head);
  if (kept.length > 0)
    return fail2([...kept, "so remove deleted nothing"], err);
  const issues = removeChecked(env, repo, checked2, out);
  if (issues.length > 0) {
    return fail2([...issues, `the backup ref ${ref2} keeps ${head}`], err);
  }
  out(restoreLine(restoreBranch(env, repo.top, checked2), checked2));
  return 0;
}

// bin/helpers/worktree.ts
var WORKTREE_USAGE_LINE = "sidekick worktree list | move <branch> [--from <base>] | move --pr <n> | remove <name|path> [--into <target>] [--discard]";
var SEPARATOR3 = " · ";
var BACKUP_REFS = "refs/sidekick";
var REMOVE_HINT = "remove one with: sidekick worktree remove <name>";
var usage3 = (err) => {
  err(`usage: ${WORKTREE_USAGE_LINE}`);
  return 1;
};
function stateWords(state) {
  switch (state.kind) {
    case "held":
      return heldWords(state.by);
    case "worker":
      return "a worker's: sidekick worker finish";
    case "folder gone":
      return "folder gone";
    case "dirty":
      return `dirty: ${state.paths.join(", ")}${omittedWords(state.omitted)}`;
    case "removable":
      return "removable";
    default: {
      const _exhaustive = state;
      throw new Error(`Unhandled state: ${JSON.stringify(_exhaustive)}`);
    }
  }
}
function commitsWords(commits) {
  switch (commits.kind) {
    case "landed":
      return `landed in ${commits.in}`;
    case "pushed":
      return `pushed to ${commits.on}`;
    case "only here":
      return `only here, ${commits.count} ${commits.count === 1 ? "commit" : "commits"}`;
    case "unknown":
      return `commits unknown: ${commits.why}`;
    default: {
      const _exhaustive = commits;
      throw new Error(`Unhandled commits: ${JSON.stringify(_exhaustive)}`);
    }
  }
}
function rowLine(row2) {
  const fields = [row2.name, stateWords(row2.state)];
  if (row2.commits !== undefined)
    fields.push(commitsWords(row2.commits));
  fields.push(row2.entry.branch?.replace(HEADS, "") ?? "detached");
  fields.push(row2.entry.path);
  return fields.join(SEPARATOR3);
}
function mainUseWords(use) {
  switch (use.kind) {
    case "free":
      return "free";
    case "in use":
      return `in use by ${use.by.join(", ")}`;
    case "unknown":
      return `unknown: ${use.why}`;
    default: {
      const _exhaustive = use;
      throw new Error(`Unhandled use: ${JSON.stringify(_exhaustive)}`);
    }
  }
}
function mainCheckoutLine(main, use) {
  return [
    "main checkout",
    mainUseWords(use),
    main.branch?.replace(HEADS, "") ?? "detached",
    main.path
  ].join(SEPARATOR3);
}
function backupRefLines(runGit, top) {
  const refs = runGit("git", ["for-each-ref", "--format=%(refname) %(committerdate:short)", BACKUP_REFS], top);
  if (refs.code !== 0) {
    return { issue: `git for-each-ref failed: ${refs.stderr.trim()}` };
  }
  const lines = refs.stdout.split(`
`).filter((line) => line.trim() !== "");
  if (lines.length === 0)
    return [];
  const entries = lines.map((line) => {
    const space = line.lastIndexOf(" ");
    return `${line.slice(0, space)}${SEPARATOR3}commit dated ${line.slice(space + 1)}`;
  });
  return ["backup refs:", ...entries];
}
var UNCONFIRMED = "so every worktree that would otherwise read folder gone, dirty, or removable reads held, unknown";
function listingWarnings(listing) {
  if ("error" in listing) {
    return [`claude agents failed, ${UNCONFIRMED}: ${listing.error}`];
  }
  return listing.warnings.map((warning) => `claude agents gave a partial listing, ${UNCONFIRMED}: ${warning}`);
}
var listVerb = (rest2, env, out, err) => {
  if (rest2.length > 0)
    return usage3(err);
  const repo = repoOf2(env, err);
  if (repo === undefined)
    return 1;
  const { src, listing, skipWarnings } = readSources(env, repo);
  const warnings = [
    ...listingWarnings(listing),
    ...skipWarnings,
    ...src.unreadRecords
  ];
  for (const warning of warnings)
    out(warning);
  out(mainCheckoutLine(repo.worktrees[0], mainCheckoutUse(src)));
  const rows = worktreeRows(src, env.runGit);
  if (rows.length === 0)
    out("no linked worktrees");
  for (const row2 of rows)
    out(rowLine(row2));
  const goes = rows.some((row2) => row2.state.kind === "removable" || row2.state.kind === "folder gone");
  if (goes)
    out(REMOVE_HINT);
  const backups = backupRefLines(env.runGit, repo.top);
  if ("issue" in backups) {
    err(backups.issue);
    return 1;
  }
  for (const line of backups)
    out(line);
  return 0;
};
var moveVerb = (rest2, env, out, err) => {
  const args = parseMoveArgs(rest2);
  if (args === undefined)
    return usage3(err);
  return moveWorktree(args, env, out, err);
};
var removeVerb = (rest2, env, out, err) => {
  const args = parseRemoveArgs(rest2);
  if (args === undefined)
    return usage3(err);
  return removeWorktree(args, env, out, err);
};
var VERBS5 = {
  list: listVerb,
  move: moveVerb,
  remove: removeVerb
};
function runWorktreeCli(rest2, env, out, err) {
  const [name, ...args] = rest2;
  if (name === undefined || !Object.hasOwn(VERBS5, name))
    return usage3(err);
  return VERBS5[name](args, env, out, err);
}

// bin/cli.ts
function resolvePluginDir(entryFileUrl) {
  const here = path51.dirname(fileURLToPath(entryFileUrl));
  const candidates3 = [
    path51.resolve(here, ".."),
    path51.resolve(here, "..", "plugin")
  ];
  for (const c of candidates3) {
    if (fs39.existsSync(path51.join(c, "rules")))
      return c;
  }
  return candidates3[0];
}
var ManifestVersion = object({ version: string() });
function readVersion(pluginDir) {
  const manifest = path51.join(pluginDir, ".claude-plugin", "plugin.json");
  try {
    const parsed = safeParse(ManifestVersion, JSON.parse(fs39.readFileSync(manifest, "utf-8")));
    return parsed.success ? parsed.output.version : "unknown";
  } catch {
    return "unknown";
  }
}
function isMainEntrypoint(importMetaUrl, argv1) {
  if (!argv1)
    return false;
  try {
    return realpathSync10(fileURLToPath(importMetaUrl)) === realpathSync10(argv1);
  } catch {
    return false;
  }
}
var USAGE2 = `usage: sidekick rules <install|check> --project|--user [--strict]
       ${PM_USAGE_LINE}
       ${HOOK_USAGE_LINE}
       ${PROFILE_USAGE_LINE}
       ${WORKER_USAGE_LINE}
       ${WORKTREE_USAGE_LINE}
       ${DESK_USAGE_LINE}
       ${SESSION_USAGE_LINE}
       ${MEMORY_USAGE_LINE}
       sidekick --version`;
function writeStdout(chunk) {
  const buffer = Buffer.from(chunk);
  for (let offset = 0;offset < buffer.length; ) {
    try {
      offset += fs39.writeSync(1, buffer, offset);
    } catch (e) {
      if (!(e instanceof Error && ("code" in e) && e.code === "EAGAIN"))
        throw e;
    }
  }
}
var profileEnvOf = (ctx) => ({
  env: ctx.env,
  cwd: ctx.cwd,
  home: ctx.env.HOME || os3.homedir(),
  workTree: workTreeRootOf(ctx.cwd),
  tmpdir: ctx.tmpdir ?? os3.tmpdir(),
  runClaude: ctx.runClaude ?? execClaude,
  write: ctx.write ?? writeStdout
});
function readProcessStdin() {
  try {
    return fs39.readFileSync(0, "utf-8");
  } catch {
    return "";
  }
}
function main(argv2, ctx, out, err) {
  const [sub, ...rest2] = argv2;
  const pluginDir = resolvePluginDir(ctx.entryFileUrl);
  if (sub === "--version") {
    out(readVersion(pluginDir));
    return 0;
  }
  if (sub === "pm")
    return runPmCli(rest2, { cwd: ctx.cwd }, out, err);
  if (sub === "hook") {
    const readStdin = ctx.readStdin ?? readProcessStdin;
    return runHookCli(rest2, { readStdin, pluginDir, env: ctx.env, tmpdir: ctx.tmpdir ?? os3.tmpdir() }, out, err);
  }
  if (sub === "profile") {
    return runProfileCli(rest2, profileEnvOf(ctx), out, err);
  }
  if (sub === "worker") {
    return runWorkerCli(rest2, {
      ...profileEnvOf(ctx),
      runGit: execRunner,
      sleep: sleepSync,
      isAlive: processIsAlive
    }, out, err);
  }
  if (sub === "worktree") {
    return runWorktreeCli(rest2, {
      cwd: ctx.cwd,
      runGit: execRunner,
      runClaude: ctx.runClaude ?? execClaude,
      isAlive: processIsAlive,
      env: ctx.env
    }, out, err);
  }
  if (sub === "desk") {
    return runDeskCli(rest2, {
      cwd: ctx.cwd,
      configDir: configDirOf(ctx.env),
      runClaude: ctx.runClaude ?? execClaude,
      runGit: execRunner,
      isAlive: processIsAlive,
      now: Date.now
    }, out, err);
  }
  if (sub === "session") {
    return runSessionCli(rest2, {
      cwd: ctx.cwd,
      configDir: configDirOf(ctx.env),
      runClaude: ctx.runClaude ?? execClaude
    }, out, err);
  }
  if (sub === "memory") {
    return runMemoryCli(rest2, {
      env: ctx.env,
      cwd: ctx.cwd,
      home: ctx.env.HOME || os3.homedir(),
      runClaude: ctx.runClaude ?? execClaude
    }, out, err);
  }
  if (sub !== "rules") {
    err(USAGE2);
    return 1;
  }
  const claudeHome = configDirOf(ctx.env);
  const src = ctx.env.SIDEKICK_RULES_DIR || path51.join(pluginDir, "rules");
  return runRulesCli(rest2, { src, cwd: ctx.cwd, claudeHome }, out);
}
var _importMetaMain = "main" in import.meta && typeof __require.main == __require.module === "boolean" ? __require.main == __require.module : undefined;
var _isEntry = _importMetaMain ?? isMainEntrypoint(import.meta.url, process.argv[1]);
if (_isEntry) {
  process.exit(main(process.argv.slice(2), { env: process.env, cwd: process.cwd(), entryFileUrl: import.meta.url }, (l) => console.log(l), (l) => console.error(l)));
}
export {
  resolvePluginDir,
  readVersion,
  main,
  isMainEntrypoint,
  USAGE2 as USAGE
};

