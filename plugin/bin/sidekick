    description: m.description ?? "",
    due_on: m.due_on,
    open_issues: m.open_issues,
    closed_issues: m.closed_issues,
    state: m.state,
    created_at: m.created_at
  }));
}
function fetchMilestones(run, cwd, owner, repo, state) {
  return parseMilestones(rest(run, cwd, [
    "api",
    `repos/${owner}/${repo}/milestones?state=${state}&per_page=100`
  ]));
}
var CliIssues = array(object({
  number: number(),
  title: string(),
  labels: array(object({ name: string() })),
  body: string(),
  milestone: nullable(object({ title: string() })),
  updatedAt: string()
}));
function parseIssues(json) {
  const list = checked(CliIssues, JSON.parse(json), "issue list");
  if (list.length >= ISSUE_LIMIT) {
    throw new PmError(1, `gh issue list returned ${list.length} issues, the limit; refusing to reason over a truncated list`);
  }
  return list.map((i) => ({
    number: i.number,
    title: i.title,
    labels: i.labels.map((l) => l.name),
    body: i.body,
    milestone: i.milestone?.title ?? null,
    updatedAt: i.updatedAt
  }));
}
function fetchOpenIssues(run, cwd, owner, repo) {
  return parseIssues(rest(run, cwd, [
    "issue",
    "list",
    "-R",
    `${owner}/${repo}`,
    "--state",
    "open",
    "--limit",
    String(ISSUE_LIMIT),
    "--json",
    "number,title,labels,body,milestone,updatedAt"
  ]));
}

// bin/helpers/pm-lint.ts
var LINT_IDS = [
  "area_label_count",
  "no_status",
  "open_in_done",
  "completed_not_done",
  "backlog_without_condition",
  "backlog_in_milestone",
  "position_code_title",
  "cites_working_file",
  "unboarded",
  "stale_in_progress",
  "multiple_linked_boards"
];
var REVISIT_MARKER = /^\s*(?:[-*+][ \t]+)?(?:(\*\*|__|\*|_)revisit when(?::\1|\1:)|revisit when:)/im;
var POSITION_CODE = [
  /^\s*\d+(\.\d+)+\s*[—–-]/,
  /^\s*(bench|wave|step|phase)[- ]?\d+\b/i
];
var f = (number2, title, detail) => ({
  number: number2,
  title,
  detail
});
var open = (items) => items.filter((i) => i.state === "OPEN");
function areaLabelCount(issues) {
  return issues.map((i) => ({
    i,
    n: i.labels.filter((l) => l.startsWith("area:")).length
  })).filter(({ n }) => n !== 1).map(({ i, n }) => f(i.number, i.title, `${n} area:* labels`));
}
function noStatus(items) {
  return open(items).filter((i) => i.status === null).map((i) => f(i.number, i.title, "card has no Status"));
}
function openInDone(items) {
  return open(items).filter((i) => i.status === "Done").map((i) => f(i.number, i.title, "open issue carded Done"));
}
function completedNotDone(items) {
  return items.filter((i) => i.state === "CLOSED" && i.stateReason === "COMPLETED" && i.status !== "Done").map((i) => f(i.number, i.title, `closed as completed, card is ${i.status ?? "unset"}`));
}
function backlogWithoutCondition(issues) {
  return issues.filter((i) => i.labels.includes("backlog") && !REVISIT_MARKER.test(i.body)).map((i) => f(i.number, i.title, 'backlog label without a "Revisit when:" line'));
}
var WORKING_FILE_PATH = /\bdocs\/superpowers\b/;
function citesWorkingFile(issues) {
  return issues.filter((i) => WORKING_FILE_PATH.test(i.body)).map((i) => f(i.number, i.title, "body names docs/superpowers/, where working files live"));
}
function backlogInMilestone(issues) {
  return issues.filter((i) => i.labels.includes("backlog") && i.milestone !== null).map((i) => f(i.number, i.title, `deferred but in milestone ${i.milestone}`));
}
function positionCodeTitle(issues) {
  return issues.filter((i) => POSITION_CODE.some((re) => re.test(i.title))).map((i) => f(i.number, i.title, "title starts with a position code"));
}
function unboarded(uncarded, boardCreatedAt) {
  const since = Date.parse(boardCreatedAt);
  return uncarded.filter((i) => i.state === "OPEN" || i.stateReason === "COMPLETED" && i.closedAt !== null && Date.parse(i.closedAt) > since).map((i) => f(i.number, i.title, i.state === "CLOSED" ? "closed as completed, no card on the board" : i.cardArchived ? "card archived" : "no card on the board"));
}
function staleInProgress(items, now) {
  return open(items).filter((i) => i.status === "In Progress" && ageDays(touchedAt(i), now) > STALE_DAYS).map((i) => f(i.number, i.title, `In Progress, untouched ${ageDays(touchedAt(i), now)} days`));
}
function multipleLinkedBoards(candidates) {
  if (candidates.length <= 1)
    return [];
  const names = candidates.map((b) => `#${b.number}`).join(", ");
  return [
    f(null, "linked boards", `${candidates.length} open boards match: ${names}`)
  ];
}
var PREDICATES = {
  area_label_count: ({ issues }) => areaLabelCount(issues),
  no_status: ({ items }) => noStatus(items),
  open_in_done: ({ items }) => openInDone(items),
  completed_not_done: ({ items }) => completedNotDone(items),
  backlog_without_condition: ({ issues }) => backlogWithoutCondition(issues),
  backlog_in_milestone: ({ issues }) => backlogInMilestone(issues),
  position_code_title: ({ issues }) => positionCodeTitle(issues),
  cites_working_file: ({ issues }) => citesWorkingFile(issues),
  unboarded: ({ uncarded, boardCreatedAt }) => unboarded(uncarded, boardCreatedAt),
  stale_in_progress: ({ items, now }) => staleInProgress(items, now),
  multiple_linked_boards: ({ candidates }) => multipleLinkedBoards(candidates)
};
function lintAll(input) {
  const entries = LINT_IDS.map((id) => [id, PREDICATES[id](input)]);
  const findings = Object.fromEntries(entries);
  const counts = Object.fromEntries(entries.map(([id, list]) => [id, list.length]));
  return { findings, counts };
}

// bin/helpers/pm-report.ts
var STATE_CELL = {
  done: "done",
  running: "running",
  next: "next",
  later: ""
};
var cell = (text) => text.replaceAll("|", "\\|");
function row(plan, ref2) {
  const closed = plan.issues.filter((i) => !i.open).length;
  const issues = plan.issues.map((i) => ref2(i.number)).join(" ");
  return `| ${STATE_CELL[plan.state]} | ${cell(plan.name)} | ${closed} of ${plan.issues.length} | ${issues} |`;
}
function renderReport(r) {
  const ref2 = (n) => `${r.board.owner}/${r.board.repo}#${n}`;
  const running = r.plans.list.filter((p) => p.state === "running").map((p) => `**${p.name}**`);
  const unplanned = r.plans.unplanned.map((i) => ref2(i.number));
  return [
    `**${r.milestone.title}** · ${r.issue_counts.open} open, ${r.issue_counts.closed} closed`,
    `Running: ${running.length > 0 ? running.join(", ") : "none"}`,
    "",
    "| | Plan | Closed | Issues |",
    "|---|---|---|---|",
    ...r.plans.list.map((p) => row(p, ref2)),
    "",
    `Unplanned: ${unplanned.length > 0 ? unplanned.join(", ") : "none"}.`
  ].join(`
`);
}

// bin/helpers/rules.ts
import { execFileSync } from "node:child_process";
import * as fs5 from "node:fs";
import * as path5 from "node:path";

// bin/helpers/rules-fs.ts
import * as fs3 from "node:fs";
import * as path3 from "node:path";
var isOwnedRule = (name) => name.startsWith("sk-") && name.endsWith(".md");
function statusOf(dir, name) {
  const st = fs3.lstatSync(path3.join(dir, name), { throwIfNoEntry: false });
  if (!st)
    return "absent";
  return st.isFile() ? "file" : "other";
}
var isRegularFile = (dir, name) => statusOf(dir, name) === "file";
function ownedRulesIn(dir) {
  const dirStat = fs3.statSync(dir, { throwIfNoEntry: false });
  if (!dirStat)
    return [];
  if (!dirStat.isDirectory())
    return [];
  return fs3.readdirSync(dir).filter((n) => isOwnedRule(n) && isRegularFile(dir, n)).sort();
}

// bin/helpers/rules-overlap.ts
import * as fs4 from "node:fs";
import * as path4 from "node:path";
var MIN_SHARED_HEADINGS = 2;
var normalise2 = (s) => s.toLowerCase().replace(/[`*_]/g, "").replace(/[.:;!?]+$/, "").trim();
function headingsOf(body) {
  return body.split(`
`).filter((l) => l.startsWith("## ")).map((l) => normalise2(l.slice(3)));
}
function openingOf(body) {
  let lines = body.split(`
`);
  if (lines[0] === "---") {
    const end = lines.indexOf("---", 1);
    lines = end === -1 ? [] : lines.slice(end + 1);
  }
  const first = lines.find((l) => l.trim() !== "" && !l.startsWith("#"));
  if (!first)
    return;
  const sentence = first.split(/\.\s|\.$/)[0];
  const value = normalise2(sentence);
  return value === "" ? undefined : value;
}
function signalsFor(file, body, rule) {
  const signals = [];
  if (file === rule.name.slice("sk-".length))
    signals.push("name");
  const shared = new Set(headingsOf(body).filter((h) => rule.headings.has(h))).size;
  if (shared >= MIN_SHARED_HEADINGS)
    signals.push({ headings: shared });
  const opening = openingOf(body);
  if (opening !== undefined && opening === rule.opening) {
    signals.push({ opening });
  }
  return signals;
}
function findOverlap(src, dest) {
  const report = { pairs: [], extensions: [] };
  const destStat = fs4.statSync(dest, { throwIfNoEntry: false });
  if (!destStat?.isDirectory())
    return report;
  const rules = ownedRulesIn(src).map((name) => {
    const body = fs4.readFileSync(path4.join(src, name), "utf-8");
    return {
      name,
      headings: new Set(headingsOf(body)),
      opening: openingOf(body)
    };
  });
  const others = fs4.readdirSync(dest).filter((n) => n.endsWith(".md") && !isOwnedRule(n) && isRegularFile(dest, n)).sort();
  for (const file of others) {
    const body = fs4.readFileSync(path4.join(dest, file), "utf-8");
    for (const rule of rules) {
      const signals = signalsFor(file, body, rule);
      if (signals.length === 0)
        continue;
      if (body.includes(rule.name)) {
        report.extensions.push({ file, rule: rule.name });
      } else {
        report.pairs.push({ file, rule: rule.name, signals });
      }
    }
  }
  return report;
}
function describeSignal(signal) {
  if (signal === "name")
    return "name";
  if ("headings" in signal)
    return `${signal.headings} headings`;
  return "opening";
}
function formatOverlap(report) {
  const lines = [];
  if (report.pairs.length === 0) {
    lines.push("no overlap found (checked file names, two or more shared H2 headings, and the opening sentence against non-sk-*.md files)");
  } else {
    for (const p of report.pairs) {
      lines.push(`${p.file} overlaps ${p.rule} on ${p.signals.map(describeSignal).join(", ")}`);
    }
    lines.push("overlap is reported only; sidekick never edits files it does not own. If a repo file extends or departs from its pair on purpose, name the sk rule in it and the pair moves to the stated extensions");
  }
  if (report.extensions.length > 0) {
    lines.push(`stated extensions, not reported: ${report.extensions.map((e) => `${e.file} → ${e.rule}`).join(", ")}`);
  }
  return lines;
}

// bin/helpers/rules.ts
function resolveDest(scope, cwd, claudeHome) {
  return scope === "project" ? path5.join(cwd, ".claude", "rules") : path5.join(claudeHome, "rules");
}
function workTreeRootOf(cwd) {
  try {
    return execFileSync("git", ["rev-parse", "--show-toplevel"], {
      cwd,
      encoding: "utf-8",
      stdio: ["ignore", "pipe", "ignore"]
    }).trim();
  } catch {
    return;
  }
}
var repoRootOf = (cwd) => workTreeRootOf(cwd) ?? cwd;
var PLUGIN_ONLY_RULES = ["sk-pm-conventions.md"];
var isRecord3 = (v) => typeof v === "object" && v !== null && !Array.isArray(v);
var errorText = (e) => e instanceof Error ? e.message : String(e);
function pluginEnablement(root) {
  const file = path5.join(root, ".claude", "settings.json");
  let text;
  try {
    text = fs5.readFileSync(file, "utf-8");
  } catch (e) {
    if (e instanceof Error && "code" in e && e.code === "ENOENT") {
      return { state: "not-enabled" };
    }
    return { state: "unreadable", path: file, reason: errorText(e) };
  }
  if (text.trim() === "")
    return { state: "not-enabled" };
  let parsed;
  try {
    parsed = JSON.parse(text);
  } catch (e) {
    return { state: "unreadable", path: file, reason: errorText(e) };
  }
  if (!isRecord3(parsed)) {
    return { state: "unreadable", path: file, reason: "not a JSON object" };
  }
  const plugins = parsed.enabledPlugins;
  const enabled = isRecord3(plugins) && Object.entries(plugins).some(([key, on]) => key.startsWith("sidekick@") && on === true);
  return { state: enabled ? "enabled" : "not-enabled" };
}
var EVERY_RULE = { leaveOut: [], leaveAsIs: [] };
function projectSet(e) {
  switch (e.state) {
    case "enabled":
      return EVERY_RULE;
    case "not-enabled":
      return { leaveOut: PLUGIN_ONLY_RULES, leaveAsIs: [] };
    case "unreadable":
      return { leaveOut: [], leaveAsIs: PLUGIN_ONLY_RULES };
    default: {
      const _exhaustive = e;
      throw new Error(`unhandled enablement: ${JSON.stringify(_exhaustive)}`);
    }
  }
}
var shippedOnly = (set, shipped) => ({
  leaveOut: set.leaveOut.filter((n) => shipped.includes(n)),
  leaveAsIs: set.leaveAsIs.filter((n) => shipped.includes(n))
});
var expectedRules = (shipped, set) => shipped.filter((n) => !set.leaveOut.includes(n) && !set.leaveAsIs.includes(n));
function installRules(src, dest, scope = EVERY_RULE) {
  const shipped = ownedRulesIn(src);
  if (shipped.length === 0) {
    return { installed: [], removed: [], leftOut: [], skipped: [] };
  }
  const set = shippedOnly(scope, shipped);
  fs5.mkdirSync(dest, { recursive: true });
  const byLowerCase = new Map;
  for (const existing of fs5.readdirSync(dest)) {
    byLowerCase.set(existing.toLowerCase(), existing);
  }
  const installed = [];
  const skipped = [];
  for (const name of expectedRules(shipped, set)) {
    const onDisk = byLowerCase.get(name.toLowerCase());
    if (onDisk !== undefined && onDisk !== name) {
      skipped.push({ name, why: "case-collision" });
      continue;
    }
    if (statusOf(dest, name) === "other") {
      skipped.push({ name, why: "not-a-regular-file" });
      continue;
    }
    fs5.copyFileSync(path5.join(src, name), path5.join(dest, name));
    installed.push(name);
  }
  const keep = new Set(shipped);
  const owned = ownedRulesIn(dest);
  const removed = owned.filter((n) => !keep.has(n));
  const leftOut = owned.filter((n) => set.leaveOut.includes(n));
  for (const name of [...removed, ...leftOut]) {
    fs5.rmSync(path5.join(dest, name));
  }
  return { installed, removed, leftOut, skipped };
}
function checkRules(src, dest, scope = EVERY_RULE) {
  const shipped = ownedRulesIn(src);
  const set = shippedOnly(scope, shipped);
  const expected = expectedRules(shipped, set);
  const installed = ownedRulesIn(dest);
  const drift = [];
  for (const name of expected) {
    const there = path5.join(dest, name);
    if (!fs5.existsSync(there)) {
      drift.push({ kind: "missing", name });
      continue;
    }
    const same = fs5.readFileSync(path5.join(src, name)).equals(fs5.readFileSync(there));
    if (!same)
      drift.push({ kind: "stale", name });
  }
  const known = new Set(expected);
  for (const name of installed) {
    if (!known.has(name) && !set.leaveAsIs.includes(name)) {
      drift.push({ kind: "orphaned", name });
    }
  }
  return drift;
}
var USAGE = `usage: sidekick rules <install|check> --project|--user [--strict]
` + `  --project  the current repo's .claude/rules/
` + `  --user     the user-level rules directory under the Claude config dir
` + `  --strict   exit 1 when drift or a skipped write is found
` + "exit: 0 ran, whatever it found; 1 could not run, or --strict found drift";
var FLAGS = ["--project", "--user", "--strict"];
function parseArgs(args) {
  const [verb, ...flags] = args;
  if (verb !== "install" && verb !== "check")
    return;
  if (flags.some((f2) => !FLAGS.includes(f2)))
    return;
  const project = flags.includes("--project");
  const user = flags.includes("--user");
  if (project === user)
    return;
  return {
    verb,
    scope: project ? "project" : "user",
    strict: flags.includes("--strict")
  };
}
function scopeSet(scope, root) {
  if (scope === "user")
    return { set: EVERY_RULE, notes: [] };
  const enablement = pluginEnablement(root);
  const set = projectSet(enablement);
  const notes = [];
  if (set.leaveOut.length > 0) {
    notes.push(`not delivered to this repo: ${set.leaveOut.join(", ")}; its .claude/settings.json does not enable sidekick, so it comes from user level only`);
  }
  if (set.leaveAsIs.length > 0 && enablement.state === "unreadable") {
    notes.push(`left ${set.leaveAsIs.join(", ")} as it is: could not read ${enablement.path} (${enablement.reason})`);
  }
  return { set, notes };
}
var deliveryMode = (projectDest) => ownedRulesIn(projectDest).length > 0 ? "project" : "user";
var realOrSelf = (p) => {
  try {
    return fs5.realpathSync(p);
  } catch {
    return path5.resolve(p);
  }
};
var sameDir = (a, b) => realOrSelf(a) === realOrSelf(b);
function pickChecked(scope, verb, t, src, out) {
  if (scope === "user" || verb === "install" || deliveryMode(t.dest) === "project") {
    return { dest: t.dest, set: t.set };
  }
  out(`no sk-* rules in ${t.dest}; checking the user-level copies at ${t.userDest} against ${src}`);
  return { dest: t.userDest, set: EVERY_RULE };
}
function sharedNames(expected, projectDest, userDest) {
  const project = new Set(ownedRulesIn(projectDest));
  const user = new Set(ownedRulesIn(userDest));
  return expected.filter((n) => project.has(n) && user.has(n)).length;
}
function reportDuplicates(expected, dest, userDest, out) {
  if (sameDir(dest, userDest))
    return;
  const shared = sharedNames(expected, dest, userDest);
  if (shared === 0)
    return;
  out(`your user-level rules at ${userDest} also deliver ${shared} of these; Claude Code loads both copies here, which is expected where the repo keeps copies for colleagues without sidekick`);
}
function refuseNonDirectory(dir, out) {
  const st = fs5.statSync(dir, { throwIfNoEntry: false });
  if (!st || st.isDirectory())
    return false;
  out(`${dir} exists and is not a directory; refusing to write rules there`);
  return true;
}
function reportInstall(result, dest, out) {
  out(`installed ${result.installed.length} rule(s) into ${dest}: ${result.installed.join(", ")}`);
  if (result.removed.length > 0) {
    out(`removed retired: ${result.removed.join(", ")}`);
  }
  if (result.leftOut.length > 0) {
    out(`removed: ${result.leftOut.join(", ")} (not delivered to this repo)`);
  }
  for (const s of result.skipped)
    out(`[skipped:${s.why}] ${s.name}`);
}
function runRulesCli(args, env, out) {
  const parsed = parseArgs(args);
  if (parsed === undefined) {
    out(USAGE);
    return 1;
  }
  const { verb, scope, strict } = parsed;
  const root = scope === "project" ? repoRootOf(env.cwd) : env.cwd;
  if (scope === "project")
    out(`project root: ${root}`);
  const dest = resolveDest(scope, root, env.claudeHome);
  if (ownedRulesIn(env.src).length === 0) {
    out(`no sk-*.md rules found at ${env.src}; refusing to touch ${dest}`);
    return 1;
  }
  if (refuseNonDirectory(dest, out))
    return 1;
  const { set, notes } = scopeSet(scope, root);
  let skipped = [];
  if (verb === "install") {
    const result = installRules(env.src, dest, set);
    skipped = result.skipped;
    reportInstall(result, dest, out);
  }
  for (const note of notes)
    out(note);
  const userDest = resolveDest("user", root, env.claudeHome);
  const checked2 = pickChecked(scope, verb, { dest, userDest, set }, env.src, out);
  if (checked2.dest !== dest && refuseNonDirectory(checked2.dest, out))
    return 1;
  const expected = expectedRules(ownedRulesIn(env.src), checked2.set);
  const drift = checkRules(env.src, checked2.dest, checked2.set);
  if (drift.length === 0) {
    out(`${expected.length} rule(s) match the shipped copies at ${checked2.dest}`);
  }
  for (const d of drift)
    out(`[${d.kind}] ${d.name}`);
  if (scope === "project" && checked2.dest === dest) {
    reportDuplicates(expected, dest, userDest, out);
  }
  for (const l of formatOverlap(findOverlap(env.src, dest)))
    out(l);
  const found = drift.length > 0 || skipped.length > 0;
  return strict && found ? 1 : 0;
}

// bin/helpers/pm.ts
var GH_MIN = "2.98.0";
function chooseBoard(boards, viewer, repo) {
  return boards.filter((b) => !b.closed && b.ownerLogin === viewer && b.title === repo).sort((a, b) => a.number - b.number);
}
function preflightOf(version) {
  const ok = version !== null && versionAtLeast(version, GH_MIN);
  const warnings = ok ? [] : [
    `gh ${version ?? "unknown"} < ${GH_MIN}: by-name item-edit unavailable; write by field and option id`
  ];
  return {
    gh_version: version,
    gh_min: GH_MIN,
    gh_ok: ok,
    project_scope: null,
    warnings
  };
}
function discover(run, cwd) {
  const gh = fetchGhVersion(run, cwd);
  if (!gh.found)
    throw new PmError(2, "gh not found on PATH");
  const root = repoRootOf(cwd);
  const preflight = preflightOf(gh.version);
  const untracked = (reason, fields = {}) => ({
    tracked: false,
    reason,
    owner: fields.owner ?? null,
    repo: fields.repo ?? null,
    project: null,
    status_field: null,
    linked: fields.linked ?? [],
    preflight,
    root
  });
  const origin = run("git", ["remote", "get-url", "origin"], root);
  if (origin.code !== 0)
    return untracked("no-origin");
  const parsed = parseOrigin(origin.stdout);
  if (!parsed)
    return untracked("not-github");
  const login = fetchLocalLogin(run, root);
  if (login === null) {
    return untracked("no-local-login", {
      owner: parsed.owner,
      repo: parsed.repo
    });
  }
  if (login !== parsed.owner) {
    return untracked("remote-owner-mismatch", {
      owner: parsed.owner,
      repo: parsed.repo
    });
  }
  preflight.project_scope = hasProjectScope(fetchScopeHeaders(run, root));
  if (!preflight.project_scope) {
    throw new PmError(2, "gh token lacks the 'project' scope; run: gh auth refresh -s project");
  }
  const d = fetchDiscovery(run, root, parsed.owner, parsed.repo);
  const chosen = chooseBoard(d.boards, d.viewer, parsed.repo);
  if (chosen.length === 0) {
    return untracked("no-board", {
      owner: parsed.owner,
      repo: parsed.repo,
      linked: d.boards
    });
  }
  const first = chosen[0];
  const f2 = fetchStatusField(run, root, d.viewer, first.number);
  return {
    tracked: true,
    reason: null,
    owner: parsed.owner,
    repo: parsed.repo,
    viewer: d.viewer,
    project: {
      number: first.number,
      id: f2.id,
      url: f2.url,
      title: f2.title,
      createdAt: f2.createdAt
    },
    status_field: f2.statusField,
    linked: d.boards,
    preflight,
    root
  };
}
var PM_USAGE_LINE = "sidekick pm <board|pickup|lint|gate> [--quiet] [--brief|--report] [--milestone <title>]";
var PM_USAGE = `usage: ${PM_USAGE_LINE}`;
var VERBS2 = new Set(["board", "pickup", "lint", "gate"]);
function milestoneFlag(args) {
  const at = args.findIndex((a) => a === "--milestone" || a.startsWith("--milestone="));
  if (at < 0)
    return { title: undefined, invalid: false };
  const title = args[at].startsWith("--milestone=") ? args[at].slice("--milestone=".length) : args[at + 1];
  const usable = title !== undefined && title !== "" && !title.startsWith("--");
  return usable ? { title, invalid: false } : { title: undefined, invalid: true };
}
function runPmCli(args, env, out, err) {
  const [verb, ...rest2] = args;
  if (!verb || !VERBS2.has(verb)) {
    err(PM_USAGE);
    return 1;
  }
  const run = env.run ?? execRunner;
  const brief = rest2.includes("--brief");
  const report = rest2.includes("--report");
  const quiet = rest2.includes("--quiet") || brief;
  const ms = milestoneFlag(rest2);
  const msTitle = ms.title;
  if (verb === "gate" && msTitle === undefined || ms.invalid || brief && report) {
    err(PM_USAGE);
    return 1;
  }
  const emit = (o) => out(JSON.stringify(o, null, 2));
  try {
    const info = discover(run, env.cwd);
    const { root: _root, ...shown } = info;
    if (!info.tracked) {
      if (report) {
        err(`not tracked: ${info.reason}`);
        return 1;
      }
      if (!quiet)
        emit(shown);
      return 0;
    }
    if (verb === "board") {
      emit(shown);
      return 0;
    }
    const now = env.now ?? new Date;
    const owner = info.owner;
    const repo = info.repo;
    const project = info.project;
    const fullName = `${owner}/${repo}`;
    const viewer = info.viewer;
    if (verb === "pickup") {
      const open2 = fetchMilestones(run, info.root, owner, repo, "open").sort((a, b) => a.number - b.number);
      const repoIssues = fetchRepoIssues(run, info.root, owner, repo, project.id);
      const items = cardedItems(repoIssues, fullName);
      const active = msTitle === undefined ? activeMilestone(open2, items) : namedMilestone(open2, msTitle);
      const plans = active ? planView(active, items) : null;
      const issueCounts = active ? milestoneCounts(repoIssues, active.title) : null;
      if (report) {
        return emitReport({
          board: { owner, repo },
          open: open2,
          milestone: active,
          issue_counts: issueCounts,
          plans
        }, out, err);
      }
      const t = tiers(items, active, now);
      const working = inProgressMilestones(open2, items);
      const split = working.length > 1 ? working.map((m) => m.title) : [];
      const pickup = {
        board: shown,
        milestone: active,
        issue_counts: issueCounts,
        open_milestones: open2.map((m) => ({
          number: m.number,
          title: m.title
        })),
        in_progress: t.in_progress,
        candidates: t.candidates,
        order_basis: "number",
        plans,
        drift: drift(run, info.root, t.in_progress, split)
      };
      if (brief)
        out(renderBrief({ ...pickup, board: { owner, repo, project } }));
      else
        emit(pickup);
      return 0;
    }
    if (verb === "lint") {
      const issues = fetchOpenIssues(run, info.root, owner, repo);
      const repoIssues = fetchRepoIssues(run, info.root, owner, repo, project.id);
      const items = cardedItems(repoIssues, fullName);
      const uncarded = repoIssues.filter((i) => i.card === null);
      const candidates = chooseBoard(info.linked, viewer, repo);
      const r = lintAll({
        issues,
        items,
        uncarded,
        boardCreatedAt: project.createdAt,
        candidates,
        now
      });
      emit({
        board: shown,
        findings: r.findings,
        counts: r.counts
      });
      return 0;
    }
    if (verb === "gate") {
      const openMs = fetchMilestones(run, info.root, owner, repo, "open");
      const found = openMs.find((m) => m.title === msTitle) ?? fetchMilestones(run, info.root, owner, repo, "closed").find((m) => m.title === msTitle);
      if (!found) {
        throw new PmError(1, `no milestone titled "${msTitle}"; open: ${openMs.map((m) => m.title).join(", ") || "(none)"}`);
      }
      const issues = fetchOpenIssues(run, info.root, owner, repo);
      const items = cardedItems(fetchRepoIssues(run, info.root, owner, repo, project.id), fullName);
      const v = gateVerdict(found, issues, items);
      emit({ board: shown, milestone: found, ready: v.ready, open: v.open });
      return 0;
    }
    err(PM_USAGE);
    return 1;
  } catch (e) {
    if (e instanceof PmError) {
      err(e.message);
      return e.exit;
    }
    err(e instanceof Error ? e.message : String(e));
    return 1;
  }
}
function emitReport(r, out, err) {
  const { board, open: open2, milestone, issue_counts, plans } = r;
  if (open2.length === 0) {
    err("no open milestone to report on");
    return 1;
  }
  if (milestone === null || issue_counts === null || plans === null) {
    err(`no active milestone among ${open2.length} open (${open2.map((m) => m.title).join(", ")}); pass --milestone`);
    return 1;
  }
  if (plans.parse !== "ok") {
    err(plans.parse === "none" ? `milestone "${milestone.title}" has no plans header` : `milestone "${milestone.title}": ${plans.reason ?? "malformed plans header"}`);
    return 1;
  }
  out(renderReport({ board, milestone, issue_counts, plans }));
  return 0;
}
function inProgressMilestones(open2, items) {
  const titles2 = new Set(items.filter((i) => i.state === "OPEN" && i.status === "In Progress").map((i) => i.milestone));
  return open2.filter((m) => m.state === "open" && titles2.has(m.title)).sort((a, b) => a.number - b.number);
}
function activeMilestone(open2, items) {
  const working = inProgressMilestones(open2, items);
  if (working.length === 1)
    return working[0];
  const live = open2.filter((m) => m.state === "open");
  return working.length === 0 && live.length === 1 ? live[0] : null;
}
function namedMilestone(open2, title) {
  const found = open2.find((m) => m.title === title);
  if (found)
    return found;
  throw new PmError(1, `no open milestone titled "${title}"; open: ${open2.map((m) => m.title).join(", ") || "(none)"}`);
}
function tiers(items, active, now) {
  const open2 = items.filter((i) => i.state === "OPEN");
  const byNumber = (a, b) => a.number - b.number;
  const in_progress = open2.filter((i) => i.status === "In Progress").map((i) => ({
    number: i.number,
    title: i.title,
    item_id: i.itemId,
    age_days: ageDays(touchedAt(i), now),
    assignees: i.assignees,
    milestone: i.milestone
  })).sort(byNumber);
  const backlog = open2.filter((i) => i.status === "Backlog");
  const tier1 = active ? backlog.filter((i) => i.milestone === active.title) : [];
  const tier2 = backlog.filter((i) => i.milestone === null && !i.labels.includes("backlog"));
  const cand = (tier) => (i) => ({
    tier,
    number: i.number,
    title: i.title,
    item_id: i.itemId,
    labels: i.labels
  });
  return {
    in_progress,
    candidates: [
      ...tier1.sort(byNumber).map(cand(1)),
      ...tier2.sort(byNumber).map(cand(2))
    ]
  };
}
var OpenPrList = array(object({ number: number(), title: string() }));
function drift(run, root, inProgress2, inProgressSplit = []) {
  const branch = run("git", ["branch", "--show-current"], root).stdout.trim();
  let basis = "none";
  let base = null;
  if (run("git", ["rev-parse", "--abbrev-ref", "@{u}"], root).code === 0) {
    basis = "upstream";
    base = "@{u}";
  } else if (branch && run("git", ["rev-parse", "--verify", "--quiet", `refs/remotes/origin/${branch}`], root).code === 0) {
    basis = "origin-branch";
    base = `origin/${branch}`;
  }
  let count = null;
  if (base) {
    const r = run("git", ["rev-list", "--count", `${base}..HEAD`], root);
    count = r.code === 0 ? Number(r.stdout.trim()) : null;
  }
  let open_pr = null;
  if (branch) {
    const r = run("gh", [
      "pr",
      "list",
      "--head",
      branch,
      "--state",
      "open",
      "--json",
      "number,title"
    ], root);
    if (r.code === 0) {
      try {
        const list = safeParse(OpenPrList, JSON.parse(r.stdout));
        open_pr = list.success ? list.output[0] ?? null : null;
      } catch {
        open_pr = null;
      }
    }
  }
  return {
    unpushed: { count, basis },
    stale_in_progress: inProgress2.filter((i) => i.age_days > STALE_DAYS),
    open_pr,
    in_progress_split: inProgressSplit
  };
}
function gateVerdict(ms, issues, items) {
  const itemByNumber = new Map(items.map((i) => [i.number, i]));
  const open2 = issues.filter((i) => i.milestone === ms.title).sort((a, b) => a.number - b.number).map((i) => ({
    number: i.number,
    title: i.title,
    status: itemByNumber.get(i.number)?.status ?? null,
    item_id: itemByNumber.get(i.number)?.itemId ?? null,
    labels: i.labels
  }));
  return { ready: ms.open_issues === 0 && open2.length === 0, open: open2 };
}

// bin/helpers/profile.ts
import { parseArgs as parseArgs2 } from "node:util";

// bin/helpers/profile-launch.ts
import { spawnSync as spawnSync2 } from "node:child_process";
import * as fs6 from "node:fs";
import * as path6 from "node:path";
var isPlainObject = (x) => typeof x === "object" && x !== null && !Array.isArray(x);
var uniqueByValue = (items) => items.filter((item, i) => items.findIndex((o) => JSON.stringify(o) === JSON.stringify(item)) === i);
function mergeValue(prev, next) {
  if (isPlainObject(prev) && isPlainObject(next))
    return mergeTwo(prev, next);
  if (Array.isArray(prev) && Array.isArray(next)) {
    return uniqueByValue([...prev, ...next]);
  }
  return next;
}
function mergeTwo(base, next) {
  const carried = Object.entries(base).map(([key, prev]) => [
    key,
    Object.hasOwn(next, key) ? mergeValue(prev, next[key]) : prev
  ]);
  const added = Object.entries(next).filter(([key]) => !Object.hasOwn(base, key));
  return Object.fromEntries([...carried, ...added]);
}
var mergeSettings = (...layers) => layers.reduce(mergeTwo, {});
var memoryVariable = "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD";
function launchKeys(profile, home) {
  const isCleanRoom = profile.manifest.settingSources !== undefined && !profile.manifest.settingSources.includes("user");
  return {
    sidekick: { profile: profile.name },
    ...profile.hasRules ? { env: { [memoryVariable]: "1" } } : {},
    ...isCleanRoom ? {
      claudeMdExcludes: [
        path6.join(home, ".claude", "CLAUDE.md"),
        path6.join(home, ".claude", "rules", "**")
      ]
    } : {}
  };
}
function composeSettings(profile, opts) {
  return mergeSettings(profile.manifest.settings ?? {}, opts.overlay ?? {}, launchKeys(profile, opts.home));
}
function launchArgs(profile, settings) {
  const sources = profile.manifest.settingSources;
  return [
    "--add-dir",
    profile.dir,
    "--settings",
    JSON.stringify(settings),
    ...sources === undefined ? [] : ["--setting-sources", sources.join(",")]
  ];
}
var COULD_NOT_START = 127;
var printedStreams = (result) => [result.stdout, result.stderr].map((text) => text.trim()).filter((text) => text !== "");
var spawnClaude = (command, args, opts) => spawnSync2(command, args, {
  ...opts,
  encoding: "utf8",
  stdio: ["ignore", "pipe", "pipe"]
});
var isTimeout = (error) => ("code" in error) && error.code === "ETIMEDOUT";
var makeClaudeRunner = (spawn = spawnClaude) => (args, { cwd, timeoutMs }) => {
  const out = spawn("claude", args, {
    cwd,
    timeout: timeoutMs,
    shell: false
  });
  const stdout = out.stdout ?? "";
  const stderr = out.stderr ?? "";
  if (out.error === undefined) {
    return { code: out.status ?? 1, stdout, stderr, timedOut: false };
  }
  if (isTimeout(out.error)) {
    return { code: out.status ?? 1, stdout, stderr, timedOut: true };
  }
  return {
    code: COULD_NOT_START,
    stdout,
    stderr: stderr || out.error.message,
    timedOut: false
  };
};
var execClaude = makeClaudeRunner();
var CANARY_KEYS = ["feedbackSurveyRate", "cleanupPeriodDays"];
var CANARY_VALUE = "sidekick-canary";
var SKIP_VARIABLE = "SIDEKICK_PROFILE_SKIP_CHECK";
var SKIP_WARNING = `${SKIP_VARIABLE}=1 is set, so the settings were not checked with claude doctor.`;
var refuse = (...issues) => ({ ok: false, issues });
function invalidSettingsLines(doctorOutput, paths) {
  const lines = doctorOutput.split(`
`);
  const start = lines.findIndex((line) => line.trim() === "Invalid settings");
  if (start === -1)
    return [];
  const rest2 = lines.slice(start + 1);
  const end = rest2.findIndex((line) => line.trim() === "");
  const section = end === -1 ? rest2 : rest2.slice(0, end);
  return section.filter((line) => line.startsWith("- ") && paths.some((p) => line.startsWith(`- ${p} `)));
}
var printed = (result) => [result.stdout, result.stderr].filter((text) => text.trim() !== "").join(`
`);
function judge(result, lines, canary) {
  if (result.timedOut) {
    return refuse("claude doctor timed out.", printed(result));
  }
  if (result.code === COULD_NOT_START) {
    return refuse("The settings check could not start claude.", printed(result));
  }
  if (result.code !== 0) {
    return refuse(`claude doctor failed with exit code ${result.code}.`, printed(result));
  }
  const isCanaryLine = (line) => line.includes(` › ${canary}:`);
  if (!lines.some(isCanaryLine)) {
    return refuse("claude doctor's output no longer parses: its report for the canary key is missing, so a launch could drop settings silently.", `Set ${SKIP_VARIABLE}=1 to skip the check until sidekick catches up.`);
  }
  const real = lines.filter((line) => !isCanaryLine(line));
  return real.length === 0 ? { ok: true, warnings: [] } : refuse(...real);
}
function checkSettings(settings, deps, timeoutMs = 30000) {
  if (deps.skip)
    return { ok: true, warnings: [SKIP_WARNING] };
  const canary = CANARY_KEYS.find((key) => !Object.hasOwn(settings, key));
  if (canary === undefined) {
    return refuse(`The settings set both ${CANARY_KEYS.join(" and ")}, so the check has no canary key left.`);
  }
  const dir = fs6.mkdtempSync(path6.join(deps.tmpdir, "sidekick-profile-"));
  try {
    const file = path6.join(dir, "settings.json");
    fs6.writeFileSync(file, JSON.stringify({ ...settings, [canary]: CANARY_VALUE }), {
      mode: 384
    });
    const result = deps.run(["--settings", file, "doctor"], {
      cwd: deps.cwd,
      timeoutMs
    });
    const lines = invalidSettingsLines(result.stdout, [
      file,
      fs6.realpathSync(file)
    ]);
    return judge(result, lines, canary);
  } finally {
    fs6.rmSync(dir, { recursive: true, force: true });
  }
}
var bgArgs = (base, opts) => [
  ...base,
  ...opts.pluginDir === undefined ? [] : ["--plugin-dir", opts.pluginDir],
  ...opts.permissionMode === undefined ? [] : ["--permission-mode", opts.permissionMode],
  ...opts.worktree === undefined ? [] : ["--worktree", opts.worktree],
  "--bg",
  ...opts.sessionName === undefined ? [] : ["-n", opts.sessionName],
  ...opts.prompt === undefined ? [] : ["--", opts.prompt]
];

// bin/helpers/profile-plugins.ts
import * as fs7 from "node:fs";
import * as path7 from "node:path";
var PLUGIN_SKIP_VARIABLE = "SIDEKICK_PROFILE_SKIP_PLUGIN_CHECK";
var SKIP_WARNING2 = `${PLUGIN_SKIP_VARIABLE}=1 is set, so the plugins were not checked with claude plugin list.`;
var UNSATISFIED = "dependency-unsatisfied";
var EXEMPT_SUFFIXES = ["@builtin", "@inline"];
var DetailSchema = looseObject({
  type: string(),
  plugin: optional(string()),
  dependency: optional(string())
});
var EntrySchema = looseObject({
  id: string(),
  errorDetails: nullish(array(DetailSchema))
});
var ListSchema = array(EntrySchema);
var refuse2 = (...issues) => ({ ok: false, issues });
var needsPluginCheck = (manifest) => manifest.settingSources !== undefined || manifest.settings !== undefined && Object.hasOwn(manifest.settings, "enabledPlugins");
var enabledPluginIds = (manifest) => {
  const value = manifest.settings?.enabledPlugins;
  return typeof value === "object" && value !== null && !Array.isArray(value) ? Object.keys(value) : [];
};
var leavesOutUser = (manifest) => manifest.settingSources !== undefined && !manifest.settingSources.includes("user");
var unknownIdIssues = (manifest, listed) => {
  const synced = leavesOutUser(manifest) ? "; a synced plugin is not listed when the profile leaves out the user source" : "";
  return enabledPluginIds(manifest).filter((id) => !listed.has(id) && !EXEMPT_SUFFIXES.some((s) => id.endsWith(s))).map((id) => `"${id}": no plugin listed under this profile's settings has that id${synced}.`);
};
var parseJson2 = (text) => {
  try {
    return JSON.parse(text);
  } catch {
    return;
  }
};
function judgePluginList(stdout, manifest) {
  const parsed = safeParse(ListSchema, parseJson2(stdout));
  if (!parsed.success) {
    return refuse2("claude plugin list's output no longer parses, so a broken plugin dependency could pass unseen.", `Set ${PLUGIN_SKIP_VARIABLE}=1 to skip the check until sidekick catches up.`);
  }
  const entries = parsed.output;
  const issues = [];
  const warnings = [];
  const seen = new Set;
  for (const entry of entries) {
    for (const detail of entry.errorDetails ?? []) {
      if (detail.type !== UNSATISFIED) {
        warnings.push(`${entry.id}: claude plugin list reports ${detail.type}.`);
        continue;
      }
      const key = JSON.stringify([detail.plugin, detail.dependency]);
      if (seen.has(key))
        continue;
      seen.add(key);
      issues.push(`${entry.id} needs ${detail.dependency ?? "(unnamed)"}, which these settings do not enable. Enable it in the profile's settings.enabledPlugins, or set ${entry.id} to false too.`);
    }
  }
  issues.push(...unknownIdIssues(manifest, new Set(entries.map((entry) => entry.id))));
  return issues.length > 0 ? refuse2(...issues) : { ok: true, warnings: [...new Set(warnings)] };
}
function checkPlugins(settings, manifest, deps, timeoutMs = 30000) {
  if (deps.skip)
    return { ok: true, warnings: [SKIP_WARNING2] };
  const dir = fs7.mkdtempSync(path7.join(deps.tmpdir, "sidekick-profile-"));
  try {
    const file = path7.join(dir, "settings.json");
    fs7.writeFileSync(file, JSON.stringify(settings), { mode: 384 });
    const sources = manifest.settingSources;
    const result = deps.run([
      "--settings",
      file,
      ...sources === undefined ? [] : ["--setting-sources", sources.join(",")],
      "plugin",
      "list",
      "--json"
    ], { cwd: deps.cwd, timeoutMs });
    if (result.timedOut) {
      return refuse2("claude plugin list timed out.", ...printedStreams(result));
    }
    if (result.code !== 0) {
      return refuse2(`claude plugin list failed with exit code ${result.code}.`, ...printedStreams(result));
    }
    return judgePluginList(result.stdout, manifest);
  } finally {
    fs7.rmSync(dir, { recursive: true, force: true });
  }
}

// bin/helpers/profile-manifest.ts
import * as fs8 from "node:fs";
var SETTING_SOURCES = ["user", "project", "local"];
var PROFILE_NAME_RULE = "1 to 64 lowercase letters, digits, and hyphens, starting with a letter or digit";
var PROFILE_NAME = /^[a-z0-9][a-z0-9-]{0,63}$/;
var isProfileName = (name) => PROFILE_NAME.test(name);
var RESERVED_SETTINGS_KEY = "sidekick";
var ManifestSchema = strictObject({
  description: pipe(string(), minLength(1, "must not be empty")),
  settingSources: optional(pipe(array(picklist(SETTING_SOURCES)), check((a) => new Set(a).size === a.length, "must not repeat a source"))),
  settings: optional(pipe(unknown(), check((s) => !Array.isArray(s), "must be an object"), record(string(), unknown()), check((s) => !Object.hasOwn(s, RESERVED_SETTINGS_KEY), `must not set "${RESERVED_SETTINGS_KEY}", which launch owns`)))
});
function parseManifest(raw) {
  const result = safeParse(ManifestSchema, raw);
  if (result.success)
    return { ok: true, manifest: result.output };
  return {
    ok: false,
    issues: result.issues.map((i) => `${getDotPath(i) ?? "(root)"}: ${i.message}`)
  };
}
var isMissing = (err) => err instanceof Error && ("code" in err) && err.code === "ENOENT";
function readManifest(file) {
  let text;
  try {
    text = fs8.readFileSync(file, "utf8");
  } catch (err) {
    const why = isMissing(err) ? "missing" : err instanceof Error ? err.message : String(err);
    return { ok: false, issues: [`${file}: ${why}`] };
  }
  let raw;
  try {
    raw = JSON.parse(text);
  } catch (err) {
    const why = err instanceof Error ? err.message : String(err);
    return { ok: false, issues: [`${file}: invalid JSON: ${why}`] };
  }
  const parsed = parseManifest(raw);
  if (parsed.ok)
    return parsed;
  return { ok: false, issues: parsed.issues.map((i) => `${file}: ${i}`) };
}

// bin/helpers/profile-shell.ts
var FIND_INSTALL = 'let s="";process.stdin.on("data",d=>{s+=d}).on("end",()=>{try{const e=JSON.parse(s).find(x=>x.id==="sidekick@rikmorn"&&x.scope==="user");if(e&&typeof e.installPath==="string"){process.stdout.write(e.installPath);return}}catch{}process.exit(1)})';
var NO_INSTALL = "skp: no user-scope sidekick@rikmorn install";
var ZSH_FUNCTION = `skp() {
  builtin emulate -L zsh
  if (( $# < 1 )); then builtin print -u2 'usage: skp <profile> [claude arguments...]'; builtin return 2; fi
  local name=$1; builtin shift
  local list cli out
  list=$(command claude plugin list --json) || { builtin print -u2 'skp: claude plugin list failed'; builtin return 1; }
  cli=$(builtin print -r -- "$list" | command node -e '${FIND_INSTALL}') || { builtin print -u2 '${NO_INSTALL}'; builtin return 1; }
  out=$(command node "$cli/bin/sidekick" profile argv "$name") || builtin return
  local -a args=("\${(@0)out}")
  (( \${#args} )) && [[ -z \${args[-1]} ]] && args[-1]=()
  command claude "\${args[@]}" "$@"
}
`;
var BASH_FUNCTION = `skp() {
  if [ $# -lt 1 ]; then builtin echo 'usage: skp <profile> [claude arguments...]' >&2; builtin return 2; fi
  local name="$1"; builtin shift
  local list cli tmp rc a
  list=$(command claude plugin list --json) || { builtin echo 'skp: claude plugin list failed' >&2; builtin return 1; }
  cli=$(builtin printf '%s' "$list" | command node -e '${FIND_INSTALL}') || { builtin echo '${NO_INSTALL}' >&2; builtin return 1; }
  tmp=$(command mktemp "\${TMPDIR:-/tmp}/skp.XXXXXX") || builtin return 1
  command node "$cli/bin/sidekick" profile argv "$name" >| "$tmp"; rc=$?
  if [ "$rc" -ne 0 ]; then command rm -f "$tmp"; builtin return "$rc"; fi
  local args=()
  while IFS= builtin read -r -d '' a; do args+=("$a"); done < "$tmp"
  command rm -f "$tmp"
  command claude "\${args[@]}" "$@"
}
`;
var RESERVED_WORDS = new Set([
  "case",
  "coproc",
  "declare",
  "do",
  "done",
  "elif",
  "else",
  "end",
  "esac",
  "export",
  "fi",
  "float",
  "for",
  "foreach",
  "function",
  "if",
  "in",
  "integer",
  "local",
  "nocorrect",
  "readonly",
  "repeat",
  "select",
  "then",
  "time",
  "typeset",
  "until",
  "while"
]);
var SKP_RUNS_THROUGH = new Set(["command", "builtin"]);
function aliasNameRefusal(name) {
  if (name === "skp") {
    return '"skp" cannot be an alias: the alias would replace the skp function itself.';
  }
  if (SKP_RUNS_THROUGH.has(name)) {
    return `"${name}" cannot be an alias: skp runs its commands through command and builtin, and the alias would take them over.`;
  }
  if (RESERVED_WORDS.has(name)) {
    return `"${name}" cannot be an alias: it is a reserved word in zsh or bash, and the alias would break shell code that uses it.`;
  }
  return;
}
var shellFunction = (shell, aliasNames) => {
  for (const name of aliasNames) {
    if (!isProfileName(name)) {
      throw new Error(`invalid alias name: ${JSON.stringify(name)}`);
    }
  }
  const aliases = aliasNames.map((name) => `alias ${name}='skp ${name}'
`);
  return [shell === "zsh" ? ZSH_FUNCTION : BASH_FUNCTION, ...aliases].join("");
};

// bin/helpers/profile-store.ts
import * as fs9 from "node:fs";
import * as path8 from "node:path";
var MANIFEST_FILE = "profile.json";
var notAName = (name) => `"${name}" is not a profile name: use ${PROFILE_NAME_RULE}`;
var HIDES_AGENTS = "hides the repo's AGENTS.md in every profiled session; put the stance in .claude/rules/";
var ENABLES_PLUGINS = "can enable plugins outside the checked settings block; put settings in profile.json";
var RULES_ONLY = "a profile holds only rules; agents, skills, and commands belong in a plugin the profile enables";
var REFUSED_AT_ROOT = [
  { path: "CLAUDE.md", why: HIDES_AGENTS },
  { path: "CLAUDE.local.md", why: HIDES_AGENTS }
];
var CLAUDE_DIR_ALLOWS = "rules";
var CLAUDE_DIR_REASONS = new Map([
  ["CLAUDE.md", HIDES_AGENTS],
  ["settings.json", ENABLES_PLUGINS],
  ["settings.local.json", ENABLES_PLUGINS]
]);
function storeRoots(env, cwd, home, workTree) {
  const override = env.SIDEKICK_PROFILES_DIR;
  if (override)
    return [{ kind: "user", dir: path8.resolve(cwd, override) }];
  const configDir = env.CLAUDE_CONFIG_DIR || path8.join(home, ".claude");
  const user = {
    kind: "user",
    dir: path8.resolve(cwd, configDir, "profiles")
  };
  if (workTree === undefined)
    return [user];
  const repo = {
    kind: "repo",
    dir: path8.resolve(workTree, ".claude", "profiles")
  };
  return repo.dir === user.dir ? [user] : [repo, user];
}
var isPresent = (file) => {
  try {
    fs9.lstatSync(file);
    return true;
  } catch {
    return false;
  }
};
var isDirectory = (dir) => {
  try {
    return fs9.statSync(dir).isDirectory();
  } catch {
    return false;
  }
};
var entriesOf = (dir) => {
  try {
    return fs9.readdirSync(dir).sort();
  } catch {
    return [];
  }
};
function checkLayout(dir) {
  const atRoot = REFUSED_AT_ROOT.filter((r) => isPresent(path8.join(dir, r.path))).map((r) => `${path8.join(dir, r.path)}: ${r.why}`);
  const claudeDir = path8.join(dir, ".claude");
  const inClaudeDir = entriesOf(claudeDir).filter((name) => name !== CLAUDE_DIR_ALLOWS).map((name) => `${path8.join(claudeDir, name)}: ${CLAUDE_DIR_REASONS.get(name) ?? RULES_ONLY}`);
  return [...atRoot, ...inClaudeDir];
}
var holdsMarkdown = (dir) => {
  let entries;
  try {
    entries = fs9.readdirSync(dir, { withFileTypes: true });
  } catch {
    return false;
  }
  return entries.some((e) => {
    const full = path8.join(dir, e.name);
    if (e.isDirectory())
      return holdsMarkdown(full);
    if (e.isSymbolicLink() && isDirectory(full))
      return holdsMarkdown(full);
    return e.name.endsWith(".md");
  });
};
var readFolder = (name, root, shadows) => {
  const dir = path8.join(root.dir, name);
  const layout = checkLayout(dir);
  if (layout.length > 0)
    return { ok: false, issues: layout };
  const read = readManifest(path8.join(dir, MANIFEST_FILE));
  if (!read.ok)
    return read;
  return {
    ok: true,
    profile: {
      name,
      dir,
      root: root.dir,
      store: root.kind,
      shadows,
      manifest: read.manifest,
      hasRules: holdsMarkdown(path8.join(dir, ".claude", "rules"))
    }
  };
};
function loadProfile(name, roots) {
  if (!isProfileName(name))
    return { ok: false, issues: [notAName(name)] };
  const held = (root) => isDirectory(path8.join(root.dir, name));
  const index = roots.findIndex(held);
  const winner = roots[index];
  if (winner === undefined) {
    return {
      ok: false,
      issues: [
        `no profile named "${name}"; searched: ${roots.map((r) => r.dir).join(", ")}`
      ]
    };
  }
  const later = roots.slice(index + 1).find(held);
  return readFolder(name, winner, later === undefined ? undefined : path8.join(later.dir, name));
}
var isHidden = (name) => name.startsWith(".");
var listRoot = (root) => {
  let names;
  try {
    names = fs9.readdirSync(root.dir).sort();
  } catch {
    return [];
  }
  return names.filter((name) => !isHidden(name) && isDirectory(path8.join(root.dir, name))).map((name) => {
    const base = {
      name,
      root: root.dir,
      store: root.kind,
      shadowedBy: undefined
    };
    if (!isProfileName(name)) {
      return { ...base, description: undefined, issues: [notAName(name)] };
    }
    const loaded = readFolder(name, root, undefined);
    return loaded.ok ? {
      ...base,
      description: loaded.profile.manifest.description,
      issues: []
    } : { ...base, description: undefined, issues: loaded.issues };
  });
};
function listProfiles(roots) {
  const winners = new Map;
  return roots.flatMap((root) => listRoot(root).map((listed) => {
    const winner = winners.get(listed.name);
    if (winner === undefined) {
      winners.set(listed.name, path8.join(root.dir, listed.name));
      return listed;
    }
    return { ...listed, shadowedBy: winner };
  }));
}
var isExists = (err) => err instanceof Error && ("code" in err) && err.code === "EEXIST";
var messageOf = (err) => err instanceof Error ? err.message : String(err);
var makeRoot = (root) => {
  try {
    fs9.mkdirSync(root, { recursive: true });
    return [];
  } catch (err) {
    return [
      `${root}: ${isExists(err) ? "exists and is not a folder" : messageOf(err)}`
    ];
  }
};
var unmake = (dir) => {
  try {
    const manifest = path8.join(dir, MANIFEST_FILE);
    if (isPresent(manifest))
      fs9.rmSync(manifest);
    fs9.rmdirSync(dir);
    return [];
  } catch (err) {
    return [`${dir}: could not remove it: ${messageOf(err)}`];
  }
};
function newProfile(name, description, root) {
  if (!isProfileName(name))
    return { ok: false, issues: [notAName(name)] };
  const manifest = { description };
  const parsed = parseManifest(manifest);
  if (!parsed.ok)
    return parsed;
  const rootIssues = makeRoot(root);
  if (rootIssues.length > 0)
    return { ok: false, issues: rootIssues };
  const dir = path8.join(root, name);
  try {
    fs9.mkdirSync(dir);
  } catch (err) {
    const why = isExists(err) ? "already exists" : messageOf(err);
    return { ok: false, issues: [`${dir}: ${why}`] };
  }
  const file = path8.join(dir, MANIFEST_FILE);
  try {
    fs9.writeFileSync(file, `${JSON.stringify(manifest, null, 2)}
`);
  } catch (err) {
    return {
      ok: false,
      issues: [`${file}: ${messageOf(err)}`, ...unmake(dir)]
    };
  }
  return { ok: true, dir };
}

// bin/helpers/profile.ts
var PROFILE_USAGE_LINE = "sidekick profile list|show <name>|new <name> --description <text> [--repo]|argv <name>|launch --bg <name> [-n <session>] [-- <prompt>]|alias [--shell zsh|bash] [<name>...]|switch <name> [--session <id>]";
var LAUNCH_TIMEOUT_MS = 60000;
var SHELLS = ["zsh", "bash"];
var withoutTrailingNewline = (text) => text.replace(/\n$/, "");
function parseFlags(rest2, options) {
  try {
    const { values, positionals } = parseArgs2({
      args: rest2,
      options,
      allowPositionals: true,
      strict: true
    });
    return { values, positionals };
  } catch {
    return;
  }
}
var usage = (err) => {
  err(`usage: ${PROFILE_USAGE_LINE}`);
  return 1;
};
var refuse3 = (err, issues) => {
  for (const issue of issues)
    err(issue);
  return 1;
};
function load(name, penv) {
  const loaded = loadProfile(name, storeRoots(penv.env, penv.cwd, penv.home, penv.workTree));
  return loaded.ok ? { profile: loaded.profile } : { issues: loaded.issues };
}
function provenanceLine(profile) {
  if (profile.store === "user")
    return;
  const shadows = profile.shadows === undefined ? "" : ` (it shadows ${profile.shadows})`;
  return `profile "${profile.name}" comes from the ${profile.store} store: ${profile.dir}${shadows}`;
}
var composed = (profile, penv, overlay) => {
  const settings = composeSettings(profile, { home: penv.home, overlay });
  return { settings, args: launchArgs(profile, settings) };
};
var settingsCheck = (settings, penv) => checkSettings(settings, {
  run: penv.runClaude,
  cwd: penv.cwd,
  tmpdir: penv.tmpdir,
  skip: penv.env[SKIP_VARIABLE] === "1"
});
var skipsPluginCheck = (penv) => penv.env[PLUGIN_SKIP_VARIABLE] === "1";
var pluginCheck = (profile, settings, penv) => checkPlugins(settings, profile.manifest, {
  run: penv.runClaude,
  cwd: penv.cwd,
  tmpdir: penv.tmpdir,
  skip: skipsPluginCheck(penv)
});
function checkProfile(profile, settings, penv) {
  const checked2 = settingsCheck(settings, penv);
  if (!checked2.ok || !needsPluginCheck(profile.manifest))
    return checked2;
  const plugins = pluginCheck(profile, settings, penv);
  return plugins.ok ? { ok: true, warnings: [...checked2.warnings, ...plugins.warnings] } : plugins;
}
function loadForLaunch(name, penv, err) {
  const loaded = load(name, penv);
  if ("issues" in loaded) {
    refuse3(err, loaded.issues);
    return;
  }
  const provenance = provenanceLine(loaded.profile);
  if (provenance !== undefined)
    err(provenance);
  return loaded.profile;
}
function checkComposed(profile, penv, err, overlay) {
  const { settings, args } = composed(profile, penv, overlay);
  const checked2 = checkProfile(profile, settings, penv);
  if (!checked2.ok) {
    refuse3(err, checked2.issues);
    return;
  }
  for (const warning of checked2.warnings)
    err(warning);
  return args;
}
function checkedLaunch(name, penv, err) {
  const profile = loadForLaunch(name, penv, err);
  return profile === undefined ? undefined : checkComposed(profile, penv, err);
}
function pluginReport(profile, settings, penv) {
  if (!needsPluginCheck(profile.manifest)) {
    return [
      "plugins: not checked; the profile sets neither settings.enabledPlugins nor settingSources"
    ];
  }
  if (skipsPluginCheck(penv)) {
    return [`plugins: not checked; ${PLUGIN_SKIP_VARIABLE}=1 is set`];
  }
  const plugins = pluginCheck(profile, settings, penv);
  return plugins.ok ? ["plugins: ok", ...plugins.warnings.map((w) => `  ${w}`)] : ["plugins: refused", ...plugins.issues.map((i) => `  ${i}`)];
}
var list = (rest2, penv, out, err) => {
  if (rest2.length > 0)
    return usage(err);
  const profiles = listProfiles(storeRoots(penv.env, penv.cwd, penv.home, penv.workTree));
  for (const p of profiles) {
    const shadowed = p.shadowedBy === undefined ? "" : `, shadowed by ${p.shadowedBy}`;
    const where = `(${p.store}: ${p.root}${shadowed})`;
    out(p.issues.length > 0 ? `${p.name}  invalid: ${p.issues[0]}  ${where}` : `${p.name}  ${p.description}  ${where}`);
  }
  return profiles.some((p) => p.issues.length > 0) ? 1 : 0;
};
var show = (rest2, penv, out, err) => {
  const parsed = parseFlags(rest2, {});
  if (parsed === undefined || parsed.positionals.length !== 1) {
    return usage(err);
  }
  const loaded = load(parsed.positionals[0], penv);
  if ("issues" in loaded)
    return refuse3(err, loaded.issues);
  const { profile } = loaded;
  const { settings, args } = composed(profile, penv);
  out(`folder: ${profile.dir}`);
  out(`store: ${profile.store}`);
  out(`manifest: ${JSON.stringify(profile.manifest, null, 2)}`);
  out(`settings: ${JSON.stringify(settings, null, 2)}`);
  for (const line of pluginReport(profile, settings, penv))
    out(line);
  out("arguments:");
  for (const arg of args)
    out(arg);
  return 0;
};
var noRepoStore = (penv) => {
  if (penv.env.SIDEKICK_PROFILES_DIR) {
    return "SIDEKICK_PROFILES_DIR is set, so there is no repo store";
  }
  if (penv.workTree === undefined) {
    return "not inside a git work tree, so there is no repo store";
  }
  return "the repo store is the user store here, so --repo has nowhere else to write";
};
var create = (rest2, penv, out, err) => {
  const parsed = parseFlags(rest2, {
    description: { type: "string" },
    repo: { type: "boolean" }
  });
  const description = parsed?.values.description;
  if (parsed === undefined || parsed.positionals.length !== 1 || typeof description !== "string") {
    return usage(err);
  }
  const wanted = parsed.values.repo === true ? "repo" : "user";
  const root = storeRoots(penv.env, penv.cwd, penv.home, penv.workTree).find((r) => r.kind === wanted);
  if (root === undefined)
    return refuse3(err, [noRepoStore(penv)]);
  const created = newProfile(parsed.positionals[0], description, root.dir);
  if (!created.ok)
    return refuse3(err, created.issues);
  out(created.dir);
  return 0;
};
var argv = (rest2, penv, _out, err) => {
  const parsed = parseFlags(rest2, {});
  if (parsed === undefined || parsed.positionals.length !== 1) {
    return usage(err);
  }
  const args = checkedLaunch(parsed.positionals[0], penv, err);
  if (args === undefined)
    return 1;
  penv.write(args.map((arg) => `${arg}\x00`).join(""));
  return 0;
};
var launch = (rest2, penv, out, err) => {
  const split = rest2.indexOf("--");
  const before = split === -1 ? rest2 : rest2.slice(0, split);
  const words = split === -1 ? [] : rest2.slice(split + 1);
  const parsed = parseFlags(before, {
    bg: { type: "boolean" },
    n: { type: "string", short: "n" }
  });
  if (parsed === undefined || parsed.positionals.length !== 1) {
    return usage(err);
  }
  if (parsed.values.bg !== true) {
    return refuse3(err, [
      "launch only starts background sessions: pass --bg.",
      "For an interactive start, use the shell function: skp <name> (sidekick profile alias prints it)."
    ]);
  }
  const args = checkedLaunch(parsed.positionals[0], penv, err);
  if (args === undefined)
    return 1;
  const { launchTimeoutMs = LAUNCH_TIMEOUT_MS } = penv;
  const sessionName = parsed.values.n;
  const result = penv.runClaude(bgArgs(args, {
    sessionName: typeof sessionName === "string" ? sessionName : undefined,
    prompt: words.length > 0 ? words.join(" ") : undefined
  }), { cwd: penv.cwd, timeoutMs: launchTimeoutMs });
  if (result.stdout !== "")
    out(withoutTrailingNewline(result.stdout));
  if (result.stderr !== "")
    err(withoutTrailingNewline(result.stderr));
  if (result.timedOut)
    err("claude did not return in time.");
  return result.code;
};
var isShell = (value) => SHELLS.some((shell) => shell === value);
var alias = (rest2, penv, out, err) => {
  const parsed = parseFlags(rest2, { shell: { type: "string" } });
  if (parsed === undefined)
    return usage(err);
  const shell = parsed.values.shell ?? "zsh";
  if (!isShell(shell)) {
    return refuse3(err, [
      `unknown shell "${String(shell)}": use ${SHELLS.join(" or ")}`
    ]);
  }
  const issues = parsed.positionals.flatMap((name) => {
    const refusal = aliasNameRefusal(name);
    if (refusal !== undefined)
      return [refusal];
    const loaded = load(name, penv);
    return "issues" in loaded ? loaded.issues : [];
  });
  if (issues.length > 0)
    return refuse3(err, issues);
  out(withoutTrailingNewline(shellFunction(shell, parsed.positionals)));
  return 0;
};
var shellQuote = (value) => `'${value.replaceAll("'", "'\\''")}'`;
var switchProfile = (rest2, penv, out, err) => {
  const parsed = parseFlags(rest2, { session: { type: "string" } });
  if (parsed === undefined || parsed.positionals.length !== 1) {
    return usage(err);
  }
  const [name] = parsed.positionals;
  const flagged = parsed.values.session;
  if (flagged === "") {
    return refuse3(err, [
      "--session is empty: pass a session id, or leave the flag out inside a session"
    ]);
  }
  const sessionId = typeof flagged === "string" ? flagged : penv.env.CLAUDE_CODE_SESSION_ID;
  if (sessionId === undefined || sessionId === "") {
    return refuse3(err, [
      "no session id: run switch inside a session, or pass --session <id>"
    ]);
  }
  if (checkedLaunch(name, penv, err) === undefined)
    return 1;
  const folder = penv.workTree ?? penv.cwd;
  const cd = `cd ${shellQuote(folder)}`;
  out(`To switch this session to "${name}", type /exit, then run one of these.`);
  out("Keep the conversation:");
  out(`  ${cd} && skp ${name} --resume ${shellQuote(sessionId)}`);
  out("Start fresh:");
  out(`  ${cd} && skp ${name}`);
  out(`After a resume, skills of plugins "${name}" turns off stay listed but fail when called.`);
  return 0;
};
var VERBS3 = {
  list,
  show,
  new: create,
  argv,
  launch,
  alias,
  switch: switchProfile
};
function runProfileCli(args, penv, out, err) {
  const [name, ...rest2] = args;
  if (name === undefined || !Object.hasOwn(VERBS3, name))
    return usage(err);
  return VERBS3[name](rest2, penv, out, err);
}

// bin/helpers/worker-dispatch.ts
import * as fs12 from "node:fs";
import * as path11 from "node:path";

// bin/helpers/worker-brief.ts
import * as fs10 from "node:fs";
import * as path9 from "node:path";
var FENCE = "---";
var KEY_LINE = /^([a-z]+):(?: (.*))?$/;
function parseFrontmatter(text) {
  const lines = text.split(/\r?\n/).map((l) => l.trimEnd());
  if (lines[0] !== FENCE) {
    return { issues: ["the brief must open with a --- line"] };
  }
  const end = lines.indexOf(FENCE, 1);
  if (end === -1) {
    return { issues: ["the brief's frontmatter has no closing --- line"] };
  }
  const fields = {};
  const issues = [];
  for (const [i, line] of lines.slice(1, end).entries()) {
    if (line === "")
      continue;
    const match = KEY_LINE.exec(line);
    const key = match?.[1];
    if (key === undefined) {
      issues.push(`line ${i + 2}: "${line}" is not "key: value" with a lower-case key`);
    } else if (Object.hasOwn(fields, key)) {
      issues.push(`line ${i + 2}: the key "${key}" is repeated`);
    } else {
      fields[key] = (match?.[2] ?? "").trim();
    }
  }
  return issues.length > 0 ? { issues } : { fields };
}
var AbsolutePath = pipe(string(), check((s) => path9.isAbsolute(s), "must be an absolute path"));
var RelativePath = pipe(string(), minLength(1, "must not be empty"), check((s) => !path9.isAbsolute(s), "must be relative to the repo top"), check((s) => !s.split(/[\\/]/).includes(".."), 'must not have a ".." segment'));
var BriefSchema = strictObject({
  name: pipe(string(), regex(/^[a-z0-9][a-z0-9-]{0,39}$/, "must match ^[a-z0-9][a-z0-9-]{0,39}$")),
  plan: AbsolutePath,
  spec: AbsolutePath,
  rulings: AbsolutePath,
  baseline: pipe(string(), regex(/^[0-9a-f]{7,40}$/, "must be a commit of 7 to 40 hex characters")),
  skill: picklist(["subagent-driven-development", "executing-plans"]),
  place: union([
    literal("worktree"),
    literal("in-place"),
    pipe(string(), regex(/^branch \S+$/))
  ], 'must be "worktree", "in-place", or "branch <name>"'),
  setup: optional(pipe(string(), minLength(1))),
  report: RelativePath,
  orchestrator: pipe(string(), minLength(1, "must not be empty"))
});
function readBrief(file) {
  const abs = path9.resolve(file);
  let text;
  try {
    text = fs10.readFileSync(abs, "utf-8");
  } catch (e) {
    const why = e instanceof Error ? e.message : String(e);
    return { issues: [`${abs}: cannot read the brief: ${why}`] };
  }
  const parsed = parseFrontmatter(text);
  if ("issues" in parsed) {
    return { issues: parsed.issues.map((i) => `${abs}: ${i}`) };
  }
  const result = safeParse(BriefSchema, parsed.fields);
  if (!result.success) {
    return {
      issues: result.issues.map((issue) => {
        const field = issue.path?.map((p) => String(p.key)).join(".");
        return field ? `${abs}: field "${field}" ${issue.message}` : `${abs}: ${issue.message}`;
      })
    };
  }
  return { brief: result.output, path: abs };
}
function physical(p) {
  const abs = path9.resolve(p);
  const rest2 = [];
  let dir = abs;
  for (;; ) {
    try {
      return path9.join(fs10.realpathSync(dir), ...rest2);
    } catch {
      const parent = path9.dirname(dir);
      if (parent === dir)
        return abs;
      rest2.unshift(path9.basename(dir));
      dir = parent;
    }
  }
}
var isInside = (top, p) => {
  const rel = path9.relative(top, p);
  const leaves = rel === ".." || rel.startsWith(`..${path9.sep}`);
  return rel !== "" && !leaves && !path9.isAbsolute(rel);
};
function briefFileIssues(brief, top) {
  const issues = [];
  const realTop = physical(top);
  if (!fs10.existsSync(brief.plan)) {
    issues.push(`plan: ${brief.plan} does not exist`);
  }
  if (!fs10.existsSync(brief.spec)) {
    issues.push(`spec: ${brief.spec} does not exist`);
  }
  const rulingsDir = path9.dirname(brief.rulings);
  if (!fs10.existsSync(rulingsDir)) {
    issues.push(`rulings: the folder ${rulingsDir} does not exist`);
  }
  const named = [
    ["plan", brief.plan],
    ["spec", brief.spec],
    ["rulings", brief.rulings]
  ];
  for (const [field, file] of named) {
    if (!isInside(realTop, physical(file))) {
      issues.push(`${field}: ${file} is outside ${top}`);
    }
  }
  return issues;
}

// bin/helpers/worker-jobs.ts
var LISTING_ARGS = ["agents", "--json", "--all"];
var LISTING = `claude ${LISTING_ARGS.join(" ")}`;
var OptionalText = nullish(string());
var JobSchema = pipe(unknown(), check((row2) => !Array.isArray(row2), "must be an object"), object({
  id: OptionalText,
  kind: OptionalText,
  name: OptionalText,
  state: OptionalText
}), transform((row2) => ({
  id: row2.id ?? undefined,
  kind: row2.kind ?? undefined,
  name: row2.name ?? undefined,
  state: row2.state ?? undefined
})));
var ListingSchema = array(JobSchema);
function parseJson3(text) {
  try {
    return { value: JSON.parse(text) };
  } catch (e) {
    const why = e instanceof Error ? e.message : String(e);
    return { issue: `${LISTING} printed a listing that is not JSON: ${why}` };
  }
}
function listJobs(run, cwd, timeoutMs = 30000) {
  const result = run(LISTING_ARGS, { cwd, timeoutMs });
  if (result.timedOut) {
    return { issues: [`${LISTING} did not return in time.`] };
  }
  if (result.code !== 0) {
    return {
      issues: [
        `${LISTING} failed with exit code ${result.code}.`,
        ...printedStreams(result)
      ]
    };
  }
  const json = parseJson3(result.stdout);
  if ("issue" in json)
    return { issues: [json.issue] };
  const parsed = safeParse(ListingSchema, json.value);
  if (!parsed.success) {
    const [first] = parsed.issues;
    const where = getDotPath(first) ?? "(root)";
    return {
      issues: [
        `${LISTING} printed a listing that does not parse: ${where}: ${first.message}`
      ]
    };
  }
  return { jobs: parsed.output };
}

// bin/helpers/worker-overlay.ts
var PUSH_REWRITE_KEY = "url.sidekick-push-blocked::.pushInsteadOf";
var PUSH_DENY_RULE = "Bash(git push:*)";
function pushEnv(count) {
  return {
    GIT_CONFIG_COUNT: String(count + 1),
    [`GIT_CONFIG_KEY_${count}`]: PUSH_REWRITE_KEY,
    [`GIT_CONFIG_VALUE_${count}`]: ""
  };
}
function workerOverlay(profileSettings, opts) {
  const base = { worktree: { baseRef: "head" } };
  if (opts.allowPush) {
    return {
      overlay: { ...base, env: { SIDEKICK_WORKER: opts.briefPath } }
    };
  }
  const env = isPlainObject(profileSettings?.env) ? profileSettings.env : {};
  const raw = env.GIT_CONFIG_COUNT ?? "0";
  if (typeof raw !== "string" || !/^\d+$/.test(raw)) {
    return {
      issues: [
        `the profile's GIT_CONFIG_COUNT is ${JSON.stringify(raw)}, not a string of digits`
      ]
    };
  }
  return {
    overlay: {
      ...base,
      env: { SIDEKICK_WORKER: opts.briefPath, ...pushEnv(Number(raw)) },
      permissions: { deny: [PUSH_DENY_RULE] }
    }
  };
}

// bin/helpers/worker-repo.ts
import * as fs11 from "node:fs";
import * as path10 from "node:path";
var WORKTREES_FOLDER = ".claude/worktrees";
var EXCLUDE_ENTRY = `${WORKTREES_FOLDER}/`;
function mainCheckout(runGit, cwd) {
  const result = runGit("git", [
    "rev-parse",
    "--path-format=absolute",
    "--show-toplevel",
    "--absolute-git-dir",
    "--git-common-dir"
  ], cwd);
  if (result.code !== 0) {
    return {
      issues: [
        "not inside a git work tree: run sidekick worker from the repo's main checkout"
      ]
    };
  }
  const [top, gitDir, commonDir] = result.stdout.replace(/\n$/, "").split(`
`);
  if (top === undefined || gitDir === undefined || commonDir === undefined) {
    return {
      issues: [`git rev-parse printed an unexpected answer: ${result.stdout}`]
    };
  }
  if (gitDir !== commonDir) {
    return {
      issues: [
        `${top} is a linked worktree: run sidekick worker from the main checkout, whose git dir is ${commonDir}`
      ]
    };
  }
  return { top, commonDir };
}
function commitOf(runGit, top, rev) {
  const result = runGit("git", ["rev-parse", "--verify", "--quiet", `${rev}^{commit}`], top);
  return result.code === 0 ? result.stdout.trim() : undefined;
}
var headCommit = (runGit, top) => commitOf(runGit, top, "HEAD");
function isTrackedClean(runGit, top) {
  const result = runGit("git", ["status", "--porcelain", "--untracked-files=no"], top);
  return result.code === 0 && result.stdout.trim() === "";
}
var branchExists = (runGit, top, branch) => runGit("git", ["rev-parse", "--verify", "--quiet", `refs/heads/${branch}`], top).code === 0;
function checkedOut(runGit, dir) {
  const result = runGit("git", ["symbolic-ref", "-q", "HEAD"], dir);
  if (result.code === 0)
    return result.stdout.trim();
  if (result.code === 1)
    return "a detached HEAD";
  return `an unreadable HEAD (${result.stderr.trim()})`;
}
var RENAMED = /^(?:[RC].|.[RC]) /;
var STATUS_PREFIX = "XY ".length;
function statusPaths(stdout) {
  const fields = stdout.split("\x00").filter((field) => field !== "");
  const paths = [];
  let i = 0;
  while (i < fields.length) {
    const entry = fields[i];
    const source = RENAMED.test(entry) ? fields.at(i + 1) : undefined;
    paths.push(entry.slice(STATUS_PREFIX));
    if (source !== undefined)
      paths.push(source);
    i += source === undefined ? 1 : 2;
  }
  return paths;
}
function statusPathsIn(runGit, top, dir) {
  const status = runGit("git", ["-C", dir, "status", "--porcelain", "-z", "--untracked-files=all"], top);
  if (status.code !== 0)
    return { issue: status.stderr.trim() };
  return { paths: statusPaths(status.stdout) };
}
var PUSH_URL_KEY = /^remote\.(.+)\.pushurl$/;
function remotesWithPushUrl(runGit, top) {
  const result = runGit("git", ["config", "--get-regexp", "^remote\\..+\\.pushurl$"], top);
  if (result.code !== 0)
    return [];
  const names = result.stdout.split(`
`).map((line) => PUSH_URL_KEY.exec(line.split(" ")[0])?.[1]).filter((name) => name !== undefined);
  return [...new Set(names)];
}
var isIgnored = (runGit, top) => runGit("git", ["check-ignore", "-q", "--no-index", `${WORKTREES_FOLDER}/x`], top).code === 0;
var reason = (e) => e instanceof Error ? e.message : String(e);
var isMissing2 = (e) => e instanceof Error && ("code" in e) && e.code === "ENOENT";
function readExclude(file) {
  try {
    return { text: fs11.readFileSync(file, "utf-8") };
  } catch (e) {
    if (isMissing2(e))
      return { text: "" };
    return {
      issues: [
        `cannot read ${file}, where dispatch adds ${EXCLUDE_ENTRY}: ${reason(e)}. Fix the file, then run dispatch again`
      ]
    };
  }
}
function appendExclude(file, text) {
  const separator = text === "" || text.endsWith(`
`) ? "" : `
`;
  try {
    fs11.mkdirSync(path10.dirname(file), { recursive: true });
    fs11.appendFileSync(file, `${separator}${EXCLUDE_ENTRY}
`);
    return [];
  } catch (e) {
    return [
      `cannot add ${EXCLUDE_ENTRY} to ${file}: ${reason(e)}. Fix the file, then run dispatch again`
    ];
  }
}
function ensureWorktreesExcluded(runGit, top, commonDir) {
  if (isIgnored(runGit, top))
    return { line: undefined };
  const file = path10.join(commonDir, "info", "exclude");
  const read = readExclude(file);
  if ("issues" in read)
    return read;
  if (read.text.split(/\r?\n/).includes(EXCLUDE_ENTRY)) {
    return { line: undefined };
  }
  const issues = appendExclude(file, read.text);
  if (issues.length > 0)
    return { issues };
  return { line: `added ${EXCLUDE_ENTRY} to ${file}` };
}

// bin/helpers/worker-dispatch.ts
var PERMISSION_MODES = [
  "default",
  "acceptEdits",
  "plan",
  "auto",
  "dontAsk",
  "bypassPermissions",
  "manual"
];
var MODE_LIST = PERMISSION_MODES.join(", ");
var BYPASS = "bypassPermissions";
var DEFAULT_WORKER_PROFILE = "worker";
var stringFlag = (values, key) => {
  const value = values[key];
  return typeof value === "string" ? value : undefined;
};
function parseDispatchArgs(rest2, cwd) {
  const parsed = parseFlags(rest2, {
    "permission-mode": { type: "string" },
    profile: { type: "string" },
    "plugin-dir": { type: "string" },
    "allow-push": { type: "boolean" }
  });
  if (parsed === undefined || parsed.positionals.length !== 1)
    return;
  const pluginDir = stringFlag(parsed.values, "plugin-dir");
  if (pluginDir === "")
    return;
  return {
    brief: path11.resolve(cwd, parsed.positionals[0]),
    mode: stringFlag(parsed.values, "permission-mode"),
    profile: stringFlag(parsed.values, "profile") ?? DEFAULT_WORKER_PROFILE,
    pluginDir: pluginDir === undefined ? undefined : path11.resolve(cwd, pluginDir),
    allowPush: parsed.values["allow-push"] === true
  };
}
var isFolder = (dir) => {
  try {
    return fs12.statSync(dir).isDirectory();
  } catch {
    return false;
  }
};
function modeIssues(mode) {
  if (mode === undefined) {
    return [
      `--permission-mode is required: pass the orchestrating session's own mode, one of ${MODE_LIST}`
    ];
  }
  const known = PERMISSION_MODES.some((m) => m === mode);
  return known ? [] : [`--permission-mode "${mode}" is not one of ${MODE_LIST}`];
}
var pluginDirIssues = (dir) => dir === undefined || isFolder(dir) ? [] : [`--plugin-dir: ${dir} is not a folder`];
var placeIssues = (brief) => brief.place === "worktree" ? [] : [
  `place: "${brief.place}" is not "worktree"; dispatch starts a worker only in a worktree of its own`
];
function baselineIssues(runGit, top, baseline) {
  const head = headCommit(runGit, top);
  if (head === undefined) {
    return ["baseline: the main checkout has no commit at HEAD yet"];
  }
  return commitOf(runGit, top, baseline) === head ? [] : [
    `baseline: ${baseline} does not resolve to the main checkout's HEAD (${head})`
  ];
}
var cleanIssues = (runGit, top) => isTrackedClean(runGit, top) ? [] : [
  "tracked files have uncommitted changes, which the worker's worktree would not carry: commit them first"
];
function treeNameIssues(runGit, top, name) {
  const folder = path11.join(top, WORKTREES_FOLDER, name);
  const branch = `worktree-${name}`;
  return [
    ...fs12.existsSync(folder) ? [`name: ${folder} already exists`] : [],
    ...branchExists(runGit, top, branch) ? [`name: the branch ${branch} already exists`] : []
  ];
}
function listedNameIssues(run, cwd, name) {
  const listed = listJobs(run, cwd);
  if ("issues" in listed)
    return listed.issues;
  return listed.jobs.some((job) => job.name === name) ? [
    `name: claude agents --json --all already lists a session named "${name}"`
  ] : [];
}
var pushUrlIssues = (runGit, top) => remotesWithPushUrl(runGit, top).map((remote) => `remote "${remote}" sets pushurl, and git ignores the push rewrite for such a remote: remove the pushurl, or pass --allow-push on the operator's word`);
function checkoutIssues(brief, opts, runGit, top) {
  return [
    ...briefFileIssues(brief, top),
    ...baselineIssues(runGit, top, brief.baseline),
    ...cleanIssues(runGit, top),
    ...treeNameIssues(runGit, top, brief.name),
    ...opts.allowPush ? [] : pushUrlIssues(runGit, top)
  ];
}
function bypassIssues(profile, mode) {
  const sources = profile.manifest.settingSources;
  if (mode !== BYPASS || sources === undefined || sources.includes("user")) {
    return [];
  }
  return [
    `${BYPASS} needs the user setting source, which profile "${profile.name}" leaves out (settingSources: ${sources.join(", ")}); a background session without it drops the bypass acceptance`
  ];
}
function missingProfileHint(name, penv) {
  const roots = storeRoots(penv.env, penv.cwd, penv.home, penv.workTree);
  const held = roots.some((root) => isFolder(path11.join(root.dir, name)));
  return isProfileName(name) && !held ? [`create it with: sidekick profile new ${name} --description <text>`] : [];
}
function prepareProfile(opts, briefPath, penv) {
  const lines = [];
  const collect = (line) => {
    lines.push(line);
  };
  const profile = loadForLaunch(opts.profile, penv, collect);
  if (profile === undefined) {
    return {
      ok: false,
      issues: [...lines, ...missingProfileHint(opts.profile, penv)]
    };
  }
  const bypass = bypassIssues(profile, opts.mode);
  const overlay = workerOverlay(profile.manifest.settings, {
    briefPath,
    allowPush: opts.allowPush
  });
  if ("issues" in overlay) {
    return { ok: false, issues: [...lines, ...overlay.issues, ...bypass] };
  }
  const args = checkComposed(profile, penv, collect, overlay.overlay);
  if (args === undefined || bypass.length > 0) {
    return { ok: false, issues: [...lines, ...bypass] };
  }
  return { ok: true, args, notes: lines };
}
function checkDispatch(brief, briefPath, opts, wenv) {
  const checkout = mainCheckout(wenv.runGit, wenv.cwd);
  const at = "issues" in checkout ? wenv.cwd : checkout.top;
  const prepared = prepareProfile(opts, briefPath, { ...wenv, cwd: at });
  const issues = [
    ..."issues" in checkout ? checkout.issues : checkoutIssues(brief, opts, wenv.runGit, checkout.top),
    ...placeIssues(brief),
    ...listedNameIssues(wenv.runClaude, at, brief.name),
    ...modeIssues(opts.mode),
    ...pluginDirIssues(opts.pluginDir),
    ...prepared.ok ? [] : prepared.issues
  ];
  const refused = issues.length > 0 || "issues" in checkout || !prepared.ok;
  if (refused || opts.mode === undefined)
    return { issues };
  return {
    brief,
    briefPath,
    mode: opts.mode,
    pluginDir: opts.pluginDir,
    allowPush: opts.allowPush,
    top: checkout.top,
    commonDir: checkout.commonDir,
    args: prepared.args,
    notes: prepared.notes
  };
}
var withoutTrailingNewline2 = (text) => text.replace(/\n$/, "");
function relay(result, out, err) {
  if (result.stdout !== "")
    out(withoutTrailingNewline2(result.stdout));
  if (result.stderr !== "")
    err(withoutTrailingNewline2(result.stderr));
  if (result.timedOut)
    err("claude did not return in time.");
}
function summary(ready) {
  const { brief, mode } = ready;
  const pushes = ready.allowPush ? "pushes ALLOWED on the operator's word" : "pushes blocked";
  return [
    `worker ${brief.name} dispatched · permission mode ${mode} · ${pushes}`,
    ...mode === BYPASS ? ["every tool call the worker makes is pre-approved"] : [],
    `steer: rulings in ${brief.rulings}, then message "${brief.name}" to point at them`,
    `finish: sidekick worker finish ${ready.briefPath}`
  ];
}
var refuse4 = (err, issues) => {
  for (const issue of issues)
    err(issue);
  return 1;
};
function launch2(ready, wenv, out, err) {
  for (const note of ready.notes)
    err(note);
  const excluded = ensureWorktreesExcluded(wenv.runGit, ready.top, ready.commonDir);
  if ("issues" in excluded)
    return refuse4(err, excluded.issues);
  if (excluded.line !== undefined)
    out(excluded.line);
  const args = bgArgs(ready.args, {
    pluginDir: ready.pluginDir,
    permissionMode: ready.mode,
    worktree: ready.brief.name,
    sessionName: ready.brief.name,
    prompt: `/sidekick:sk-worker ${ready.briefPath}`
  });
  const result = wenv.runClaude(args, {
    cwd: ready.top,
    timeoutMs: wenv.launchTimeoutMs ?? LAUNCH_TIMEOUT_MS
  });
  relay(result, out, err);
  if (result.code === 0)
    for (const line of summary(ready))
      out(line);
  return result.code;
}
function dispatch(opts, wenv, out, err) {
  const read = readBrief(opts.brief);
  if ("issues" in read)
    return refuse4(err, read.issues);
  const checked2 = checkDispatch(read.brief, read.path, opts, wenv);
  if ("issues" in checked2)
    return refuse4(err, checked2.issues);
  return launch2(checked2, wenv, out, err);
}

// bin/helpers/worker-finish.ts
import * as fs13 from "node:fs";
import * as path12 from "node:path";
function parseFinishArgs(rest2, cwd) {
  const parsed = parseFlags(rest2, { "no-report": { type: "boolean" } });
  if (parsed === undefined || parsed.positionals.length !== 1)
    return;
  return {
    brief: path12.resolve(cwd, parsed.positionals[0]),
    noReport: parsed.values["no-report"] === true
  };
}
var ENDED_STATES = ["stopped", "done"];
var REMOVED = /^removed\b/;
var DISCARD_LINE = /--discard-unpushed ([0-9a-f]{40})@([0-9a-f]+)/;
var LOCK_PID = /\(pid (\d+)\b/;
function findJob(wenv, top, name) {
  const listed = listJobs(wenv.runClaude, top);
  if ("issues" in listed)
    return listed;
  const matches = listed.jobs.filter((job) => job.name === name);
  if (matches.length === 0) {
    return {
      issues: [
        `no session in ${LISTING} is named "${name}". If finish already removed it, clear any worktree or branch it left by hand; otherwise check the name in the brief`
      ]
    };
  }
  if (matches.length > 1) {
    const which = matches.map((job) => job.id ?? "an interactive session");
    return {
      issues: [
        `${matches.length} sessions in ${LISTING} are named "${name}" (${which.join(", ")}), so finish cannot tell which is the worker: clear the worker by hand with claude rm <id>`
      ]
    };
  }
  const [{ id, state }] = matches;
  if (id === undefined) {
    return {
      issues: [
        `the session named "${name}" is an interactive session, not a worker job: finish clears only a worker that sidekick worker dispatch started`
      ]
    };
  }
  return { id, state };
}
function integratedHead(runGit, top, branch, id) {
  const discard = `discarding it is your call, with claude rm ${id}`;
  const head = commitOf(runGit, top, `refs/heads/${branch}`);
  if (head === undefined) {
    return {
      issues: [
        `the branch ${branch} does not exist, so finish cannot check that the work is integrated: ${discard}`
      ]
    };
  }
  const merge = ["merge-base", "--is-ancestor", head, "HEAD"];
  if (runGit("git", merge, top).code === 0)
    return { head };
  return {
    issues: [
      `${branch} is not integrated: its head ${head} is not in the main checkout's HEAD. Integrate it and run finish again; ${discard}`
    ]
  };
}
function onBranchIssues(runGit, worktree, branch, id) {
  const head = checkedOut(runGit, worktree);
  if (head === `refs/heads/${branch}`)
    return [];
  return [
    `the worktree ${worktree} has ${head} checked out, not ${branch}, so finish cannot check that its commits are integrated: check out ${branch} there and run finish again; discarding it is your call, with claude rm ${id}`
  ];
}
function dirtyIssues(runGit, top, worktree, report) {
  const status = statusPathsIn(runGit, top, worktree);
  if ("issue" in status) {
    return [`git status failed in the worktree ${worktree}: ${status.issue}`];
  }
  const others = status.paths.filter((file) => file !== report);
  if (others.length === 0)
    return [];
  return [
    `the worktree ${worktree} holds uncommitted work besides the report, which its removal would destroy: ${others.join(", ")}. Commit and integrate it, or remove it, then run finish again`
  ];
}
var isMissing3 = (e) => e instanceof Error && ("code" in e) && e.code === "ENOENT";
function readIfPresent(file) {
  try {
    return { data: fs13.readFileSync(file) };
  } catch (e) {
    if (isMissing3(e))
      return { data: undefined };
    const why = e instanceof Error ? e.message : String(e);
    return { issue: `cannot read ${file}: ${why}` };
  }
}
function reportStep(from, to, noReport) {
  const worker = readIfPresent(from);
  if ("issue" in worker)
    return { issues: [worker.issue] };
  if (worker.data === undefined) {
    if (noReport)
      return "none";
    return {
      issues: [
        `the worktree has no run report at ${from}: ask the worker for it, or pass --no-report to finish without one`
      ]
    };
  }
  const saved = readIfPresent(to);
  if ("issue" in saved)
    return { issues: [saved.issue] };
  if (saved.data === undefined)
    return "copy";
  if (saved.data.equals(worker.data))
    return "in place";
  return {
    issues: [
      `${to} already exists and differs from the worker's report at ${from}: move one aside, then run finish again`
    ]
  };
}
function checkFinish(brief, opts, wenv) {
  const checkout = mainCheckout(wenv.runGit, wenv.cwd);
  if ("issues" in checkout)
    return checkout;
  const { top, commonDir } = checkout;
  const job = findJob(wenv, top, brief.name);
  if ("issues" in job)
    return job;
  const worktree = path12.join(top, WORKTREES_FOLDER, brief.name);
  const branch = `worktree-${brief.name}`;
  const report = path12.posix.normalize(brief.report);
  const reportFrom = path12.join(worktree, report);
  const reportTo = path12.join(top, report);
  const integrated = integratedHead(wenv.runGit, top, branch, job.id);
  const worktreeIssues = [
    ...onBranchIssues(wenv.runGit, worktree, branch, job.id),
    ...dirtyIssues(wenv.runGit, top, worktree, report)
  ];
  const step = reportStep(reportFrom, reportTo, opts.noReport);
  if ("issues" in integrated || worktreeIssues.length > 0 || typeof step !== "string") {
    return {
      issues: [
        ..."issues" in integrated ? integrated.issues : [],
        ...worktreeIssues,
        ...typeof step === "string" ? [] : step.issues
      ]
    };
  }
  return {
    ...job,
    name: brief.name,
    top,
    commonDir,
    worktree,
    branch,
    head: integrated.head,
    report,
    reportFrom,
    reportTo,
    reportStep: step
  };
}
function copyReport(ready, out) {
  try {
    fs13.mkdirSync(path12.dirname(ready.reportTo), { recursive: true });
    fs13.copyFileSync(ready.reportFrom, ready.reportTo, fs13.constants.COPYFILE_EXCL);
  } catch (e) {
    const why = e instanceof Error ? e.message : String(e);
    return [`cannot save the report to ${ready.reportTo}: ${why}`];
  }
  out(`report saved to ${ready.reportTo}`);
  return [];
}
var saveReport = (ready, _wenv, out) => {
  switch (ready.reportStep) {
    case "copy":
      return copyReport(ready, out);
    case "in place":
      out(`report already at ${ready.reportTo}`);
      return [];
    case "none":
      out("no report to save: the worktree holds none");
      return [];
    default: {
      const unhandled = ready.reportStep;
      throw new Error(`unhandled report step: ${unhandled}`);
    }
  }
};
var claudeAt = (ready, wenv, args, timeoutMs = 30000) => wenv.runClaude(args, { cwd: ready.top, timeoutMs });
function withText(lead, result) {
  const text = printedStreams(result);
  return text.length > 0 ? [`${lead}:`, ...text] : [lead];
}
var ranClean = (result) => result.code === 0 && !result.timedOut;
var failure = (result) => result.timedOut ? "did not return in time" : `failed with exit code ${result.code}`;
var stopJob = (ready, wenv) => {
  if (ready.state !== undefined && ENDED_STATES.includes(ready.state)) {
    return [];
  }
  const args = ["stop", ready.id];
  const result = claudeAt(ready, wenv, args);
  if (ranClean(result))
    return [];
  return withText(`claude ${args.join(" ")} ${failure(result)}, so finish stopped before claude rm`, result);
};
function lockPid(commonDir, name) {
  const lock = readIfPresent(path12.join(commonDir, "worktrees", name, "locked"));
  if ("issue" in lock || lock.data === undefined)
    return;
  const pid = Number(LOCK_PID.exec(lock.data.toString())?.[1]);
  return Number.isSafeInteger(pid) && pid > 0 ? pid : undefined;
}
function waitForExit(pid, wenv, limitMs = 15000, pollMs = 250) {
  for (let waited = 0;wenv.isAlive(pid); waited += pollMs) {
    if (waited >= limitMs) {
      return [
        `the worktree's lock still names a running process, pid ${pid}, after ${limitMs / 1000} s: run finish again once it exits`
      ];
    }
    wenv.sleep(pollMs);
  }
  return [];
}
var waitForLock = (ready, wenv) => {
  const pid = lockPid(ready.commonDir, ready.name);
  return pid === undefined ? [] : waitForExit(pid, wenv);
};
function reportChangedIssues(ready) {
  const now = readIfPresent(ready.reportFrom);
  if ("issue" in now)
    return [now.issue];
  if (ready.reportStep === "none") {
    if (now.data === undefined)
      return [];
    return [`a run report appeared at ${ready.reportFrom}`];
  }
  const saved = readIfPresent(ready.reportTo);
  if ("issue" in saved)
    return [saved.issue];
  const same = now.data !== undefined && saved.data !== undefined && now.data.equals(saved.data);
  if (same)
    return [];
  return [
    `the worker's report at ${ready.reportFrom} no longer matches the copy at ${ready.reportTo}`
  ];
}
function headMovedIssues(runGit, ready) {
  const now = commitOf(runGit, ready.top, `refs/heads/${ready.branch}`);
  if (now === ready.head)
    return [];
  if (now === undefined) {
    return [
      `the branch ${ready.branch} is gone, so finish cannot confirm its head is still ${ready.head}, the head it verified as integrated`
    ];
  }
  return [
    `${ready.branch} moved to ${now} after finish verified its head ${ready.head} as integrated: integrate the new commits, then run finish again`
  ];
}
var recheckWorktree = (ready, wenv) => {
  const issues = [
    ...onBranchIssues(wenv.runGit, ready.worktree, ready.branch, ready.id),
    ...headMovedIssues(wenv.runGit, ready),
    ...dirtyIssues(wenv.runGit, ready.top, ready.worktree, ready.report),
    ...reportChangedIssues(ready)
  ];
  if (issues.length === 0)
    return [];
  return [
    "the worktree changed after finish checked it, so finish removed nothing:",
    ...issues
  ];
};
var saidRemoved = (result) => ranClean(result) && REMOVED.test(printedStreams(result).join(`
`));
function unknownAnswer(args, result) {
  const what = ranClean(result) ? "did not say removed, and finish does not know its answer" : failure(result);
  return withText(`claude ${args.join(" ")} ${what}, so finish removed nothing more`, result);
}
function discard(ready, wenv, kept) {
  const text = printedStreams(kept).join(`
`);
  const offer = ranClean(kept) ? DISCARD_LINE.exec(text) : null;
  if (offer === null)
    return unknownAnswer(["rm", ready.id], kept);
  const [, sha, worktreeId] = offer;
  if (sha !== ready.head) {
    return withText(`claude rm offers to discard ${sha}, which is not ${ready.branch}'s verified head (${ready.head}), so finish did not run it`, kept);
  }
  const args = ["rm", ready.id, "--discard-unpushed", `${sha}@${worktreeId}`];
  const result = claudeAt(ready, wenv, args);
  return saidRemoved(result) ? [] : unknownAnswer(args, result);
}
var removeSession = (ready, wenv, out) => {
  const first = claudeAt(ready, wenv, ["rm", ready.id]);
  const issues = saidRemoved(first) ? [] : discard(ready, wenv, first);
  if (issues.length > 0)
    return issues;
  out(`session ${ready.id} removed`);
  return [];
};
function worktreeGoneIssues(runGit, top, worktree) {
  const list2 = runGit("git", ["worktree", "list", "--porcelain"], top);
  if (list2.code !== 0) {
    return [
      `git worktree list failed, so finish cannot confirm the worktree is gone: ${list2.stderr.trim()}`
    ];
  }
  const listed = list2.stdout.split(`
`).includes(`worktree ${worktree}`);
  return listed ? [`claude rm said removed, but git still lists the worktree ${worktree}`] : [];
}
function branchGoneIssues(runGit, top, branch) {
  if (!branchExists(runGit, top, branch))
    return [];
  const result = runGit("git", ["branch", "-d", branch], top);
  if (result.code === 0)
    return [];
  return [`git branch -d ${branch} failed: ${result.stderr.trim()}`];
}
var removeLeftovers = (ready, wenv, out) => {
  const worktree = worktreeGoneIssues(wenv.runGit, ready.top, ready.worktree);
  if (worktree.length > 0)
    return worktree;
  out(`worktree ${ready.worktree} removed`);
  const branch = branchGoneIssues(wenv.runGit, ready.top, ready.branch);
  if (branch.length > 0)
    return branch;
  out(`branch ${ready.branch} removed`);
  return [];
};
var STEPS = [
  saveReport,
  stopJob,
  waitForLock,
  recheckWorktree,
  removeSession,
  removeLeftovers
];
function finishIssues(opts, wenv, out) {
  const read = readBrief(opts.brief);
  if ("issues" in read)
    return read.issues;
  const ready = checkFinish(read.brief, opts, wenv);
  if ("issues" in ready)
    return ready.issues;
  for (const step of STEPS) {
    const issues = step(ready, wenv, out);
    if (issues.length > 0)
      return issues;
  }
  return [];
}
function finish(opts, wenv, out, err) {
  const issues = finishIssues(opts, wenv, out);
  for (const issue of issues)
    err(issue);
  return issues.length === 0 ? 0 : 1;
}

// bin/helpers/worker.ts
var WORKER_USAGE_LINE = "sidekick worker dispatch <brief> --permission-mode <mode> [--profile <name>] [--plugin-dir <dir>] [--allow-push] | finish <brief> [--no-report]";
var usage2 = (err) => {
  err(`usage: ${WORKER_USAGE_LINE}`);
  return 1;
};
var dispatchVerb = (rest2, wenv, out, err) => {
  const opts = parseDispatchArgs(rest2, wenv.cwd);
  return opts === undefined ? usage2(err) : dispatch(opts, wenv, out, err);
};
var finishVerb = (rest2, wenv, out, err) => {
  const opts = parseFinishArgs(rest2, wenv.cwd);
  return opts === undefined ? usage2(err) : finish(opts, wenv, out, err);
};
var VERBS4 = {
  dispatch: dispatchVerb,
  finish: finishVerb
};
function runWorkerCli(args, wenv, out, err) {
  const [name, ...rest2] = args;
  if (name === undefined || !Object.hasOwn(VERBS4, name))
    return usage2(err);
  return VERBS4[name](rest2, wenv, out, err);
}
function sleepSync(ms) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}
function processIsAlive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (e) {
    return !(e instanceof Error && ("code" in e) && e.code === "ESRCH");
  }
}

// bin/cli.ts
function resolvePluginDir(entryFileUrl) {
  const here = path13.dirname(fileURLToPath(entryFileUrl));
  const candidates = [
    path13.resolve(here, ".."),
    path13.resolve(here, "..", "plugin")
  ];
  for (const c of candidates) {
    if (fs14.existsSync(path13.join(c, "rules")))
      return c;
  }
  return candidates[0];
}
var ManifestVersion = object({ version: string() });
function readVersion(pluginDir) {
  const manifest = path13.join(pluginDir, ".claude-plugin", "plugin.json");
  try {
    const parsed = safeParse(ManifestVersion, JSON.parse(fs14.readFileSync(manifest, "utf-8")));
    return parsed.success ? parsed.output.version : "unknown";
  } catch {
    return "unknown";
  }
}
function isMainEntrypoint(importMetaUrl, argv1) {
  if (!argv1)
    return false;
  try {
    return realpathSync4(fileURLToPath(importMetaUrl)) === realpathSync4(argv1);
  } catch {
    return false;
  }
}
var USAGE2 = `usage: sidekick rules <install|check> --project|--user [--strict]
       ${PM_USAGE_LINE}
       ${HOOK_USAGE_LINE}
       ${PROFILE_USAGE_LINE}
       ${WORKER_USAGE_LINE}
       sidekick --version`;
function writeStdout(chunk) {
  const buffer = Buffer.from(chunk);
  for (let offset = 0;offset < buffer.length; ) {
    try {
      offset += fs14.writeSync(1, buffer, offset);
    } catch (e) {
      if (!(e instanceof Error && ("code" in e) && e.code === "EAGAIN"))
        throw e;
    }
  }
}
var profileEnvOf = (ctx) => ({
  env: ctx.env,
  cwd: ctx.cwd,
  home: ctx.env.HOME || os.homedir(),
  workTree: workTreeRootOf(ctx.cwd),
  tmpdir: ctx.tmpdir ?? os.tmpdir(),
  runClaude: ctx.runClaude ?? execClaude,
  write: ctx.write ?? writeStdout
});
function readProcessStdin() {
  try {
    return fs14.readFileSync(0, "utf-8");
  } catch {
    return "";
  }
}
function main(argv2, ctx, out, err) {
  const [sub, ...rest2] = argv2;
  const pluginDir = resolvePluginDir(ctx.entryFileUrl);
  if (sub === "--version") {
    out(readVersion(pluginDir));
    return 0;
  }
  if (sub === "pm")
    return runPmCli(rest2, { cwd: ctx.cwd }, out, err);
  if (sub === "hook") {
    const readStdin = ctx.readStdin ?? readProcessStdin;
    return runHookCli(rest2, { readStdin, pluginDir, env: ctx.env, tmpdir: ctx.tmpdir ?? os.tmpdir() }, out, err);
  }
  if (sub === "profile") {
    return runProfileCli(rest2, profileEnvOf(ctx), out, err);
  }
  if (sub === "worker") {
    return runWorkerCli(rest2, {
      ...profileEnvOf(ctx),
      runGit: execRunner,
      sleep: sleepSync,
      isAlive: processIsAlive
    }, out, err);
  }
  if (sub !== "rules") {
    err(USAGE2);
    return 1;
  }
  const claudeHome = ctx.env.CLAUDE_CONFIG_DIR || path13.join(os.homedir(), ".claude");
  const src = ctx.env.SIDEKICK_RULES_DIR || path13.join(pluginDir, "rules");
  return runRulesCli(rest2, { src, cwd: ctx.cwd, claudeHome }, out);
}
var _importMetaMain = "main" in import.meta && typeof __require.main == __require.module === "boolean" ? __require.main == __require.module : undefined;
var _isEntry = _importMetaMain ?? isMainEntrypoint(import.meta.url, process.argv[1]);
if (_isEntry) {
  process.exit(main(process.argv.slice(2), { env: process.env, cwd: process.cwd(), entryFileUrl: import.meta.url }, (l) => console.log(l), (l) => console.error(l)));
}
export {
  resolvePluginDir,
  readVersion,
  main,
  isMainEntrypoint,
  USAGE2 as USAGE
};

