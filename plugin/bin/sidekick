var HOOK_USAGE_LINE = "sidekick hook post-skill|post-read|post-tool-batch   (reads the hook event on stdin)";
function readContent(event) {
  const response = event.tool_response;
  if (!isRecord2(response) || !isRecord2(response.file))
    return "";
  return typeof response.file.content === "string" ? response.file.content : "";
}
var DESIGN_SKILL = path2.join("skills", "sk-design", "SKILL.md");
var EXECUTE_SKILL = path2.join("skills", "sk-execute", "SKILL.md");
var PLAN_SECTIONS = [
  "## A plan carries intent",
  "## Before the plan goes out",
  "## Choose the mode"
];
var CLEAN_CODE_RULE = path2.join("rules", "sk-clean-code.md");
var COMMENTS_HEADING = "## Comments";
var DESCRIPTION_LINE = /^description:\s*(".*")\s*$/;
var REVIEW_PACKAGE = /(^|\/)\.superpowers\/sdd\/[^/]+\/review-[0-9a-f]+\.\.[0-9a-f]+\.diff$/;
var RELEASE_CHECK_PACKAGE = /(^|\/)\.superpowers\/sdd\/release-check-[^/]+\/review-[0-9a-f]+\.\.[0-9a-f]+\.diff$/;
var isRecord2 = (v) => typeof v === "object" && v !== null;
function isSkillHookInput(v) {
  if (!isRecord2(v))
    return false;
  const input = v.tool_input;
  return isRecord2(input) && typeof input.skill === "string";
}
function isReadHookInput(v) {
  if (!isRecord2(v) || v.tool_name !== "Read")
    return false;
  const input = v.tool_input;
  return isRecord2(input) && typeof input.file_path === "string";
}
function parseJson(raw) {
  try {
    return JSON.parse(raw);
  } catch {
    return;
  }
}
function readText(file) {
  try {
    return fs2.readFileSync(file, "utf-8");
  } catch {
    return;
  }
}
function readSkillDescription(skillFile) {
  const text = readText(skillFile);
  if (text === undefined)
    return;
  const lines = text.split(`
`);
  if (lines[0].trim() !== "---")
    return;
  const close = lines.findIndex((line, i) => i > 0 && line.trim() === "---");
  if (close < 0)
    return;
  const match = lines.slice(1, close).map((line) => DESCRIPTION_LINE.exec(line)).find((m) => m !== null);
  if (!match)
    return;
  const value = parseJson(match[1]);
  return typeof value === "string" ? value : undefined;
}
function readSection(file, heading) {
  const text = readText(file);
  if (text === undefined)
    return;
  const lines = text.split(/\r?\n/);
  const start = lines.findIndex((line) => line.trimEnd() === heading);
  if (start < 0)
    return;
  const rest = lines.slice(start + 1);
  let fenced = false;
  const next = rest.findIndex((line) => {
    if (line.trimStart().startsWith("```"))
      fenced = !fenced;
    return !fenced && line.startsWith("## ");
  });
  const body = next < 0 ? rest : rest.slice(0, next);
  return [lines[start], ...body].join(`
`).trim();
}
function readRulePaths(file) {
  const text = readText(file);
  if (text === undefined)
    return;
  const lines = text.split(/\r?\n/);
  if (lines[0].trim() !== "---")
    return;
  const close = lines.findIndex((line, i) => i > 0 && line.trim() === "---");
  if (close < 0)
    return;
  const front = lines.slice(1, close);
  const key = front.findIndex((line) => line.trimEnd() === "paths:");
  if (key < 0)
    return;
  const globs = [];
  for (const line of front.slice(key + 1)) {
    const item = /^\s+-\s+["']?(.*?)["']?\s*$/.exec(line);
    if (item === null)
      break;
    globs.push(item[1]);
  }
  return globs.length === 0 ? undefined : globs;
}
var EXT_GLOB = /^\*\*\/\*(\.[A-Za-z0-9]+)$/;
var STAT_LINE = /^\s*(\S.*?)\s+\|\s+(?:\d+|Bin)\b/;
var DIFF_HEADER = /^diff --git a\/(.+) b\//;
function visiblePaths(content) {
  const found = [];
  for (const line of content.split(/\r?\n/)) {
    const match = STAT_LINE.exec(line) ?? DIFF_HEADER.exec(line);
    if (match !== null)
      found.push(match[1]);
  }
  return found;
}
function ruleCoversPackage(rulePaths, content) {
  if (rulePaths === undefined)
    return true;
  const exts = [];
  for (const glob of rulePaths) {
    const match = EXT_GLOB.exec(glob);
    if (match === null)
      return true;
    exts.push(match[1]);
  }
  return visiblePaths(content).some((p) => exts.some((ext) => p.endsWith(ext)));
}
function brainstormNudge(pluginDir) {
  const description = readSkillDescription(path2.join(pluginDir, DESIGN_SKILL));
  if (description === undefined)
    return;
  return [
    "sidekick: before this brainstorm proposes approaches, check whether the change needs a design pass.",
    `sidekick:sk-design: ${description}`,
    "If it applies, run it now, or at the approaches step, which it then does itself.",
    "If a design note for this change already exists, start from it."
  ].join(" ");
}
var PLAN_LEAD = "sidekick: `sk-execute` governs how this plan is written and handed off, and it overrides parts of this skill. A plan carries intent, and code in it is a sketch, so the complete-code rule and the placeholder scan give way where they conflict. At the handoff, its modes and one recommendation replace this skill's two-option question, and the claim that native execution runs well on a mid-tier model does not carry over. Write the plan to the first two of these sections of `sk-execute`, and hand it off by the third:";
function writingPlansNudge(pluginDir) {
  const file = path2.join(pluginDir, EXECUTE_SKILL);
  const sections = PLAN_SECTIONS.map((heading) => readSection(file, heading));
  const found = sections.flatMap((s) => s === undefined ? [] : [s]);
  if (found.length < PLAN_SECTIONS.length)
    return;
  return [PLAN_LEAD, ...found].join(`

`);
}
var NUDGES = new Map([
  ["superpowers:brainstorming", brainstormNudge],
  ["superpowers:writing-plans", writingPlansNudge]
]);
var READ_LEAD_LINE = "sidekick: this file is a superpowers review package, so sidekick's reviewer rules hold for this review alongside superpowers' reviewer instructions.";
var REPRODUCE_PARAGRAPH = "Reproduce what the implementer claims. For each check the implementer reports as passing, other than the test suite, re-run it where it runs read-only in this checkout: a prose check, a search, or a count. Credit only the results you reproduce. This departs from superpowers' rule that a task reviewer runs checks only on a specific doubt; the test suite stays exempt, as superpowers rules.";
var CLAIMS_PARAGRAPH = "Check what the diff says about the rest of the system. Where superpowers limits you to risks you can name outside the diff, two kinds count here. A sentence the diff adds that states a fact is one: a count, a path, a list someone will decide on, how a part behaves. Find the fact's source and confirm it there. A fact the diff changes is a cross-cutting change, and its other copies are its call sites. Search for them with `git grep`, read the block each one sits in, and report each copy left stale. A true statement the diff deletes is a finding unless the change made it false. Report a claim you cannot trace to a source as a finding.";
var RELEASE_LEAD_LINE = "sidekick: this file is the package of sk-milestone's release check, so sidekick's reviewer lines hold for this review beside the prompt you were given.";
var RELEASE_CLAIMS_PARAGRAPH = "Check what the diff says about the rest of the system. Two kinds of finding count. A sentence the diff adds that states a fact is one: a count, a path, a list someone will decide on, how a part behaves. Find the fact's source and confirm it there. A fact the diff changes is a cross-cutting change, and its other copies are its call sites. Search for them with your search tool, read the block each one sits in, and report each copy left stale. A true statement the diff deletes is a finding unless the change made it false. Report a claim you cannot trace to a source as a finding.";
function commentsLines(pluginDir, packageText) {
  const rule = path2.join(pluginDir, CLEAN_CODE_RULE);
  const comments = readSection(rule, COMMENTS_HEADING);
  if (comments === undefined || !ruleCoversPackage(readRulePaths(rule), packageText)) {
    return [];
  }
  return [
    "Hold the comments this diff adds to the house rule. Reading a diff does not load `sk-clean-code.md`, so its Comments section follows. Report each added comment that breaks it as a finding. Where this repo's own rules set a different comment convention, theirs win.",
    comments
  ];
}
function reviewerLines(pluginDir, packageText) {
  return [
    READ_LEAD_LINE,
    REPRODUCE_PARAGRAPH,
    CLAIMS_PARAGRAPH,
    ...commentsLines(pluginDir, packageText)
  ].join(`

`);
}
function releaseReviewerLines(pluginDir, packageText) {
  return [
    RELEASE_LEAD_LINE,
    RELEASE_CLAIMS_PARAGRAPH,
    ...commentsLines(pluginDir, packageText)
  ].join(`

`);
}
function postSkillContext(stdin, env) {
  const event = parseJson(stdin);
  if (!isSkillHookInput(event))
    return;
  const nudge = NUDGES.get(event.tool_input.skill);
  return nudge === undefined ? undefined : nudge(env.pluginDir);
}
function postReadContext(stdin, env) {
  const { pluginDir } = env;
  const event = parseJson(stdin);
  if (!isReadHookInput(event))
    return;
  const filePath = event.tool_input.file_path;
  if (RELEASE_CHECK_PACKAGE.test(filePath)) {
    return releaseReviewerLines(pluginDir, readContent(event));
  }
  if (!REVIEW_PACKAGE.test(filePath))
    return;
  return reviewerLines(pluginDir, readContent(event));
}
var VERBS = new Map([
  ["post-skill", { eventName: "PostToolUse", contextFor: postSkillContext }],
  ["post-read", { eventName: "PostToolUse", contextFor: postReadContext }],
  [
    "post-tool-batch",
    {
      eventName: "PostToolBatch",
      contextFor: (stdin, env) => postToolBatchContext(stdin, { env: env.env, tmpdir: env.tmpdir })
    }
  ]
]);
function runHookCli(args, env, out, err) {
  const [verb] = args;
  const entry = verb === undefined ? undefined : VERBS.get(verb);
  if (entry === undefined) {
    err(`usage: ${HOOK_USAGE_LINE}`);
    return 1;
  }
  const context = entry.contextFor(env.readStdin(), env);
  if (context === undefined)
    return 0;
  out(JSON.stringify({
    hookSpecificOutput: {
      hookEventName: entry.eventName,
      additionalContext: context
    }
  }));
  return 0;
}

// bin/helpers/pm-plans.ts
var HEADER_OPEN = "<!-- plans -->";
var HEADER_CLOSE = "<!-- /plans -->";
var LINE = /^\s*\d+\.(?!\d)\s*(.*)$/;
var GROUP = /^\s*([^();\s][^();]*?)\s*\(\s*(#\d+(?:\s*,\s*#\d+)*)\s*\)\s*$/;
var normalise = (text) => text.replace(/\r\n?/g, `
`);
var oneLine = (text) => text.replace(/\s+/g, " ").trim();
var isMarker = (line) => line.trim() === HEADER_OPEN || line.trim() === HEADER_CLOSE;
function locate(description) {
  const lines = normalise(description).split(`
`);
  const first = lines.findIndex((l) => l.trim() !== "");
  if (first < 0 || lines[first].trim() !== HEADER_OPEN) {
    return lines.some(isMarker) ? { at: "elsewhere" } : { at: "none" };
  }
  const close = lines.findIndex((l, k) => k > first && l.trim() === HEADER_CLOSE);
  if (close < 0)
    return { at: "unclosed" };
  return {
    at: "top",
    lines: lines.slice(first + 1, close),
    prose: lines.slice(close + 1)
  };
}
var malformed = (reason) => ({
  parse: "malformed",
  reason: oneLine(reason)
});
function duplicate(plans) {
  const names = plans.map((p) => p.name);
  const name = names.find((n, i) => names.indexOf(n) !== i);
  if (name !== undefined)
    return `plan "${name}" appears twice`;
  const issues = plans.flatMap((p) => p.issues);
  const issue = issues.find((n, i) => issues.indexOf(n) !== i);
  return issue === undefined ? null : `#${issue} appears in two plans`;
}
function parsePlansHeader(description) {
  const found = locate(description);
  if (found.at === "none")
    return { parse: "none" };
  if (found.at === "elsewhere") {
    return malformed("the plans header is not at the top");
  }
  if (found.at === "unclosed") {
    return malformed(`the plans header has no ${HEADER_CLOSE} line`);
  }
  if (found.prose.some(isMarker)) {
    return malformed("a second plans header follows the first");
  }
  const plans = [];
  for (const line of found.lines.filter((l) => l.trim() !== "")) {
    const numbered = LINE.exec(line);
    const group = numbered === null ? null : GROUP.exec(numbered[1]);
    if (group === null) {
      return malformed(`"${line.trim()}" is not <n>. <name> (#N, …)`);
    }
    plans.push({
      name: oneLine(group[1]),
      issues: group[2].split(",").map((r) => Number(r.trim().slice(1)))
    });
  }
  if (plans.length === 0)
    return malformed("the plans header lists no plans");
  const reason = duplicate(plans);
  return reason === null ? { parse: "ok", plans } : malformed(reason);
}
function descriptionProse(description) {
  const found = locate(description);
  return found.at === "top" ? found.prose.join(`
`) : normalise(description);
}
var openOf = (issues) => issues.filter((i) => i.open);
var inProgress = (i) => i.status === "In Progress";
var notStarted = (i) => i.status === "Backlog" || i.status === null;
function startable(issues) {
  const open = openOf(issues);
  return open.length > 0 && !open.some(inProgress) && open.some(notStarted);
}
function stateOf(issues, isNext) {
  const open = openOf(issues);
  if (open.length === 0)
    return "done";
  if (open.some(inProgress))
    return "running";
  if (isNext)
    return "next";
  return "later";
}
function planView(ms, items) {
  const c = parsePlansHeader(ms.description);
  if (c.parse === "none")
    return { parse: "none", list: [], unplanned: [] };
  if (c.parse === "malformed") {
    return { parse: "malformed", reason: c.reason, list: [], unplanned: [] };
  }
  const byNumber = new Map(items.map((i) => [i.number, i]));
  const issueOf = (n) => {
    const i = byNumber.get(n);
    return i ? {
      number: n,
      title: i.title,
      open: i.state === "OPEN",
      status: i.status
    } : { number: n, title: null, open: true, status: null };
  };
  const issues = c.plans.map((p) => p.issues.map(issueOf));
  const nextAt = issues.findIndex(startable);
  const list = c.plans.map((p, k) => ({
    name: p.name,
    state: stateOf(issues[k], k === nextAt),
    issues: issues[k]
  }));
  const planned = new Set(c.plans.flatMap((p) => p.issues));
  const unplanned = items.filter((i) => i.state === "OPEN" && i.milestone === ms.title && !planned.has(i.number)).sort((a, b) => a.number - b.number).map((i) => ({ number: i.number, title: i.title }));
  return { parse: "ok", list, unplanned };
}

// bin/helpers/pm-brief.ts
var TITLE_MAX = 60;
var PER_TIER_MAX = 5;
function cut(title) {
  return title.length > TITLE_MAX ? `${title.slice(0, TITLE_MAX - 1)}…` : title;
}
function firstSentence(text) {
  const t = text.replace(/\s+/g, " ").trim();
  const m = /^(.*?[.!?])(?:\s|$)/.exec(t);
  return m ? m[1] : t;
}
var titles = (list) => list.map((m) => cut(m.title)).join(", ");
function ref(i) {
  return `#${i.number} ${cut(i.title)}`;
}
function tierBody(tier, candidates) {
  const mine = candidates.filter((c) => c.tier === tier);
  if (mine.length === 0)
    return null;
  const shown = mine.slice(0, PER_TIER_MAX).map(ref).join("; ");
  const more = mine.length > PER_TIER_MAX ? ` +${mine.length - PER_TIER_MAX} more` : "";
  return `${shown}${more}`;
}
function tierLine(tier, candidates) {
  const body = tierBody(tier, candidates);
  return body === null ? null : `tier ${tier} ${body}`;
}
function parsedPlans(p) {
  if (p.plans === null || p.plans.parse !== "ok")
    return null;
  return { list: p.plans.list, unplanned: p.plans.unplanned };
}
var openRefs = (plan) => plan.issues.filter((i) => i.open).map((i) => `#${i.number}`).join(", ");
var plannedNumbers = (list) => new Set(list.flatMap((pl) => pl.issues.map((i) => i.number)));
function continueMove(cards, plans) {
  const lowest = Math.min(...cards.map((i) => i.number));
  const plan = plans === null ? undefined : plans.list.find((pl) => pl.issues.some((i) => i.number === lowest));
  return plan === undefined ? `continue #${lowest}` : `continue plan ${plan.name} (${openRefs(plan)})`;
}
function pullMove(p, plans) {
  if (plans === null) {
    return p.candidates.some((c) => c.tier === 1) ? "pull one tier-1 candidate" : null;
  }
  const next = plans.list.find((pl) => pl.state === "next");
  if (next !== undefined)
    return `pull plan ${next.name} (${openRefs(next)})`;
  const planned = plannedNumbers(plans.list);
  const unplanned = p.candidates.some((c) => c.tier === 1 && !planned.has(c.number));
  return unplanned ? "pull one unplanned candidate" : null;
}
function nextMove(p) {
  if (p.milestone === null && p.open_milestones.length > 1) {
    return `choose a milestone: ${titles(p.open_milestones)}`;
  }
  const plans = parsedPlans(p);
  if (p.in_progress.length > 0)
    return continueMove(p.in_progress, plans);
  const pull = pullMove(p, plans);
  if (pull !== null)
    return pull;
  if (p.milestone)
    return "nothing to pick up: verify, then close the milestone";
  return "nothing open: open the next milestone";
}
var card = (i) => `#${i.number} (${i.age_days} d)`;
var titledCard = (i) => `${ref(i)} (${i.age_days} d)`;
function inProgressLine(p, plans) {
  if (p.in_progress.length === 0)
    return "in progress: none";
  if (plans === null) {
    return `in progress: ${p.in_progress.map(titledCard).join(", ")}`;
  }
  const byNumber = new Map(p.in_progress.map((i) => [i.number, i]));
  const grouped = plans.list.flatMap((pl) => {
    const cards = pl.issues.flatMap((i) => byNumber.get(i.number) ?? []);
    return cards.length === 0 ? [] : [`plan ${cut(pl.name)}: ${cards.map(card).join(", ")}`];
  });
  const planned = plannedNumbers(plans.list);
  const loose = p.in_progress.filter((i) => !planned.has(i.number)).map(titledCard);
  return `in progress: ${[...grouped, ...loose].join(" · ")}`;
}
function doneSegment(count) {
  if (count === 0)
    return null;
  return count === 1 ? "1 plan done" : `${count} plans done`;
}
function planCandidatesLine(p, plans) {
  const inState = (state) => plans.list.filter((pl) => pl.state === state);
  const next = plans.list.find((pl) => pl.state === "next");
  const later = inState("later");
  const openCount = (pl) => pl.issues.filter((i) => i.open).length;
  const running = new Set(p.in_progress.map((i) => i.number));
  const unplanned = plans.unplanned.filter((i) => !running.has(i.number)).map((i) => `#${i.number}`).join(", ");
  const segments = [
    next === undefined ? null : `next plan ${cut(next.name)} (${openRefs(next)})`,
    later.length === 0 ? null : `then ${later.map((pl) => `${cut(pl.name)} (${openCount(pl)})`).join(", ")}`,
    doneSegment(inState("done").length),
    `unplanned: ${unplanned === "" ? "none" : unplanned}`,
    `tier 2: ${tierBody(2, p.candidates) ?? "none"}`
  ];
  return `candidates: ${segments.filter((s) => s !== null).join(" · ")}`;
}
function candidatesLine(p, plans) {
  if (plans !== null)
    return planCandidatesLine(p, plans);
  const tiers = [tierLine(1, p.candidates), tierLine(2, p.candidates)].filter((t) => t !== null);
  const order = p.candidates.length > 1 ? " (order: number, not priority)" : "";
  return tiers.length > 0 ? `candidates: ${tiers.join(" · ")}${order}` : "candidates: none";
}
function milestoneLine(p) {
  const m = p.milestone;
  if (m === null) {
    return p.open_milestones.length === 0 ? "milestone: none" : `milestone: none active · open: ${titles(p.open_milestones)}`;
  }
  const outcome = firstSentence(descriptionProse(m.description));
  const others = p.open_milestones.filter((o) => o.number !== m.number);
  const c = p.issue_counts;
  const counts = c === null ? "" : ` (${c.open} open, ${c.closed} closed)`;
  return [
    `milestone: ${m.title}${counts}`,
    ...outcome ? [outcome] : [],
    ...others.length > 0 ? [`also open: ${titles(others)}`] : []
  ].join(" · ");
}
function renderBrief(p) {
  const lines = [];
  lines.push(`sidekick · ${p.board.owner}/${p.board.repo} · board #${p.board.project.number}`);
  lines.push(milestoneLine(p));
  const plans = parsedPlans(p);
  lines.push(inProgressLine(p, plans));
  lines.push(candidatesLine(p, plans));
  const drift = [];
  const unpushed = p.drift.unpushed.count;
  if (unpushed !== null && unpushed > 0)
    drift.push(`${unpushed} unpushed`);
  if (p.drift.stale_in_progress.length > 0) {
    drift.push(`stale: ${p.drift.stale_in_progress.map((i) => `#${i.number} (${i.age_days} d)`).join(", ")}`);
  }
  if (p.drift.open_pr)
    drift.push(`open PR #${p.drift.open_pr.number}`);
  if (p.drift.in_progress_split.length > 0) {
    drift.push(`In Progress split: ${p.drift.in_progress_split.map(cut).join(", ")}`);
  }
  if (p.plans !== null && p.plans.parse === "malformed") {
    drift.push(`plans header: ${p.plans.reason}`);
  }
  lines.push(drift.length > 0 ? `drift: ${drift.join(" · ")}` : "drift: none");
  lines.push(`next: ${nextMove(p)}`);
  return lines.join(`
`);
}

// bin/helpers/pm-data.ts
import { spawnSync } from "node:child_process";
var execRunner = (cmd, args, cwd) => {
  const r = spawnSync(cmd, args, {
    cwd,
    encoding: "utf-8",
    stdio: ["ignore", "pipe", "pipe"]
  });
  if (r.error)
    return { code: 127, stdout: "", stderr: r.error.message };
  return {
    code: r.status ?? 1,
    stdout: r.stdout ?? "",
    stderr: r.stderr ?? ""
  };
};

class PmError extends Error {
  exit;
  constructor(exit, message) {
    super(message);
    this.exit = exit;
  }
}
var ORIGIN = /^(?:git@github\.com:|https:\/\/github\.com\/)([^/\s]+)\/([^/\s]+?)(?:\.git)?\/?$/;
function parseOrigin(url) {
  const m = url.trim().match(ORIGIN);
  return m ? { owner: m[1], repo: m[2] } : null;
}
function parseGhVersion(firstLine) {
  const m = firstLine.match(/^gh version (\d+\.\d+\.\d+)/);
  return m ? m[1] : null;
}
function versionAtLeast(v, min) {
  const a = v.split(".").map(Number);
  const b = min.split(".").map(Number);
  for (let i = 0;i < 3; i++) {
    const x = a[i] ?? 0;
    const y = b[i] ?? 0;
    if (x !== y)
      return x > y;
  }
  return true;
}
function hasProjectScope(headers) {
  const line = headers.split(/\r?\n/).find((l) => /^x-oauth-scopes:/i.test(l));
  if (!line)
    return false;
  return line.slice(line.indexOf(":") + 1).split(",").map((s) => s.trim()).includes("project");
}
function ageDays(iso, now) {
  return Math.floor((now.getTime() - new Date(iso).getTime()) / 86400000);
}
function touchedAt(item) {
  const { updatedAt, statusUpdatedAt } = item;
  if (statusUpdatedAt === null)
    return updatedAt;
  return Date.parse(statusUpdatedAt) > Date.parse(updatedAt) ? statusUpdatedAt : updatedAt;
}
var STALE_DAYS = 7;
var DISCOVERY_QUERY = "query Discovery($owner: String!, $name: String!) { viewer { login } repository(owner: $owner, name: $name) { projectsV2(first: 10) { nodes { number title closed url id owner { __typename ... on User { login } ... on Organization { login } } } } } }";
var FIELD_QUERY = 'query StatusField($login: String!, $number: Int!) { user(login: $login) { projectV2(number: $number) { id title url createdAt field(name: "Status") { ... on ProjectV2SingleSelectField { id name options { id name } } } } } }';
var ISSUES_PAGE = 100;
var ISSUES_QUERY = `query RepoIssues($owner: String!, $name: String!, $after: String) { repository(owner: $owner, name: $name) { issues(first: ${ISSUES_PAGE}, after: $after) { pageInfo { hasNextPage endCursor } nodes { number title state stateReason closedAt updatedAt url milestone { title } labels(first: 10) { nodes { name } } assignees(first: 5) { nodes { login } } projectItems(first: 10) { pageInfo { hasNextPage } nodes { id isArchived project { id } fieldValueByName(name: "Status") { ... on ProjectV2ItemFieldSingleSelectValue { name updatedAt } } } } } } } }`;
var ISSUE_LIMIT = 500;
var GqlEnvelope = object({
  data: optional(unknown()),
  errors: nullish(array(object({ message: string() })))
});
function checked(schema, value, what) {
  const result = safeParse(schema, value);
  if (!result.success) {
    throw new PmError(1, `gh returned an unexpected ${what}: ${summarize(result.issues)}`);
  }
  return result.output;
}
function gql(run, cwd, doc, vars) {
  const args = ["api", "graphql", "-f", `query=${doc}`];
  for (const [flag, kv] of vars)
    args.push(flag, kv);
  const r = run("gh", args, cwd);
  if (r.code !== 0) {
    throw new PmError(1, r.stderr.trim() || "gh api graphql failed");
  }
  const parsed = checked(GqlEnvelope, JSON.parse(r.stdout), "GraphQL response");
  if (parsed.errors?.length)
    throw new PmError(1, parsed.errors[0].message);
  return parsed.data;
}
function rest(run, cwd, args) {
  const r = run("gh", args, cwd);
  if (r.code !== 0) {
    throw new PmError(1, r.stderr.trim() || `gh ${args[0]} failed`);
  }
  return r.stdout;
}
function fetchGhVersion(run, cwd) {
  const r = run("gh", ["--version"], cwd);
  if (r.code !== 0)
    return { found: false, version: null };
  return {
    found: true,
    version: parseGhVersion(r.stdout.split(`
`)[0] ?? "")
  };
}
function fetchLocalLogin(run, cwd) {
  const r = run("gh", ["config", "get", "-h", "github.com", "user"], cwd);
  const login = r.stdout.trim();
  return r.code === 0 && login ? login : null;
}
function fetchScopeHeaders(run, cwd) {
  return rest(run, cwd, ["api", "-i", "user"]);
}
var DiscoveryData = object({
  viewer: object({ login: string() }),
  repository: nullable(object({
    projectsV2: object({
      nodes: array(object({
        number: number(),
        title: string(),
        closed: boolean(),
        url: string(),
        id: string(),
        owner: object({ login: optional(string()) })
      }))
    })
  }))
});
function parseDiscovery(data) {
  const d = checked(DiscoveryData, data, "discovery");
  const nodes = d.repository?.projectsV2.nodes ?? [];
  return {
    viewer: d.viewer.login,
    boards: nodes.map((n) => ({
      number: n.number,
      title: n.title,
      closed: n.closed,
      url: n.url,
      id: n.id,
      ownerLogin: n.owner.login ?? ""
    }))
  };
}
function fetchDiscovery(run, cwd, owner, repo) {
  return parseDiscovery(gql(run, cwd, DISCOVERY_QUERY, [
    ["-f", `owner=${owner}`],
    ["-f", `name=${repo}`]
  ]));
}
var FieldData = object({
  user: object({
    projectV2: object({
      id: string(),
      title: string(),
      url: string(),
      createdAt: string(),
      field: nullable(object({
        id: string(),
        options: array(object({ id: string(), name: string() }))
      }))
    })
  })
});
function parseStatusField(data) {
  const p = checked(FieldData, data, "status field").user.projectV2;
  const statusField = p.field ? {
    id: p.field.id,
    options: Object.fromEntries(p.field.options.map((o) => [o.name, o.id]))
  } : null;
  return {
    id: p.id,
    title: p.title,
    url: p.url,
    createdAt: p.createdAt,
    statusField
  };
}
function fetchStatusField(run, cwd, login, number2) {
  return parseStatusField(gql(run, cwd, FIELD_QUERY, [
    ["-f", `login=${login}`],
    ["-F", `number=${number2}`]
  ]));
}
var IssuesData = object({
  repository: object({
    issues: object({
      pageInfo: object({
        hasNextPage: boolean(),
        endCursor: nullable(string())
      }),
      nodes: array(object({
        number: number(),
        title: string(),
        state: picklist(["OPEN", "CLOSED"]),
        stateReason: nullable(string()),
        closedAt: nullable(string()),
        updatedAt: string(),
        url: string(),
        milestone: nullable(object({ title: string() })),
        labels: object({ nodes: array(object({ name: string() })) }),
        assignees: object({
          nodes: array(object({ login: string() }))
        }),
        projectItems: object({
          pageInfo: object({ hasNextPage: boolean() }),
          nodes: array(object({
            id: string(),
            isArchived: boolean(),
            project: object({ id: string() }),
            fieldValueByName: nullable(object({
              name: optional(string()),
              updatedAt: optional(string())
            }))
          }))
        })
      }))
    })
  })
});
function parseRepoIssuesPage(data, projectId) {
  const page = checked(IssuesData, data, "issues page").repository.issues;
  const issues = page.nodes.map((n) => {
    const hit = n.projectItems.nodes.find((c) => c.project.id === projectId);
    if (!hit && n.projectItems.pageInfo.hasNextPage) {
      throw new PmError(1, `#${n.number} sits on more boards than one page lists, so its card on this board cannot be ruled out`);
    }
    const cardArchived = hit?.isArchived === true && n.state === "OPEN";
    return {
      number: n.number,
      title: n.title,
      state: n.state,
      stateReason: n.stateReason ?? null,
      closedAt: n.closedAt ?? null,
      updatedAt: n.updatedAt,
      url: n.url,
      milestone: n.milestone?.title ?? null,
      labels: n.labels.nodes.map((l) => l.name),
      assignees: n.assignees.nodes.map((a) => a.login),
      card: hit && !cardArchived ? {
        itemId: hit.id,
        status: hit.fieldValueByName?.name ?? null,
        statusUpdatedAt: hit.fieldValueByName?.updatedAt ?? null
      } : null,
      cardArchived
    };
  });
  return {
    issues,
    hasNextPage: page.pageInfo.hasNextPage,
    endCursor: page.pageInfo.endCursor
  };
}
function fetchRepoIssues(run, cwd, owner, repo, projectId) {
  const issues = [];
  let after = null;
  for (;; ) {
    const vars = [
      ["-f", `owner=${owner}`],
      ["-f", `name=${repo}`]
    ];
    if (after)
      vars.push(["-f", `after=${after}`]);
    const page = parseRepoIssuesPage(gql(run, cwd, ISSUES_QUERY, vars), projectId);
    issues.push(...page.issues);
    if (!page.hasNextPage || !page.endCursor)
      break;
    after = page.endCursor;
  }
  return issues;
}
function cardedItems(issues, fullName) {
  return issues.flatMap(({ card: card2, closedAt, cardArchived, ...i }) => card2 ? [{ ...i, ...card2, repo: fullName }] : []);
}
function milestoneCounts(issues, title) {
  const mine = issues.filter((i) => i.milestone === title);
  const open = mine.filter((i) => i.state === "OPEN").length;
  return { open, closed: mine.length - open };
}
var RestMilestones = array(object({
  number: number(),
  title: string(),
  description: nullable(string()),
  due_on: nullable(string()),
  open_issues: number(),
  closed_issues: number(),
  state: picklist(["open", "closed"]),
  created_at: string()
}));
function parseMilestones(json) {
  return checked(RestMilestones, JSON.parse(json), "milestone list").map((m) => ({
    number: m.number,
    title: m.title,
    description: m.description ?? "",
    due_on: m.due_on,
    open_issues: m.open_issues,
    closed_issues: m.closed_issues,
    state: m.state,
    created_at: m.created_at
  }));
}
function fetchMilestones(run, cwd, owner, repo, state) {
  return parseMilestones(rest(run, cwd, [
    "api",
    `repos/${owner}/${repo}/milestones?state=${state}&per_page=100`
  ]));
}
var CliIssues = array(object({
  number: number(),
  title: string(),
  labels: array(object({ name: string() })),
  body: string(),
  milestone: nullable(object({ title: string() })),
  updatedAt: string()
}));
function parseIssues(json) {
  const list = checked(CliIssues, JSON.parse(json), "issue list");
  if (list.length >= ISSUE_LIMIT) {
    throw new PmError(1, `gh issue list returned ${list.length} issues, the limit; refusing to reason over a truncated list`);
  }
  return list.map((i) => ({
    number: i.number,
    title: i.title,
    labels: i.labels.map((l) => l.name),
    body: i.body,
    milestone: i.milestone?.title ?? null,
    updatedAt: i.updatedAt
  }));
}
function fetchOpenIssues(run, cwd, owner, repo) {
  return parseIssues(rest(run, cwd, [
    "issue",
    "list",
    "-R",
    `${owner}/${repo}`,
    "--state",
    "open",
    "--limit",
    String(ISSUE_LIMIT),
    "--json",
    "number,title,labels,body,milestone,updatedAt"
  ]));
}

// bin/helpers/pm-lint.ts
var LINT_IDS = [
  "area_label_count",
  "no_status",
  "open_in_done",
  "completed_not_done",
  "backlog_without_condition",
  "backlog_in_milestone",
  "position_code_title",
  "cites_working_file",
  "unboarded",
  "stale_in_progress",
  "multiple_linked_boards"
];
var REVISIT_MARKER = /^\s*(?:[-*+][ \t]+)?(?:(\*\*|__|\*|_)revisit when(?::\1|\1:)|revisit when:)/im;
var POSITION_CODE = [
  /^\s*\d+(\.\d+)+\s*[—–-]/,
  /^\s*(bench|wave|step|phase)[- ]?\d+\b/i
];
var f = (number2, title, detail) => ({
  number: number2,
  title,
  detail
});
var open = (items) => items.filter((i) => i.state === "OPEN");
function areaLabelCount(issues) {
  return issues.map((i) => ({
    i,
    n: i.labels.filter((l) => l.startsWith("area:")).length
  })).filter(({ n }) => n !== 1).map(({ i, n }) => f(i.number, i.title, `${n} area:* labels`));
}
function noStatus(items) {
  return open(items).filter((i) => i.status === null).map((i) => f(i.number, i.title, "card has no Status"));
}
function openInDone(items) {
  return open(items).filter((i) => i.status === "Done").map((i) => f(i.number, i.title, "open issue carded Done"));
}
function completedNotDone(items) {
  return items.filter((i) => i.state === "CLOSED" && i.stateReason === "COMPLETED" && i.status !== "Done").map((i) => f(i.number, i.title, `closed as completed, card is ${i.status ?? "unset"}`));
}
function backlogWithoutCondition(issues) {
  return issues.filter((i) => i.labels.includes("backlog") && !REVISIT_MARKER.test(i.body)).map((i) => f(i.number, i.title, 'backlog label without a "Revisit when:" line'));
}
var WORKING_FILE_PATH = /\bdocs\/superpowers\b/;
function citesWorkingFile(issues) {
  return issues.filter((i) => WORKING_FILE_PATH.test(i.body)).map((i) => f(i.number, i.title, "body names docs/superpowers/, where working files live"));
}
function backlogInMilestone(issues) {
  return issues.filter((i) => i.labels.includes("backlog") && i.milestone !== null).map((i) => f(i.number, i.title, `deferred but in milestone ${i.milestone}`));
}
function positionCodeTitle(issues) {
  return issues.filter((i) => POSITION_CODE.some((re) => re.test(i.title))).map((i) => f(i.number, i.title, "title starts with a position code"));
}
function unboarded(uncarded, boardCreatedAt) {
  const since = Date.parse(boardCreatedAt);
  return uncarded.filter((i) => i.state === "OPEN" || i.stateReason === "COMPLETED" && i.closedAt !== null && Date.parse(i.closedAt) > since).map((i) => f(i.number, i.title, i.state === "CLOSED" ? "closed as completed, no card on the board" : i.cardArchived ? "card archived" : "no card on the board"));
}
function staleInProgress(items, now) {
  return open(items).filter((i) => i.status === "In Progress" && ageDays(touchedAt(i), now) > STALE_DAYS).map((i) => f(i.number, i.title, `In Progress, untouched ${ageDays(touchedAt(i), now)} days`));
}
function multipleLinkedBoards(candidates) {
  if (candidates.length <= 1)
    return [];
  const names = candidates.map((b) => `#${b.number}`).join(", ");
  return [
    f(null, "linked boards", `${candidates.length} open boards match: ${names}`)
  ];
}
var PREDICATES = {
  area_label_count: ({ issues }) => areaLabelCount(issues),
  no_status: ({ items }) => noStatus(items),
  open_in_done: ({ items }) => openInDone(items),
  completed_not_done: ({ items }) => completedNotDone(items),
  backlog_without_condition: ({ issues }) => backlogWithoutCondition(issues),
  backlog_in_milestone: ({ issues }) => backlogInMilestone(issues),
  position_code_title: ({ issues }) => positionCodeTitle(issues),
  cites_working_file: ({ issues }) => citesWorkingFile(issues),
  unboarded: ({ uncarded, boardCreatedAt }) => unboarded(uncarded, boardCreatedAt),
  stale_in_progress: ({ items, now }) => staleInProgress(items, now),
  multiple_linked_boards: ({ candidates }) => multipleLinkedBoards(candidates)
};
function lintAll(input) {
  const entries = LINT_IDS.map((id) => [id, PREDICATES[id](input)]);
  const findings = Object.fromEntries(entries);
  const counts = Object.fromEntries(entries.map(([id, list]) => [id, list.length]));
  return { findings, counts };
}

// bin/helpers/pm-report.ts
var STATE_CELL = {
  done: "done",
  running: "running",
  next: "next",
  later: ""
};
var cell = (text) => text.replaceAll("|", "\\|");
function row(plan, ref2) {
  const closed = plan.issues.filter((i) => !i.open).length;
  const issues = plan.issues.map((i) => ref2(i.number)).join(" ");
  return `| ${STATE_CELL[plan.state]} | ${cell(plan.name)} | ${closed} of ${plan.issues.length} | ${issues} |`;
}
function renderReport(r) {
  const ref2 = (n) => `${r.board.owner}/${r.board.repo}#${n}`;
  const running = r.plans.list.filter((p) => p.state === "running").map((p) => `**${p.name}**`);
  const unplanned = r.plans.unplanned.map((i) => ref2(i.number));
  return [
    `**${r.milestone.title}** · ${r.issue_counts.open} open, ${r.issue_counts.closed} closed`,
    `Running: ${running.length > 0 ? running.join(", ") : "none"}`,
    "",
    "| | Plan | Closed | Issues |",
    "|---|---|---|---|",
    ...r.plans.list.map((p) => row(p, ref2)),
    "",
    `Unplanned: ${unplanned.length > 0 ? unplanned.join(", ") : "none"}.`
  ].join(`
`);
}

// bin/helpers/rules.ts
import { execFileSync } from "node:child_process";
import * as fs5 from "node:fs";
import * as path5 from "node:path";

// bin/helpers/rules-fs.ts
import * as fs3 from "node:fs";
import * as path3 from "node:path";
var isOwnedRule = (name) => name.startsWith("sk-") && name.endsWith(".md");
function statusOf(dir, name) {
  const st = fs3.lstatSync(path3.join(dir, name), { throwIfNoEntry: false });
  if (!st)
    return "absent";
  return st.isFile() ? "file" : "other";
}
var isRegularFile = (dir, name) => statusOf(dir, name) === "file";
function ownedRulesIn(dir) {
  const dirStat = fs3.statSync(dir, { throwIfNoEntry: false });
  if (!dirStat)
    return [];
  if (!dirStat.isDirectory())
    return [];
  return fs3.readdirSync(dir).filter((n) => isOwnedRule(n) && isRegularFile(dir, n)).sort();
}

// bin/helpers/rules-overlap.ts
import * as fs4 from "node:fs";
import * as path4 from "node:path";
var MIN_SHARED_HEADINGS = 2;
var normalise2 = (s) => s.toLowerCase().replace(/[`*_]/g, "").replace(/[.:;!?]+$/, "").trim();
function headingsOf(body) {
  return body.split(`
`).filter((l) => l.startsWith("## ")).map((l) => normalise2(l.slice(3)));
}
function openingOf(body) {
  let lines = body.split(`
`);
  if (lines[0] === "---") {
    const end = lines.indexOf("---", 1);
    lines = end === -1 ? [] : lines.slice(end + 1);
  }
  const first = lines.find((l) => l.trim() !== "" && !l.startsWith("#"));
  if (!first)
    return;
  const sentence = first.split(/\.\s|\.$/)[0];
  const value = normalise2(sentence);
  return value === "" ? undefined : value;
}
function signalsFor(file, body, rule) {
  const signals = [];
  if (file === rule.name.slice("sk-".length))
    signals.push("name");
  const shared = new Set(headingsOf(body).filter((h) => rule.headings.has(h))).size;
  if (shared >= MIN_SHARED_HEADINGS)
    signals.push({ headings: shared });
  const opening = openingOf(body);
  if (opening !== undefined && opening === rule.opening) {
    signals.push({ opening });
  }
  return signals;
}
function findOverlap(src, dest) {
  const report = { pairs: [], extensions: [] };
  const destStat = fs4.statSync(dest, { throwIfNoEntry: false });
  if (!destStat?.isDirectory())
    return report;
  const rules = ownedRulesIn(src).map((name) => {
    const body = fs4.readFileSync(path4.join(src, name), "utf-8");
    return {
      name,
      headings: new Set(headingsOf(body)),
      opening: openingOf(body)
    };
  });
  const others = fs4.readdirSync(dest).filter((n) => n.endsWith(".md") && !isOwnedRule(n) && isRegularFile(dest, n)).sort();
  for (const file of others) {
    const body = fs4.readFileSync(path4.join(dest, file), "utf-8");
    for (const rule of rules) {
      const signals = signalsFor(file, body, rule);
      if (signals.length === 0)
        continue;
      if (body.includes(rule.name)) {
        report.extensions.push({ file, rule: rule.name });
      } else {
        report.pairs.push({ file, rule: rule.name, signals });
      }
    }
  }
  return report;
}
function describeSignal(signal) {
  if (signal === "name")
    return "name";
  if ("headings" in signal)
    return `${signal.headings} headings`;
  return "opening";
}
function formatOverlap(report) {
  const lines = [];
  if (report.pairs.length === 0) {
    lines.push("no overlap found (checked file names, two or more shared H2 headings, and the opening sentence against non-sk-*.md files)");
  } else {
    for (const p of report.pairs) {
      lines.push(`${p.file} overlaps ${p.rule} on ${p.signals.map(describeSignal).join(", ")}`);
    }
    lines.push("overlap is reported only; sidekick never edits files it does not own. If a repo file extends or departs from its pair on purpose, name the sk rule in it and the pair moves to the stated extensions");
  }
  if (report.extensions.length > 0) {
    lines.push(`stated extensions, not reported: ${report.extensions.map((e) => `${e.file} → ${e.rule}`).join(", ")}`);
  }
  return lines;
}

// bin/helpers/rules.ts
function resolveDest(scope, cwd, claudeHome) {
  return scope === "project" ? path5.join(cwd, ".claude", "rules") : path5.join(claudeHome, "rules");
}
function repoRootOf(cwd) {
  try {
    return execFileSync("git", ["rev-parse", "--show-toplevel"], {
      cwd,
      encoding: "utf-8",
      stdio: ["ignore", "pipe", "ignore"]
    }).trim();
  } catch {
    return cwd;
  }
}
var PLUGIN_ONLY_RULES = ["sk-pm-conventions.md"];
var isRecord3 = (v) => typeof v === "object" && v !== null && !Array.isArray(v);
var errorText = (e) => e instanceof Error ? e.message : String(e);
function pluginEnablement(root) {
  const file = path5.join(root, ".claude", "settings.json");
  let text;
  try {
    text = fs5.readFileSync(file, "utf-8");
  } catch (e) {
    if (e instanceof Error && "code" in e && e.code === "ENOENT") {
      return { state: "not-enabled" };
    }
    return { state: "unreadable", path: file, reason: errorText(e) };
  }
  if (text.trim() === "")
    return { state: "not-enabled" };
  let parsed;
  try {
    parsed = JSON.parse(text);
  } catch (e) {
    return { state: "unreadable", path: file, reason: errorText(e) };
  }
  if (!isRecord3(parsed)) {
    return { state: "unreadable", path: file, reason: "not a JSON object" };
  }
  const plugins = parsed.enabledPlugins;
  const enabled = isRecord3(plugins) && Object.entries(plugins).some(([key, on]) => key.startsWith("sidekick@") && on === true);
  return { state: enabled ? "enabled" : "not-enabled" };
}
var EVERY_RULE = { leaveOut: [], leaveAsIs: [] };
function projectSet(e) {
  switch (e.state) {
    case "enabled":
      return EVERY_RULE;
    case "not-enabled":
      return { leaveOut: PLUGIN_ONLY_RULES, leaveAsIs: [] };
    case "unreadable":
      return { leaveOut: [], leaveAsIs: PLUGIN_ONLY_RULES };
    default: {
      const _exhaustive = e;
      throw new Error(`unhandled enablement: ${JSON.stringify(_exhaustive)}`);
    }
  }
}
var shippedOnly = (set, shipped) => ({
  leaveOut: set.leaveOut.filter((n) => shipped.includes(n)),
  leaveAsIs: set.leaveAsIs.filter((n) => shipped.includes(n))
});
var expectedRules = (shipped, set) => shipped.filter((n) => !set.leaveOut.includes(n) && !set.leaveAsIs.includes(n));
function installRules(src, dest, scope = EVERY_RULE) {
  const shipped = ownedRulesIn(src);
  if (shipped.length === 0) {
    return { installed: [], removed: [], leftOut: [], skipped: [] };
  }
  const set = shippedOnly(scope, shipped);
  fs5.mkdirSync(dest, { recursive: true });
  const byLowerCase = new Map;
  for (const existing of fs5.readdirSync(dest)) {
    byLowerCase.set(existing.toLowerCase(), existing);
  }
  const installed = [];
  const skipped = [];
  for (const name of expectedRules(shipped, set)) {
    const onDisk = byLowerCase.get(name.toLowerCase());
    if (onDisk !== undefined && onDisk !== name) {
      skipped.push({ name, why: "case-collision" });
      continue;
    }
    if (statusOf(dest, name) === "other") {
      skipped.push({ name, why: "not-a-regular-file" });
      continue;
    }
    fs5.copyFileSync(path5.join(src, name), path5.join(dest, name));
    installed.push(name);
  }
  const keep = new Set(shipped);
  const owned = ownedRulesIn(dest);
  const removed = owned.filter((n) => !keep.has(n));
  const leftOut = owned.filter((n) => set.leaveOut.includes(n));
  for (const name of [...removed, ...leftOut]) {
    fs5.rmSync(path5.join(dest, name));
  }
  return { installed, removed, leftOut, skipped };
}
function checkRules(src, dest, scope = EVERY_RULE) {
  const shipped = ownedRulesIn(src);
  const set = shippedOnly(scope, shipped);
  const expected = expectedRules(shipped, set);
  const installed = ownedRulesIn(dest);
  const drift = [];
  for (const name of expected) {
    const there = path5.join(dest, name);
    if (!fs5.existsSync(there)) {
      drift.push({ kind: "missing", name });
      continue;
    }
    const same = fs5.readFileSync(path5.join(src, name)).equals(fs5.readFileSync(there));
    if (!same)
      drift.push({ kind: "stale", name });
  }
  const known = new Set(expected);
  for (const name of installed) {
    if (!known.has(name) && !set.leaveAsIs.includes(name)) {
      drift.push({ kind: "orphaned", name });
    }
  }
  return drift;
}
var USAGE = `usage: sidekick rules <install|check> --project|--user [--strict]
` + `  --project  the current repo's .claude/rules/
` + `  --user     the user-level rules directory under the Claude config dir
` + `  --strict   exit 1 when drift or a skipped write is found
` + "exit: 0 ran, whatever it found; 1 could not run, or --strict found drift";
var FLAGS = ["--project", "--user", "--strict"];
function parseArgs(args) {
  const [verb, ...flags] = args;
  if (verb !== "install" && verb !== "check")
    return;
  if (flags.some((f2) => !FLAGS.includes(f2)))
    return;
  const project = flags.includes("--project");
  const user = flags.includes("--user");
  if (project === user)
    return;
  return {
    verb,
    scope: project ? "project" : "user",
    strict: flags.includes("--strict")
  };
}
function scopeSet(scope, root) {
  if (scope === "user")
    return { set: EVERY_RULE, notes: [] };
  const enablement = pluginEnablement(root);
  const set = projectSet(enablement);
  const notes = [];
  if (set.leaveOut.length > 0) {
    notes.push(`not delivered to this repo: ${set.leaveOut.join(", ")}; its .claude/settings.json does not enable sidekick, so it comes from user level only`);
  }
  if (set.leaveAsIs.length > 0 && enablement.state === "unreadable") {
    notes.push(`left ${set.leaveAsIs.join(", ")} as it is: could not read ${enablement.path} (${enablement.reason})`);
  }
  return { set, notes };
}
var deliveryMode = (projectDest) => ownedRulesIn(projectDest).length > 0 ? "project" : "user";
var realOrSelf = (p) => {
  try {
    return fs5.realpathSync(p);
  } catch {
    return path5.resolve(p);
  }
};
var sameDir = (a, b) => realOrSelf(a) === realOrSelf(b);
function pickChecked(scope, verb, t, src, out) {
  if (scope === "user" || verb === "install" || deliveryMode(t.dest) === "project") {
    return { dest: t.dest, set: t.set };
  }
  out(`no sk-* rules in ${t.dest}; checking the user-level copies at ${t.userDest} against ${src}`);
  return { dest: t.userDest, set: EVERY_RULE };
}
function sharedNames(expected, projectDest, userDest) {
  const project = new Set(ownedRulesIn(projectDest));
  const user = new Set(ownedRulesIn(userDest));
  return expected.filter((n) => project.has(n) && user.has(n)).length;
}
function reportDuplicates(expected, dest, userDest, out) {
  if (sameDir(dest, userDest))
    return;
  const shared = sharedNames(expected, dest, userDest);
  if (shared === 0)
    return;
  out(`your user-level rules at ${userDest} also deliver ${shared} of these; Claude Code loads both copies here, which is expected where the repo keeps copies for colleagues without sidekick`);
}
function refuseNonDirectory(dir, out) {
  const st = fs5.statSync(dir, { throwIfNoEntry: false });
  if (!st || st.isDirectory())
    return false;
  out(`${dir} exists and is not a directory; refusing to write rules there`);
  return true;
}
function reportInstall(result, dest, out) {
  out(`installed ${result.installed.length} rule(s) into ${dest}: ${result.installed.join(", ")}`);
  if (result.removed.length > 0) {
    out(`removed retired: ${result.removed.join(", ")}`);
  }
  if (result.leftOut.length > 0) {
    out(`removed: ${result.leftOut.join(", ")} (not delivered to this repo)`);
  }
  for (const s of result.skipped)
    out(`[skipped:${s.why}] ${s.name}`);
}
function runRulesCli(args, env, out) {
  const parsed = parseArgs(args);
  if (parsed === undefined) {
    out(USAGE);
    return 1;
  }
  const { verb, scope, strict } = parsed;
  const root = scope === "project" ? repoRootOf(env.cwd) : env.cwd;
  if (scope === "project")
    out(`project root: ${root}`);
  const dest = resolveDest(scope, root, env.claudeHome);
  if (ownedRulesIn(env.src).length === 0) {
    out(`no sk-*.md rules found at ${env.src}; refusing to touch ${dest}`);
    return 1;
  }
  if (refuseNonDirectory(dest, out))
    return 1;
  const { set, notes } = scopeSet(scope, root);
  let skipped = [];
  if (verb === "install") {
    const result = installRules(env.src, dest, set);
    skipped = result.skipped;
    reportInstall(result, dest, out);
  }
  for (const note of notes)
    out(note);
  const userDest = resolveDest("user", root, env.claudeHome);
  const checked2 = pickChecked(scope, verb, { dest, userDest, set }, env.src, out);
  if (checked2.dest !== dest && refuseNonDirectory(checked2.dest, out))
    return 1;
  const expected = expectedRules(ownedRulesIn(env.src), checked2.set);
  const drift = checkRules(env.src, checked2.dest, checked2.set);
  if (drift.length === 0) {
    out(`${expected.length} rule(s) match the shipped copies at ${checked2.dest}`);
  }
  for (const d of drift)
    out(`[${d.kind}] ${d.name}`);
  if (scope === "project" && checked2.dest === dest) {
    reportDuplicates(expected, dest, userDest, out);
  }
  for (const l of formatOverlap(findOverlap(env.src, dest)))
    out(l);
  const found = drift.length > 0 || skipped.length > 0;
  return strict && found ? 1 : 0;
}

// bin/helpers/pm.ts
var GH_MIN = "2.98.0";
function chooseBoard(boards, viewer, repo) {
  return boards.filter((b) => !b.closed && b.ownerLogin === viewer && b.title === repo).sort((a, b) => a.number - b.number);
}
function preflightOf(version) {
  const ok = version !== null && versionAtLeast(version, GH_MIN);
  const warnings = ok ? [] : [
    `gh ${version ?? "unknown"} < ${GH_MIN}: by-name item-edit unavailable; write by field and option id`
  ];
  return {
    gh_version: version,
    gh_min: GH_MIN,
    gh_ok: ok,
    project_scope: null,
    warnings
  };
}
function discover(run, cwd) {
  const gh = fetchGhVersion(run, cwd);
  if (!gh.found)
    throw new PmError(2, "gh not found on PATH");
  const root = repoRootOf(cwd);
  const preflight = preflightOf(gh.version);
  const untracked = (reason, fields = {}) => ({
    tracked: false,
    reason,
    owner: fields.owner ?? null,
    repo: fields.repo ?? null,
    project: null,
    status_field: null,
    linked: fields.linked ?? [],
    preflight,
    root
  });
  const origin = run("git", ["remote", "get-url", "origin"], root);
  if (origin.code !== 0)
    return untracked("no-origin");
  const parsed = parseOrigin(origin.stdout);
  if (!parsed)
    return untracked("not-github");
  const login = fetchLocalLogin(run, root);
  if (login === null) {
    return untracked("no-local-login", {
      owner: parsed.owner,
      repo: parsed.repo
    });
  }
  if (login !== parsed.owner) {
    return untracked("remote-owner-mismatch", {
      owner: parsed.owner,
      repo: parsed.repo
    });
  }
  preflight.project_scope = hasProjectScope(fetchScopeHeaders(run, root));
  if (!preflight.project_scope) {
    throw new PmError(2, "gh token lacks the 'project' scope; run: gh auth refresh -s project");
  }
  const d = fetchDiscovery(run, root, parsed.owner, parsed.repo);
  const chosen = chooseBoard(d.boards, d.viewer, parsed.repo);
  if (chosen.length === 0) {
    return untracked("no-board", {
      owner: parsed.owner,
      repo: parsed.repo,
      linked: d.boards
    });
  }
  const first = chosen[0];
  const f2 = fetchStatusField(run, root, d.viewer, first.number);
  return {
    tracked: true,
    reason: null,
    owner: parsed.owner,
    repo: parsed.repo,
    viewer: d.viewer,
    project: {
      number: first.number,
      id: f2.id,
      url: f2.url,
      title: f2.title,
      createdAt: f2.createdAt
    },
    status_field: f2.statusField,
    linked: d.boards,
    preflight,
    root
  };
}
var PM_USAGE_LINE = "sidekick pm <board|pickup|lint|gate> [--quiet] [--brief|--report] [--milestone <title>]";
var PM_USAGE = `usage: ${PM_USAGE_LINE}`;
var VERBS2 = new Set(["board", "pickup", "lint", "gate"]);
function milestoneFlag(args) {
  const at = args.findIndex((a) => a === "--milestone" || a.startsWith("--milestone="));
  if (at < 0)
    return { title: undefined, invalid: false };
  const title = args[at].startsWith("--milestone=") ? args[at].slice("--milestone=".length) : args[at + 1];
  const usable = title !== undefined && title !== "" && !title.startsWith("--");
  return usable ? { title, invalid: false } : { title: undefined, invalid: true };
}
function runPmCli(args, env, out, err) {
  const [verb, ...rest2] = args;
  if (!verb || !VERBS2.has(verb)) {
    err(PM_USAGE);
    return 1;
  }
  const run = env.run ?? execRunner;
  const brief = rest2.includes("--brief");
  const report = rest2.includes("--report");
  const quiet = rest2.includes("--quiet") || brief;
  const ms = milestoneFlag(rest2);
  const msTitle = ms.title;
  if (verb === "gate" && msTitle === undefined || ms.invalid || brief && report) {
    err(PM_USAGE);
    return 1;
  }
  const emit = (o) => out(JSON.stringify(o, null, 2));
  try {
    const info = discover(run, env.cwd);
    const { root: _root, ...shown } = info;
    if (!info.tracked) {
      if (report) {
        err(`not tracked: ${info.reason}`);
        return 1;
      }
      if (!quiet)
        emit(shown);
      return 0;
    }
    if (verb === "board") {
      emit(shown);
      return 0;
    }
    const now = env.now ?? new Date;
    const owner = info.owner;
    const repo = info.repo;
    const project = info.project;
    const fullName = `${owner}/${repo}`;
    const viewer = info.viewer;
    if (verb === "pickup") {
      const open2 = fetchMilestones(run, info.root, owner, repo, "open").sort((a, b) => a.number - b.number);
      const repoIssues = fetchRepoIssues(run, info.root, owner, repo, project.id);
      const items = cardedItems(repoIssues, fullName);
      const active = msTitle === undefined ? activeMilestone(open2, items) : namedMilestone(open2, msTitle);
      const plans = active ? planView(active, items) : null;
      const issueCounts = active ? milestoneCounts(repoIssues, active.title) : null;
      if (report) {
        return emitReport({
          board: { owner, repo },
          open: open2,
          milestone: active,
          issue_counts: issueCounts,
          plans
        }, out, err);
      }
      const t = tiers(items, active, now);
      const working = inProgressMilestones(open2, items);
      const split = working.length > 1 ? working.map((m) => m.title) : [];
      const pickup = {
        board: shown,
        milestone: active,
        issue_counts: issueCounts,
        open_milestones: open2.map((m) => ({
          number: m.number,
          title: m.title
        })),
        in_progress: t.in_progress,
        candidates: t.candidates,
        order_basis: "number",
        plans,
        drift: drift(run, info.root, t.in_progress, split)
      };
      if (brief)
        out(renderBrief({ ...pickup, board: { owner, repo, project } }));
      else
        emit(pickup);
      return 0;
    }
    if (verb === "lint") {
      const issues = fetchOpenIssues(run, info.root, owner, repo);
      const repoIssues = fetchRepoIssues(run, info.root, owner, repo, project.id);
      const items = cardedItems(repoIssues, fullName);
      const uncarded = repoIssues.filter((i) => i.card === null);
      const candidates = chooseBoard(info.linked, viewer, repo);
      const r = lintAll({
        issues,
        items,
        uncarded,
        boardCreatedAt: project.createdAt,
        candidates,
        now
      });
      emit({
        board: shown,
        findings: r.findings,
        counts: r.counts
      });
      return 0;
    }
    if (verb === "gate") {
      const openMs = fetchMilestones(run, info.root, owner, repo, "open");
      const found = openMs.find((m) => m.title === msTitle) ?? fetchMilestones(run, info.root, owner, repo, "closed").find((m) => m.title === msTitle);
      if (!found) {
        throw new PmError(1, `no milestone titled "${msTitle}"; open: ${openMs.map((m) => m.title).join(", ") || "(none)"}`);
      }
      const issues = fetchOpenIssues(run, info.root, owner, repo);
      const items = cardedItems(fetchRepoIssues(run, info.root, owner, repo, project.id), fullName);
      const v = gateVerdict(found, issues, items);
      emit({ board: shown, milestone: found, ready: v.ready, open: v.open });
      return 0;
    }
    err(PM_USAGE);
    return 1;
  } catch (e) {
    if (e instanceof PmError) {
      err(e.message);
      return e.exit;
    }
    err(e instanceof Error ? e.message : String(e));
    return 1;
  }
}
function emitReport(r, out, err) {
  const { board, open: open2, milestone, issue_counts, plans } = r;
  if (open2.length === 0) {
    err("no open milestone to report on");
    return 1;
  }
  if (milestone === null || issue_counts === null || plans === null) {
    err(`no active milestone among ${open2.length} open (${open2.map((m) => m.title).join(", ")}); pass --milestone`);
    return 1;
  }
  if (plans.parse !== "ok") {
    err(plans.parse === "none" ? `milestone "${milestone.title}" has no plans header` : `milestone "${milestone.title}": ${plans.reason ?? "malformed plans header"}`);
    return 1;
  }
  out(renderReport({ board, milestone, issue_counts, plans }));
  return 0;
}
function inProgressMilestones(open2, items) {
  const titles2 = new Set(items.filter((i) => i.state === "OPEN" && i.status === "In Progress").map((i) => i.milestone));
  return open2.filter((m) => m.state === "open" && titles2.has(m.title)).sort((a, b) => a.number - b.number);
}
function activeMilestone(open2, items) {
  const working = inProgressMilestones(open2, items);
  if (working.length === 1)
    return working[0];
  const live = open2.filter((m) => m.state === "open");
  return working.length === 0 && live.length === 1 ? live[0] : null;
}
function namedMilestone(open2, title) {
  const found = open2.find((m) => m.title === title);
  if (found)
    return found;
  throw new PmError(1, `no open milestone titled "${title}"; open: ${open2.map((m) => m.title).join(", ") || "(none)"}`);
}
function tiers(items, active, now) {
  const open2 = items.filter((i) => i.state === "OPEN");
  const byNumber = (a, b) => a.number - b.number;
  const in_progress = open2.filter((i) => i.status === "In Progress").map((i) => ({
    number: i.number,
    title: i.title,
    item_id: i.itemId,
    age_days: ageDays(touchedAt(i), now),
    assignees: i.assignees,
    milestone: i.milestone
  })).sort(byNumber);
  const backlog = open2.filter((i) => i.status === "Backlog");
  const tier1 = active ? backlog.filter((i) => i.milestone === active.title) : [];
  const tier2 = backlog.filter((i) => i.milestone === null && !i.labels.includes("backlog"));
  const cand = (tier) => (i) => ({
    tier,
    number: i.number,
    title: i.title,
    item_id: i.itemId,
    labels: i.labels
  });
  return {
    in_progress,
    candidates: [
      ...tier1.sort(byNumber).map(cand(1)),
      ...tier2.sort(byNumber).map(cand(2))
    ]
  };
}
var OpenPrList = array(object({ number: number(), title: string() }));
function drift(run, root, inProgress2, inProgressSplit = []) {
  const branch = run("git", ["branch", "--show-current"], root).stdout.trim();
  let basis = "none";
  let base = null;
  if (run("git", ["rev-parse", "--abbrev-ref", "@{u}"], root).code === 0) {
    basis = "upstream";
    base = "@{u}";
  } else if (branch && run("git", ["rev-parse", "--verify", "--quiet", `refs/remotes/origin/${branch}`], root).code === 0) {
    basis = "origin-branch";
    base = `origin/${branch}`;
  }
  let count = null;
  if (base) {
    const r = run("git", ["rev-list", "--count", `${base}..HEAD`], root);
    count = r.code === 0 ? Number(r.stdout.trim()) : null;
  }
  let open_pr = null;
  if (branch) {
    const r = run("gh", [
      "pr",
      "list",
      "--head",
      branch,
      "--state",
      "open",
      "--json",
      "number,title"
    ], root);
    if (r.code === 0) {
      try {
        const list = safeParse(OpenPrList, JSON.parse(r.stdout));
        open_pr = list.success ? list.output[0] ?? null : null;
      } catch {
        open_pr = null;
      }
    }
  }
  return {
    unpushed: { count, basis },
    stale_in_progress: inProgress2.filter((i) => i.age_days > STALE_DAYS),
    open_pr,
    in_progress_split: inProgressSplit
  };
}
function gateVerdict(ms, issues, items) {
  const itemByNumber = new Map(items.map((i) => [i.number, i]));
  const open2 = issues.filter((i) => i.milestone === ms.title).sort((a, b) => a.number - b.number).map((i) => ({
    number: i.number,
    title: i.title,
    status: itemByNumber.get(i.number)?.status ?? null,
    item_id: itemByNumber.get(i.number)?.itemId ?? null,
    labels: i.labels
  }));
  return { ready: ms.open_issues === 0 && open2.length === 0, open: open2 };
}

// bin/helpers/profile.ts
import { parseArgs as parseArgs2 } from "node:util";

// bin/helpers/profile-launch.ts
import { spawnSync as spawnSync2 } from "node:child_process";
import * as fs6 from "node:fs";
import * as path6 from "node:path";
var isPlainObject = (x) => typeof x === "object" && x !== null && !Array.isArray(x);
var uniqueByValue = (items) => items.filter((item, i) => items.findIndex((o) => JSON.stringify(o) === JSON.stringify(item)) === i);
function mergeValue(prev, next) {
  if (isPlainObject(prev) && isPlainObject(next))
    return mergeTwo(prev, next);
  if (Array.isArray(prev) && Array.isArray(next)) {
    return uniqueByValue([...prev, ...next]);
  }
  return next;
}
function mergeTwo(base, next) {
  const carried = Object.entries(base).map(([key, prev]) => [
    key,
    Object.hasOwn(next, key) ? mergeValue(prev, next[key]) : prev
  ]);
  const added = Object.entries(next).filter(([key]) => !Object.hasOwn(base, key));
  return Object.fromEntries([...carried, ...added]);
}
var mergeSettings = (...layers) => layers.reduce(mergeTwo, {});
var memoryVariable = "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD";
function launchKeys(profile, home) {
  const isCleanRoom = profile.manifest.settingSources !== undefined && !profile.manifest.settingSources.includes("user");
  return {
    sidekick: { profile: profile.name },
    ...profile.hasRules ? { env: { [memoryVariable]: "1" } } : {},
    ...isCleanRoom ? {
      claudeMdExcludes: [
        path6.join(home, ".claude", "CLAUDE.md"),
        path6.join(home, ".claude", "rules", "**")
      ]
    } : {}
  };
}
function composeSettings(profile, opts) {
  return mergeSettings(profile.manifest.settings ?? {}, opts.overlay ?? {}, launchKeys(profile, opts.home));
}
function launchArgs(profile, settings) {
  const sources = profile.manifest.settingSources;
  return [
    "--add-dir",
    profile.dir,
    "--settings",
    JSON.stringify(settings),
    ...sources === undefined ? [] : ["--setting-sources", sources.join(",")]
  ];
}
var COULD_NOT_START = 127;
var spawnClaude = (command, args, opts) => spawnSync2(command, args, {
  ...opts,
  encoding: "utf8",
  stdio: ["ignore", "pipe", "pipe"]
});
var isTimeout = (error) => ("code" in error) && error.code === "ETIMEDOUT";
var makeClaudeRunner = (spawn = spawnClaude) => (args, { cwd, timeoutMs }) => {
  const out = spawn("claude", args, {
    cwd,
    timeout: timeoutMs,
    shell: false
  });
  const stdout = out.stdout ?? "";
  const stderr = out.stderr ?? "";
  if (out.error === undefined) {
    return { code: out.status ?? 1, stdout, stderr, timedOut: false };
  }
  if (isTimeout(out.error)) {
    return { code: out.status ?? 1, stdout, stderr, timedOut: true };
  }
  return {
    code: COULD_NOT_START,
    stdout,
    stderr: stderr || out.error.message,
    timedOut: false
  };
};
var execClaude = makeClaudeRunner();
var CANARY_KEYS = ["feedbackSurveyRate", "cleanupPeriodDays"];
var CANARY_VALUE = "sidekick-canary";
var SKIP_VARIABLE = "SIDEKICK_PROFILE_SKIP_CHECK";
var SKIP_WARNING = `${SKIP_VARIABLE}=1 is set, so the settings were not checked with claude doctor.`;
var refuse = (...issues) => ({ ok: false, issues });
function invalidSettingsLines(doctorOutput, paths) {
  const lines = doctorOutput.split(`
`);
  const start = lines.findIndex((line) => line.trim() === "Invalid settings");
  if (start === -1)
    return [];
  const rest2 = lines.slice(start + 1);
  const end = rest2.findIndex((line) => line.trim() === "");
  const section = end === -1 ? rest2 : rest2.slice(0, end);
  return section.filter((line) => line.startsWith("- ") && paths.some((p) => line.startsWith(`- ${p} `)));
}
var printed = (result) => [result.stdout, result.stderr].filter((text) => text.trim() !== "").join(`
`);
function judge(result, lines, canary) {
  if (result.timedOut) {
    return refuse("claude doctor timed out.", printed(result));
  }
  if (result.code === COULD_NOT_START) {
    return refuse("The settings check could not start claude.", printed(result));
  }
  if (result.code !== 0) {
    return refuse(`claude doctor failed with exit code ${result.code}.`, printed(result));
  }
  const isCanaryLine = (line) => line.includes(` › ${canary}:`);
  if (!lines.some(isCanaryLine)) {
    return refuse("claude doctor's output no longer parses: its report for the canary key is missing, so a launch could drop settings silently.", `Set ${SKIP_VARIABLE}=1 to skip the check until sidekick catches up.`);
  }
  const real = lines.filter((line) => !isCanaryLine(line));
  return real.length === 0 ? { ok: true, warnings: [] } : refuse(...real);
}
function checkSettings(settings, deps, timeoutMs = 30000) {
  if (deps.skip)
    return { ok: true, warnings: [SKIP_WARNING] };
  const canary = CANARY_KEYS.find((key) => !Object.hasOwn(settings, key));
  if (canary === undefined) {
    return refuse(`The settings set both ${CANARY_KEYS.join(" and ")}, so the check has no canary key left.`);
  }
  const dir = fs6.mkdtempSync(path6.join(deps.tmpdir, "sidekick-profile-"));
  try {
    const file = path6.join(dir, "settings.json");
    fs6.writeFileSync(file, JSON.stringify({ ...settings, [canary]: CANARY_VALUE }), {
      mode: 384
    });
    const result = deps.run(["--settings", file, "doctor"], {
      cwd: deps.cwd,
      timeoutMs
    });
    const lines = invalidSettingsLines(result.stdout, [
      file,
      fs6.realpathSync(file)
    ]);
    return judge(result, lines, canary);
  } finally {
    fs6.rmSync(dir, { recursive: true, force: true });
  }
}
var bgArgs = (base, opts) => [
  ...base,
  "--bg",
  ...opts.sessionName === undefined ? [] : ["-n", opts.sessionName],
  ...opts.prompt === undefined ? [] : ["--", opts.prompt]
];

// bin/helpers/profile-manifest.ts
import * as fs7 from "node:fs";
var SETTING_SOURCES = ["user", "project", "local"];
var PROFILE_NAME_RULE = "1 to 64 lowercase letters, digits, and hyphens, starting with a letter or digit";
var PROFILE_NAME = /^[a-z0-9][a-z0-9-]{0,63}$/;
var isProfileName = (name) => PROFILE_NAME.test(name);
var RESERVED_SETTINGS_KEY = "sidekick";
var ManifestSchema = strictObject({
  description: pipe(string(), minLength(1, "must not be empty")),
  settingSources: optional(pipe(array(picklist(SETTING_SOURCES)), check((a) => new Set(a).size === a.length, "must not repeat a source"))),
  settings: optional(pipe(unknown(), check((s) => !Array.isArray(s), "must be an object"), record(string(), unknown()), check((s) => !Object.hasOwn(s, RESERVED_SETTINGS_KEY), `must not set "${RESERVED_SETTINGS_KEY}", which launch owns`)))
});
function parseManifest(raw) {
  const result = safeParse(ManifestSchema, raw);
  if (result.success)
    return { ok: true, manifest: result.output };
  return {
    ok: false,
    issues: result.issues.map((i) => `${getDotPath(i) ?? "(root)"}: ${i.message}`)
  };
}
var isMissing = (err) => err instanceof Error && ("code" in err) && err.code === "ENOENT";
function readManifest(file) {
  let text;
  try {
    text = fs7.readFileSync(file, "utf8");
  } catch (err) {
    const why = isMissing(err) ? "missing" : err instanceof Error ? err.message : String(err);
    return { ok: false, issues: [`${file}: ${why}`] };
  }
  let raw;
  try {
    raw = JSON.parse(text);
  } catch (err) {
    const why = err instanceof Error ? err.message : String(err);
    return { ok: false, issues: [`${file}: invalid JSON: ${why}`] };
  }
  const parsed = parseManifest(raw);
  if (parsed.ok)
    return parsed;
  return { ok: false, issues: parsed.issues.map((i) => `${file}: ${i}`) };
}

// bin/helpers/profile-shell.ts
var FIND_INSTALL = 'let s="";process.stdin.on("data",d=>{s+=d}).on("end",()=>{try{const e=JSON.parse(s).find(x=>x.id==="sidekick@rikmorn"&&x.scope==="user");if(e&&typeof e.installPath==="string"){process.stdout.write(e.installPath);return}}catch{}process.exit(1)})';
var NO_INSTALL = "skp: no user-scope sidekick@rikmorn install";
var ZSH_FUNCTION = `skp() {
  emulate -L zsh
  if (( $# < 1 )); then builtin print -u2 'usage: skp <profile> [claude arguments...]'; return 2; fi
  local name=$1; shift
  local list cli out
  list=$(command claude plugin list --json) || { builtin print -u2 'skp: claude plugin list failed'; return 1; }
  cli=$(builtin print -r -- "$list" | command node -e '${FIND_INSTALL}') || { builtin print -u2 '${NO_INSTALL}'; return 1; }
  out=$(command node "$cli/bin/sidekick" profile argv "$name") || return
  local -a args=("\${(@0)out}")
  (( \${#args} )) && [[ -z \${args[-1]} ]] && args[-1]=()
  command claude "\${args[@]}" "$@"
}
`;
var BASH_FUNCTION = `skp() {
  if [ $# -lt 1 ]; then builtin echo 'usage: skp <profile> [claude arguments...]' >&2; return 2; fi
  local name="$1"; shift
  local list cli tmp rc a
  list=$(command claude plugin list --json) || { builtin echo 'skp: claude plugin list failed' >&2; return 1; }
  cli=$(builtin printf '%s' "$list" | command node -e '${FIND_INSTALL}') || { builtin echo '${NO_INSTALL}' >&2; return 1; }
  tmp=$(command mktemp) || return 1
  command node "$cli/bin/sidekick" profile argv "$name" >| "$tmp"; rc=$?
  if [ "$rc" -ne 0 ]; then command rm -f "$tmp"; return "$rc"; fi
  local args=()
  while IFS= builtin read -r -d '' a; do args+=("$a"); done < "$tmp"
  command rm -f "$tmp"
  command claude "\${args[@]}" "$@"
}
`;
var RESERVED_WORDS = new Set([
  "case",
  "coproc",
  "declare",
  "do",
  "done",
  "elif",
  "else",
  "end",
  "esac",
  "export",
  "fi",
  "float",
  "for",
  "foreach",
  "function",
  "if",
  "in",
  "integer",
  "local",
  "nocorrect",
  "readonly",
  "repeat",
  "select",
  "then",
  "time",
  "typeset",
  "until",
  "while"
]);
var SKP_RUNS_THROUGH = new Set(["command", "builtin"]);
function aliasNameRefusal(name) {
  if (name === "skp") {
    return '"skp" cannot be an alias: the alias would replace the skp function itself.';
  }
  if (SKP_RUNS_THROUGH.has(name)) {
    return `"${name}" cannot be an alias: skp runs its commands through command and builtin, and the alias would take them over.`;
  }
  if (RESERVED_WORDS.has(name)) {
    return `"${name}" cannot be an alias: it is a reserved word in zsh or bash, and the alias would break shell code that uses it.`;
  }
  return;
}
var shellFunction = (shell, aliasNames) => {
  for (const name of aliasNames) {
    if (!isProfileName(name)) {
      throw new Error(`invalid alias name: ${JSON.stringify(name)}`);
    }
  }
  const aliases = aliasNames.map((name) => `alias ${name}='skp ${name}'
`);
  return [shell === "zsh" ? ZSH_FUNCTION : BASH_FUNCTION, ...aliases].join("");
};

// bin/helpers/profile-store.ts
import * as fs8 from "node:fs";
import * as path7 from "node:path";
var MANIFEST_FILE = "profile.json";
var notAName = (name) => `"${name}" is not a profile name: use ${PROFILE_NAME_RULE}`;
var HIDES_AGENTS = "hides the repo's AGENTS.md in every profiled session; put the stance in .claude/rules/";
var ENABLES_PLUGINS = "can enable plugins outside the checked settings block; put settings in profile.json";
var REFUSED = [
  { path: "CLAUDE.md", why: HIDES_AGENTS },
  { path: ".claude/CLAUDE.md", why: HIDES_AGENTS },
  { path: "CLAUDE.local.md", why: HIDES_AGENTS },
  { path: ".claude/settings.json", why: ENABLES_PLUGINS },
  { path: ".claude/settings.local.json", why: ENABLES_PLUGINS }
];
function storeRoots(env, cwd, home) {
  const override = env.SIDEKICK_PROFILES_DIR;
  if (override)
    return [path7.resolve(cwd, override)];
  const configDir = env.CLAUDE_CONFIG_DIR || path7.join(home, ".claude");
  return [path7.resolve(cwd, configDir, "profiles")];
}
var isPresent = (file) => {
  try {
    fs8.lstatSync(file);
    return true;
  } catch {
    return false;
  }
};
var isDirectory = (dir) => {
  try {
    return fs8.statSync(dir).isDirectory();
  } catch {
    return false;
  }
};
function checkLayout(dir) {
  return REFUSED.filter((r) => isPresent(path7.join(dir, r.path))).map((r) => `${path7.join(dir, r.path)}: ${r.why}`);
}
var holdsMarkdown = (dir) => {
  let entries;
  try {
    entries = fs8.readdirSync(dir, { withFileTypes: true });
  } catch {
    return false;
  }
  return entries.some((e) => {
    const full = path7.join(dir, e.name);
    if (e.isDirectory())
      return holdsMarkdown(full);
    if (e.isSymbolicLink() && isDirectory(full))
      return holdsMarkdown(full);
    return e.name.endsWith(".md");
  });
};
var readFolder = (name, root) => {
  const dir = path7.resolve(root, name);
  const layout = checkLayout(dir);
  if (layout.length > 0)
    return { ok: false, issues: layout };
  const read = readManifest(path7.join(dir, MANIFEST_FILE));
  if (!read.ok)
    return read;
  return {
    ok: true,
    profile: {
      name,
      dir,
      root,
      manifest: read.manifest,
      hasRules: holdsMarkdown(path7.join(dir, ".claude", "rules"))
    }
  };
};
function loadProfile(name, roots) {
  if (!isProfileName(name))
    return { ok: false, issues: [notAName(name)] };
  const root = roots.find((r) => isDirectory(path7.resolve(r, name)));
  if (root === undefined) {
    return {
      ok: false,
      issues: [
        `no profile named "${name}"; searched: ${roots.map((r) => path7.resolve(r)).join(", ")}`
      ]
    };
  }
  return readFolder(name, path7.resolve(root));
}
var isHidden = (name) => name.startsWith(".");
var listRoot = (root) => {
  let names;
  try {
    names = fs8.readdirSync(root).sort();
  } catch {
    return [];
  }
  return names.filter((name) => !isHidden(name) && isDirectory(path7.join(root, name))).map((name) => {
    if (!isProfileName(name)) {
      return {
        name,
        root,
        description: undefined,
        issues: [notAName(name)]
      };
    }
    const loaded = readFolder(name, root);
    return loaded.ok ? {
      name,
      root,
      description: loaded.profile.manifest.description,
      issues: []
    } : { name, root, description: undefined, issues: loaded.issues };
  });
};
function listProfiles(roots) {
  return roots.flatMap((r) => listRoot(path7.resolve(r)));
}
function newProfile(name, description, roots) {
  if (!isProfileName(name))
    return { ok: false, issues: [notAName(name)] };
  const manifest = { description };
  const parsed = parseManifest(manifest);
  if (!parsed.ok)
    return parsed;
  const [first] = roots;
  if (first === undefined)
    return { ok: false, issues: ["no store root is set"] };
  const root = path7.resolve(first);
  const dir = path7.join(root, name);
  try {
    fs8.mkdirSync(root, { recursive: true });
    fs8.mkdirSync(dir);
    fs8.writeFileSync(path7.join(dir, MANIFEST_FILE), `${JSON.stringify(manifest, null, 2)}
`);
  } catch (err) {
    const exists = err instanceof Error && "code" in err && err.code === "EEXIST";
    const why = exists ? "already exists" : err instanceof Error ? err.message : String(err);
    return { ok: false, issues: [`${dir}: ${why}`] };
  }
  return { ok: true, dir };
}

// bin/helpers/profile.ts
var PROFILE_USAGE_LINE = "sidekick profile list|show <name>|new <name> --description <text>|argv <name>|launch --bg <name> [-n <session>] [-- <prompt>]|alias [--shell zsh|bash] [<name>...]";
var SHELLS = ["zsh", "bash"];
var withoutTrailingNewline = (text) => text.replace(/\n$/, "");
function parseFlags(rest2, options) {
  try {
    const { values, positionals } = parseArgs2({
      args: rest2,
      options,
      allowPositionals: true,
      strict: true
    });
    return { values, positionals };
  } catch {
    return;
  }
}
var usage = (err) => {
  err(`usage: ${PROFILE_USAGE_LINE}`);
  return 1;
};
var refuse2 = (err, issues) => {
  for (const issue of issues)
    err(issue);
  return 1;
};
function load(name, penv) {
  const loaded = loadProfile(name, storeRoots(penv.env, penv.cwd, penv.home));
  return loaded.ok ? { profile: loaded.profile } : { issues: loaded.issues };
}
var composed = (profile, penv) => {
  const settings = composeSettings(profile, { home: penv.home });
  return { settings, args: launchArgs(profile, settings) };
};
var runCheck = (settings, penv) => checkSettings(settings, {
  run: penv.runClaude,
  cwd: penv.cwd,
  tmpdir: penv.tmpdir,
  skip: penv.env[SKIP_VARIABLE] === "1"
});
var list = (rest2, penv, out, err) => {
  if (rest2.length > 0)
    return usage(err);
  const profiles = listProfiles(storeRoots(penv.env, penv.cwd, penv.home));
  for (const p of profiles) {
    out(p.issues.length > 0 ? `${p.name}  invalid: ${p.issues[0]}  (${p.root})` : `${p.name}  ${p.description}  (${p.root})`);
  }
  return profiles.some((p) => p.issues.length > 0) ? 1 : 0;
};
var show = (rest2, penv, out, err) => {
  const parsed = parseFlags(rest2, {});
  if (parsed === undefined || parsed.positionals.length !== 1) {
    return usage(err);
  }
  const loaded = load(parsed.positionals[0], penv);
  if ("issues" in loaded)
    return refuse2(err, loaded.issues);
  const { profile } = loaded;
  const { settings, args } = composed(profile, penv);
  out(`folder: ${profile.dir}`);
  out(`manifest: ${JSON.stringify(profile.manifest, null, 2)}`);
  out(`settings: ${JSON.stringify(settings, null, 2)}`);
  out("arguments:");
  for (const arg of args)
    out(arg);
  return 0;
};
var create = (rest2, penv, out, err) => {
  const parsed = parseFlags(rest2, { description: { type: "string" } });
  const description = parsed?.values.description;
  if (parsed === undefined || parsed.positionals.length !== 1 || typeof description !== "string") {
    return usage(err);
  }
  const created = newProfile(parsed.positionals[0], description, storeRoots(penv.env, penv.cwd, penv.home));
  if (!created.ok)
    return refuse2(err, created.issues);
  out(created.dir);
  return 0;
};
var argv = (rest2, penv, _out, err) => {
  const parsed = parseFlags(rest2, {});
  if (parsed === undefined || parsed.positionals.length !== 1) {
    return usage(err);
  }
  const loaded = load(parsed.positionals[0], penv);
  if ("issues" in loaded)
    return refuse2(err, loaded.issues);
  const { settings, args } = composed(loaded.profile, penv);
  const checked2 = runCheck(settings, penv);
  if (!checked2.ok)
    return refuse2(err, checked2.issues);
  for (const warning of checked2.warnings)
    err(warning);
  penv.write(args.map((arg) => `${arg}\x00`).join(""));
  return 0;
};
var launch = (rest2, penv, out, err) => {
  const split = rest2.indexOf("--");
  const before = split === -1 ? rest2 : rest2.slice(0, split);
  const words = split === -1 ? [] : rest2.slice(split + 1);
  const parsed = parseFlags(before, {
    bg: { type: "boolean" },
    n: { type: "string", short: "n" }
  });
  if (parsed === undefined || parsed.positionals.length !== 1) {
    return usage(err);
  }
  if (parsed.values.bg !== true) {
    return refuse2(err, [
      "launch only starts background sessions: pass --bg.",
      "For an interactive start, use the shell function: skp <name> (sidekick profile alias prints it)."
    ]);
  }
  const loaded = load(parsed.positionals[0], penv);
  if ("issues" in loaded)
    return refuse2(err, loaded.issues);
  const { settings, args } = composed(loaded.profile, penv);
  const checked2 = runCheck(settings, penv);
  if (!checked2.ok)
    return refuse2(err, checked2.issues);
  for (const warning of checked2.warnings)
    err(warning);
  const { launchTimeoutMs = 60000 } = penv;
  const sessionName = parsed.values.n;
  const result = penv.runClaude(bgArgs(args, {
    sessionName: typeof sessionName === "string" ? sessionName : undefined,
    prompt: words.length > 0 ? words.join(" ") : undefined
  }), { cwd: penv.cwd, timeoutMs: launchTimeoutMs });
  if (result.stdout !== "")
    out(withoutTrailingNewline(result.stdout));
  if (result.stderr !== "")
    err(withoutTrailingNewline(result.stderr));
  if (result.timedOut)
    err("claude did not return in time.");
  return result.code;
};
var isShell = (value) => SHELLS.some((shell) => shell === value);
var alias = (rest2, penv, out, err) => {
  const parsed = parseFlags(rest2, { shell: { type: "string" } });
  if (parsed === undefined)
    return usage(err);
  const shell = parsed.values.shell ?? "zsh";
  if (!isShell(shell)) {
    return refuse2(err, [
      `unknown shell "${String(shell)}": use ${SHELLS.join(" or ")}`
    ]);
  }
  const issues = parsed.positionals.flatMap((name) => {
    const refusal = aliasNameRefusal(name);
    if (refusal !== undefined)
      return [refusal];
    const loaded = load(name, penv);
    return "issues" in loaded ? loaded.issues : [];
  });
  if (issues.length > 0)
    return refuse2(err, issues);
  out(withoutTrailingNewline(shellFunction(shell, parsed.positionals)));
  return 0;
};
var VERBS3 = {
  list,
  show,
  new: create,
  argv,
  launch,
  alias
};
function runProfileCli(args, penv, out, err) {
  const [name, ...rest2] = args;
  if (name === undefined || !Object.hasOwn(VERBS3, name))
    return usage(err);
  return VERBS3[name](rest2, penv, out, err);
}

// bin/cli.ts
function resolvePluginDir(entryFileUrl) {
  const here = path8.dirname(fileURLToPath(entryFileUrl));
  const candidates = [
    path8.resolve(here, ".."),
    path8.resolve(here, "..", "plugin")
  ];
  for (const c of candidates) {
    if (fs9.existsSync(path8.join(c, "rules")))
      return c;
  }
  return candidates[0];
}
var ManifestVersion = object({ version: string() });
function readVersion(pluginDir) {
  const manifest = path8.join(pluginDir, ".claude-plugin", "plugin.json");
  try {
    const parsed = safeParse(ManifestVersion, JSON.parse(fs9.readFileSync(manifest, "utf-8")));
    return parsed.success ? parsed.output.version : "unknown";
  } catch {
    return "unknown";
  }
}
function isMainEntrypoint(importMetaUrl, argv1) {
  if (!argv1)
    return false;
  try {
    return realpathSync3(fileURLToPath(importMetaUrl)) === realpathSync3(argv1);
  } catch {
    return false;
  }
}
var USAGE2 = `usage: sidekick rules <install|check> --project|--user [--strict]
       ${PM_USAGE_LINE}
       ${HOOK_USAGE_LINE}
       ${PROFILE_USAGE_LINE}
       sidekick --version`;
function writeStdout(chunk) {
  const buffer = Buffer.from(chunk);
  for (let offset = 0;offset < buffer.length; ) {
    try {
      offset += fs9.writeSync(1, buffer, offset);
    } catch (e) {
      if (!(e instanceof Error && ("code" in e) && e.code === "EAGAIN"))
        throw e;
    }
  }
}
function readProcessStdin() {
  try {
    return fs9.readFileSync(0, "utf-8");
  } catch {
    return "";
  }
}
function main(argv2, ctx, out, err) {
  const [sub, ...rest2] = argv2;
  const pluginDir = resolvePluginDir(ctx.entryFileUrl);
  if (sub === "--version") {
    out(readVersion(pluginDir));
    return 0;
  }
  if (sub === "pm")
    return runPmCli(rest2, { cwd: ctx.cwd }, out, err);
  if (sub === "hook") {
    const readStdin = ctx.readStdin ?? readProcessStdin;
    return runHookCli(rest2, { readStdin, pluginDir, env: ctx.env, tmpdir: ctx.tmpdir ?? os.tmpdir() }, out, err);
  }
  if (sub === "profile") {
    return runProfileCli(rest2, {
      env: ctx.env,
      cwd: ctx.cwd,
      home: ctx.env.HOME || os.homedir(),
      tmpdir: ctx.tmpdir ?? os.tmpdir(),
      runClaude: ctx.runClaude ?? execClaude,
      write: ctx.write ?? writeStdout
    }, out, err);
  }
  if (sub !== "rules") {
    err(USAGE2);
    return 1;
  }
  const claudeHome = ctx.env.CLAUDE_CONFIG_DIR || path8.join(os.homedir(), ".claude");
  const src = ctx.env.SIDEKICK_RULES_DIR || path8.join(pluginDir, "rules");
  return runRulesCli(rest2, { src, cwd: ctx.cwd, claudeHome }, out);
}
var _importMetaMain = "main" in import.meta && typeof __require.main == __require.module === "boolean" ? __require.main == __require.module : undefined;
var _isEntry = _importMetaMain ?? isMainEntrypoint(import.meta.url, process.argv[1]);
if (_isEntry) {
  process.exit(main(process.argv.slice(2), { env: process.env, cwd: process.cwd(), entryFileUrl: import.meta.url }, (l) => console.log(l), (l) => console.error(l)));
}
export {
  resolvePluginDir,
  readVersion,
  main,
  isMainEntrypoint,
  USAGE2 as USAGE
};

