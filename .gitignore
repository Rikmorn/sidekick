*.swp
*.swo
*~
.vscode/
.idea/

# Environment
.env
.env.*

# Node
node_modules/
dist/
*.log

# Eval harness: run records ARE tracked — ADR-0008 D6 gates on committed
# run sets accreting over distinct dates (append-only; the graph parses them).
# Scratch/aborted runs: delete the run dir rather than ignoring it.

# Harvest inbox (bench-5): local scratch; the durable artifact is the
# adjudicated case a `harvest import` produces, never the log line.
.sidekick/harvest.jsonl

# Secrets
credentials.json
*.key
*.pem

# Git worktrees (isolated dev workspaces)
.worktrees/

docs/superpowers

# Knowledge layer (ops-2 / ADR-0007): the graph is a derived, rebuildable cache
# of the text sources in git — never authority, never committed.
.kb/

# Dashboards (ops-6): the rendered site lives under .kb/site/ (above). The data
# JSONs and the embedded-data partial are regenerated by dashboards/prepare.sh —
# derived, never committed. The view definitions (_quarto.yml, index.qmd,
# prepare.sh) are tracked.
dashboards/data/
dashboards/_generated-data.qmd

# NOTE: this is the harness *source* repo — it does not carry a consumer's
# .sidekick/ working tree. If you ever run sidekick on this repo, `sidekick init`
# adds `.sidekick/cache/` + `.sidekick/state/` here like any other consumer.
