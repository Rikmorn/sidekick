{
  "name": "sidekick",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Personal everyday loop for Claude Code, packaged as a plugin bundle",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "bun build bin/cli.ts --target node --outfile plugin/bin/sidekick && chmod +x plugin/bin/sidekick",
    "sidekick": "bun bin/cli.ts",
    "test": "bun test bin/",
    "test:watch": "bun test --watch bin/",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "^24.13.1",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
