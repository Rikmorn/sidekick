{
  "name": "sidekick",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Personal everyday loop for Claude Code, packaged as a plugin bundle",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "bun build bin/cli.ts --target node --outfile plugin/bin/sidekick --footer \"// bun $(bun --version)\" && chmod +x plugin/bin/sidekick",
    "sidekick": "bun bin/cli.ts",
    "test": "bun test bin/",
    "test:watch": "bun test --watch bin/",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write .",
    "prose": "bun bin/prose.ts",
    "check:docs": "bun bin/check-docs.ts",
    "release:install": "sh bin/release-install.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "^24.13.1",
    "@vvago/vale": "3.22.0",
    "mdast-util-from-markdown": "2.1.0",
    "remark-cli": "12.0.1",
    "remark-validate-links": "13.1.0",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@vvago/vale"
  ],
  "dependencies": {
    "valibot": "1.5.0"
  }
}
