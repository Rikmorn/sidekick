{
  "name": "sidekick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal AI engineering harness",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "sidekick": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "rules",
    "README.md"
  ],
  "scripts": {
    "build": "bun build bin/cli.ts --target node --outfile dist/cli.js",
    "sidekick": "bun bin/cli.ts",
    "dashboard:view": "python3 -m http.server 4173 -d .kb/site",
    "dashboard:smoke": "node dashboards/smoke.mjs",
    "test": "bun test bin/",
    "test:watch": "bun test --watch bin/",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write .",
    "dashboard": "bash dashboards/prepare.sh && quarto render dashboards"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^24.13.1",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
