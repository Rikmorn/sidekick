{
  "name": "sidekick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal AI engineering harness",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "sidekick": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "rules",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "sidekick": "tsx bin/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^24.13.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  }
}
