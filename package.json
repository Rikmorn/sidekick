{
  "name": "sidekick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal AI engineering harness",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "sidekick": "dist/sidekick"
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "rules",
    "README.md"
  ],
  "scripts": {
    "build": "bun build --compile --outfile dist/sidekick bin/cli.ts",
    "sidekick": "bun bin/cli.ts",
    "test": "bun test bin/",
    "test:watch": "bun test --watch bin/",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^24.13.1",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
